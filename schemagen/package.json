{
  "name": "svelte-qt",
  "version": "1.0.0",
  "description": "Template project for writing node package with napi-rs",
  "main": "dist/index.js",
  "source": "src/ts/index.ts",
  "repository": "git@github.com:akiselev/svelte-qt.git",
  "license": "MIT",
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/index.js.map"
  ],
  "scripts": {
    "types": "node ./node_modules/@asgerf/dts-tree-sitter/build/src/index.js tree-sitter-cpp > OUTPUT.d.ts",
    "start": "TS_NODE_TRANSPILE_ONLY=true ts-node src/index.ts"
  },
  "devDependencies": {
    "@asgerf/dts-tree-sitter": "^0.1.0",
    "@babel/core": "^7.14.3",
    "@babel/plugin-transform-typescript": "^7.14.4",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.14.4",
    "@babel/preset-typescript": "^7.13.0",
    "@napi-rs/cli": "^1.0.4",
    "@rollup/plugin-commonjs": "^19.0.0",
    "@rollup/plugin-node-resolve": "^13.0.0",
    "@swc-node/register": "^1.3.1",
    "@types/node": "^15.12.2",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "ava": "^3.15.0",
    "benny": "^3.6.15",
    "chalk": "^4.1.1",
    "eslint": "^7.27.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-sonarjs": "^0.7.0",
    "fs-jetpack": "^4.1.0",
    "husky": "^6.0.0",
    "lint-staged": "^11.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.0",
    "rollup": "^2.51.0",
    "rollup-plugin-svelte": "^7.1.0",
    "rollup-plugin-typescript2": "^0.30.0",
    "svelte": "^3.38.2",
    "svelte-preprocess": "^4.7.3",
    "tree-sitter": "^0.19.0",
    "tree-sitter-cpp": "^0.19.0",
    "ts-node": "^10.0.0",
    "tslib": "^2.2.0",
    "typescript": "^4.3.2"
  },
  "dependencies": {
    "@node-rs/helper": "^1.1.1",
    "@nodegui/qode": "^2.1.0"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "trailingComma": "all",
    "singleQuote": false,
    "arrowParens": "always",
    "tabWidth": 4,
    "parser": "typescript"
  }
}
