create main-window #1
set #1 window-title "Menus"
create box-layout #2
set #2 direction "top-to-bottom"
create menu-bar #3
create menu #4
set #4 title "File"
create action #5
set #5 text "Open"
set #5 shortcut "Ctrl+O"
listen #5 triggered on
insert #4 #5 before=end slot=default
create action #6
set #6 text "Autosave"
set #6 checkable true
set #6 checked false
listen #6 toggled on
insert #4 #6 before=end slot=default
create action #7
set #7 separator true
insert #4 #7 before=end slot=default
create menu #8
set #8 title "Recent"
create action #9
set #9 text "a.txt"
listen #9 triggered on
insert #8 #9 before=end slot=default
create action #10
set #10 text "b.txt"
listen #10 triggered on
insert #8 #10 before=end slot=default
insert #4 #8 before=end slot=default
create action #11
set #11 text "Quit"
set #11 shortcut "Ctrl+Q"
listen #11 triggered on
insert #4 #11 before=end slot=default
insert #3 #4 before=end slot=default
create menu #12
set #12 title "Size"
create action #13
set #13 text "Small"
set #13 group "size"
set #13 checked true
listen #13 toggled on
insert #12 #13 before=end slot=default
create action #14
set #14 text "Large"
set #14 group "size"
set #14 checked false
listen #14 toggled on
insert #12 #14 before=end slot=default
insert #3 #12 before=end slot=default
insert #2 #3 before=end slot=default
create tool-bar #15
create action #16
set #16 icon "edit-copy"
set #16 text "Copy"
listen #16 triggered on
insert #15 #16 before=end slot=default
insert #2 #15 before=end slot=default
create push-button #17
listen #17 clicked on
set #17 text "Shuffle"
insert #2 #17 before=end slot=default
create label #18
set #18 text "S:|false|true|false"
insert #2 #18 before=end slot=default
create push-button #19
set #19 text "Context "
create menu #20
create action #21
set #21 text "Paste"
listen #21 triggered on
insert #20 #21 before=end slot=default
insert #19 #20 before=end slot=default
insert #2 #19 before=end slot=default
insert #1 #2 before=end slot=default
call #1 present []
event #5 triggered [false]
event #6 toggled [true]
event #13 toggled [false]
event #14 toggled [true]
set #18 text "S:open;|true|false|true"
event #17 clicked []
create action #22
set #22 text "c.txt"
listen #22 triggered on
insert #8 #22 before=#9 slot=default
remove #8 #9
destroy #9
