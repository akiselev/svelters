create window #1
set #1 title "bind observe"
create box #2
set #2 orientation "vertical"
set #2 spacing 6
create entry #3
insert #2 #3 before=end slot=default
create entry #4
insert #2 #4 before=end slot=default
create button #5
set #5 label "native"
insert #2 #5 before=end slot=default
create button #6
set #6 label "state"
insert #2 #6 before=end slot=default
create label #7
insert #2 #7 before=end slot=default
create label #8
insert #2 #8 before=end slot=default
create label #9
insert #2 #9 before=end slot=default
insert #1 #2 before=end slot=default
set #7 label "name Ann"
set #8 label "draft Ann"
set #9 label "pos -1"
set #3 text "Ann"
observe #3 text on
observe #3 cursor-position on
set #4 text "Ann"
listen #5 clicked on
listen #6 clicked on
call #1 present []
set #9 label "pos "
event #5 clicked []
set #3 text "Zed"
set #4 text "Zed"
call #3 selectRegion [1,2]
changed #3 text "Kim"
changed #4 text "Kim"
set #7 label "name Kim"
event #6 clicked []
set #7 label "name Bob"
set #8 label "draft Bob"
set #3 text "Bob"
set #4 text "Bob"
