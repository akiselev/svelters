create main-window #1
set #1 window-title "bind:text"
create box-layout #2
set #2 direction "top-to-bottom"
set #2 spacing 6
create line-edit #3
insert #2 #3 before=end slot=default
create push-button #4
set #4 text "Set Bob"
insert #2 #4 before=end slot=default
create push-button #5
set #5 text "Upper"
insert #2 #5 before=end slot=default
create label #6
insert #2 #6 before=end slot=default
create label #7
insert #2 #7 before=end slot=default
insert #1 #2 before=end slot=default
set #6 text "Hello Ann"
set #7 text "changes: 0"
listen #3 text-changed on
set #3 text "Ann"
observe #3 text on
listen #4 clicked on
listen #5 clicked on
call #1 present []
event #3 text-changed ["Zed"]
set #7 text "changes: 1"
event #4 clicked []
set #6 text "Hello Bob"
set #3 text "Bob"
event #5 clicked []
set #6 text "Hello BOB"
set #3 text "BOB"
