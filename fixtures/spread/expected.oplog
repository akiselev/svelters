create window #1
set #1 title "Spread"
create box #2
set #2 orientation "vertical"
set #2 spacing 4
create button #3
set #3 label "Spread"
set #3 sensitive true
set #3 tooltip-text "from a spread"
set #3 width-request 120
listen #3 clicked on
set #3 halign "center"
insert #2 #3 before=end slot=default
create label #4
set #4 label "clicks 0"
insert #2 #4 before=end slot=default
create label #5
set #5 label "dynamic"
set #5 tooltip-text "step 0"
insert #2 #5 before=end slot=default
create button #6
listen #6 clicked on
set #6 label "Next"
insert #2 #6 before=end slot=default
insert #1 #2 before=end slot=default
call #1 present []
event #3 clicked []
set #4 label "clicks 1"
event #6 clicked []
set #3 label "Fewer keys"
set #3 tooltip-text null
set #3 width-request -1
create button #7
set #7 label "dynamic"
set #7 tooltip-text "step 1"
insert #2 #7 before=#6 slot=default
remove #2 #5
destroy #5
event #3 clicked []
set #4 label "clicks 11"
event #6 clicked []
set #3 label "Explicit"
listen #3 clicked off
remove #2 #7
destroy #7
