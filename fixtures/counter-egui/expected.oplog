style sheet "*" null
style scheme "light" 0
style sheet "@tokens" ":root {\n  --sv-bg: #f6f5f4;\n  --sv-fg: #2e3436;\n  --sv-surface: #ffffff;\n  --sv-border: #cdc7c2;\n  --sv-accent: #3584e4;\n  --sv-accent-hover: #1c71d8;\n  --sv-accent-fg: #ffffff;\n  --sv-muted: #77767b;\n  --sv-danger: #c01c28;\n  --sv-radius: 6px;\n  --sv-space-1: 4px;\n  --sv-space-2: 8px;\n  --sv-space-3: 12px;\n  --sv-space-4: 16px;\n  --sv-font-size: 11pt;\n  --sv-font-family: sans-serif;\n}\n"
style sheet "fixtures/counter-egui/src/App.svelte" "\n  .column.svelte-011fce6244 {\n    gap: 8px;\n  }\n  .row.svelte-011fce6244 {\n    flex-direction: row;\n    align-items: center;\n    gap: 8px;\n  }\n"
create window #1
set #1 title "Counter"
set #1 default-width 360
set #1 default-height 260
create box #2
create label #3
insert #2 #3 before=end slot=default
create button #4
set #4 text "Increment"
insert #2 #4 before=end slot=default
create box #5
create text-edit #6
set #6 hint-text "Name"
set #6 flex-grow 1
insert #5 #6 before=end slot=default
create label #7
insert #5 #7 before=end slot=default
insert #2 #5 before=end slot=default
create slider #8
set #8 min 0
set #8 max 100
set #8 step 1
set #8 accessible-name "Level"
insert #2 #8 before=end slot=default
create checkbox #9
insert #2 #9 before=end slot=default
insert #1 #2 before=end slot=default
set #3 text "Count: 0"
set #7 text "Hello "
set #9 text "Level 20, agree: no"
listen #4 clicked on
set #6 text ""
observe #6 text on
set #8 value 20
observe #8 value on
set #9 checked false
observe #9 checked on
call #1 present []
style #1 classes "svelte-011fce6244"
style #2 classes "column svelte-011fce6244"
style #3 classes "svelte-011fce6244"
style #4 classes "svelte-011fce6244"
style #5 classes "row svelte-011fce6244"
style #6 classes "svelte-011fce6244"
style #7 classes "svelte-011fce6244"
style #8 classes "svelte-011fce6244"
style #9 classes "svelte-011fce6244"
event #4 clicked []
set #3 text "Count: 1"
changed #6 text "Ann"
set #7 text "Hello Ann"
changed #8 value 42
set #9 text "Level 42, agree: no"
changed #9 checked true
set #9 text "Level 42, agree: yes"
