create window #1
set #1 title "Counter"
set #1 default-width 360
set #1 default-height 260
create box #2
set #2 gap 8
create label #3
set #3 text "Count: 0"
insert #2 #3 before=end slot=default
create button #4
listen #4 clicked on
set #4 text "Increment"
insert #2 #4 before=end slot=default
create box #5
set #5 gap 8
set #5 align-items "center"
set #5 flex-direction "row"
create text-edit #6
set #6 hint-text "Name"
set #6 flex-grow 1
set #6 text ""
observe #6 text on
insert #5 #6 before=end slot=default
create label #7
set #7 text "Hello "
insert #5 #7 before=end slot=default
insert #2 #5 before=end slot=default
create slider #8
set #8 min 0
set #8 max 100
set #8 step 1
set #8 accessible-name "Level"
set #8 value 20
observe #8 value on
insert #2 #8 before=end slot=default
create checkbox #9
set #9 checked false
observe #9 checked on
set #9 text "Level 20, agree: no"
insert #2 #9 before=end slot=default
insert #1 #2 before=end slot=default
call #1 present []
style sheet "*" null
style scheme "light" 0
style sheet "@tokens" ":root {\n  --sv-bg: #f6f5f4;\n  --sv-fg: #2e3436;\n  --sv-surface: #ffffff;\n  --sv-border: #cdc7c2;\n  --sv-accent: #3584e4;\n  --sv-accent-hover: #1c71d8;\n  --sv-accent-fg: #ffffff;\n  --sv-muted: #77767b;\n  --sv-danger: #c01c28;\n  --sv-radius: 6px;\n  --sv-space-1: 4px;\n  --sv-space-2: 8px;\n  --sv-space-3: 12px;\n  --sv-space-4: 16px;\n  --sv-font-size: 11pt;\n  --sv-font-family: sans-serif;\n}\n"
style #2 classes "column"
style #5 classes "row"
event #4 clicked []
set #3 text "Count: 1"
changed #6 text "Ann"
set #7 text "Hello Ann"
changed #8 value 42
set #9 text "Level 42, agree: no"
changed #9 checked true
set #9 text "Level 42, agree: yes"
