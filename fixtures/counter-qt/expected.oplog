create main-window #1
set #1 window-title "Counter"
create box-layout #2
set #2 direction "top-to-bottom"
set #2 spacing 8
create label #3
insert #2 #3 before=end slot=default
create push-button #4
set #4 text "Increment"
insert #2 #4 before=end slot=default
insert #1 #2 before=end slot=default
set #3 text "Count: 0"
listen #4 clicked on
call #1 present []
event #4 clicked []
set #3 text "Count: 1"
event #4 clicked []
event #4 clicked []
set #3 text "Count: 3"
