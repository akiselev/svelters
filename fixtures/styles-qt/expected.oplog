style sheet "src/App.svelte" ".app.svelte-1n46o8q {\n  background-color: #f6f5f4;\n  border: none;\n}\n.card.svelte-1n46o8q {\n  margin: 12px;\n  padding: 12px;\n  background-color: #ffffff;\n  border: 1px solid #cdc7c2;\n  border-radius: 6px;\n}\n.title.svelte-1n46o8q {\n  color: #2e3436;\n  font-size: 14pt;\n}\n.title.big.svelte-1n46o8q {\n  font-weight: bold;\n}\n.QPushButton.primary.svelte-1n46o8q {\n  background-color: #3584e4;\n  color: #ffffff;\n  border-radius: 6px;\n  padding: 6px 14px;\n  border: none;\n}\n.QPushButton.primary.svelte-1n46o8q:hover {\n  background-color: #1c71d8;\n  border: none;\n}\n.QPushButton.primary.active.svelte-1n46o8q {\n  border: 2px solid #c01c28;\n}\n.QLineEdit.field.svelte-1n46o8q {\n  color: #2e3436;\n}\n.QLineEdit.field.svelte-1n46o8q:focus {\n  border-color: #3584e4;\n}\n.QPushButton { min-height: 24px; }\n"
create main-window #1
