style sheet "*" null
style scheme "light" 9
style sheet "fixtures/styles-qt/src/App.svelte" ".app.svelte-f3c18059ba {\n  background-color: #f6f5f4;\n  border: none;\n}\n.card.svelte-f3c18059ba {\n  margin: 12px;\n  padding: 12px;\n  background-color: #ffffff;\n  border: 1px solid #cdc7c2;\n  border-radius: 6px;\n}\n.title.svelte-f3c18059ba {\n  color: #2e3436;\n  font-size: 14pt;\n}\n.title.big.svelte-f3c18059ba {\n  font-weight: bold;\n}\n.QPushButton.primary.svelte-f3c18059ba {\n  background-color: #3584e4;\n  color: #ffffff;\n  border-radius: 6px;\n  padding: 6px 14px;\n  border: none;\n}\n.QPushButton.primary.svelte-f3c18059ba:hover {\n  background-color: #1c71d8;\n  border: none;\n}\n.QPushButton.primary.active.svelte-f3c18059ba {\n  border: 2px solid #c01c28;\n}\n.QLineEdit.field.svelte-f3c18059ba {\n  color: #2e3436;\n}\n.QLineEdit.field.svelte-f3c18059ba:focus {\n  border-color: #3584e4;\n}\n.QPushButton { min-height: 24px; }\n"
create main-window #1
set #1 window-title "Styles"
create box-layout #2
set #2 direction "top-to-bottom"
set #2 spacing 8
create label #3
set #3 text "Styled"
insert #2 #3 before=end slot=default
create push-button #4
set #4 text "Toggle"
insert #2 #4 before=end slot=default
create line-edit #5
set #5 placeholder-text "type here"
insert #2 #5 before=end slot=default
create push-button #6
set #6 text "Theme"
insert #2 #6 before=end slot=default
create push-button #7
set #7 text "Accent"
insert #2 #7 before=end slot=default
insert #1 #2 before=end slot=default
listen #4 clicked on
listen #6 clicked on
listen #7 clicked on
call #1 present []
style #1 classes "app svelte-f3c18059ba"
style #2 classes "sv-k-box-layout card svelte-f3c18059ba"
style #4 classes "primary svelte-f3c18059ba"
style #4 name "toggle"
style #5 classes "field svelte-f3c18059ba"
style #6 classes "svelte-f3c18059ba"
style #7 classes "svelte-f3c18059ba"
style #3 classes "sv-k-label title svelte-f3c18059ba"
event #4 clicked []
style #3 classes "sv-k-label title svelte-f3c18059ba big"
style #3 inline "color: #c01c28;"
style #4 classes "primary svelte-f3c18059ba active"
event #6 clicked []
event #7 clicked []
