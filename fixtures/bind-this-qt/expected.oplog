create main-window #1
set #1 window-title "bind:this"
create box-layout #2
set #2 direction "top-to-bottom"
set #2 spacing 6
create line-edit #3
set #3 text "seed"
listen #3 text-changed on
insert #2 #3 before=end slot=default
create push-button #4
listen #4 clicked on
set #4 text "Read"
insert #2 #4 before=end slot=default
create push-button #5
listen #5 clicked on
set #5 text "Hide"
insert #2 #5 before=end slot=default
create push-button #6
listen #6 clicked on
set #6 text "Probe"
insert #2 #6 before=end slot=default
create label #7
set #7 text "(none)"
insert #2 #7 before=end slot=default
create label #8
set #8 text "reads: 0"
insert #2 #8 before=end slot=default
create label #9
set #9 text "edited: no"
insert #2 #9 before=end slot=default
create label #10
set #10 text "stale: (none)"
insert #2 #10 before=end slot=default
create line-edit #11
set #11 text "temp"
insert #2 #11 before=end slot=default
insert #1 #2 before=end slot=default
call #1 present []
event #3 text-changed ["hello"]
set #9 text "edited: yes"
event #4 clicked []
call #1 present []
set #7 text "seed"
set #8 text "reads: 1"
event #5 clicked []
remove #2 #11
destroy #11
event #6 clicked []
set #10 text "stale: StaleHandleError: destroyed"
