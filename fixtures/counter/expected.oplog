create window #1
set #1 title "Counter"
create box #2
set #2 orientation "vertical"
set #2 spacing 8
create label #3
set #3 label "Count: 0"
insert #2 #3 before=end slot=default
create button #4
listen #4 clicked on
set #4 label "Increment"
insert #2 #4 before=end slot=default
insert #1 #2 before=end slot=default
call #1 present []
event #4 clicked []
set #3 label "Count: 1"
event #4 clicked []
event #4 clicked []
set #3 label "Count: 3"
