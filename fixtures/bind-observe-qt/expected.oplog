observe #3 text on
set #4 text "Ann"
listen #5 clicked on
listen #6 clicked on
call #1 present []
event #5 clicked []
set #3 text "Zed"
set #4 text "Zed"
changed #3 text "Kim"
changed #4 text "Kim"
set #7 text "name Kim"
