create window #1
set #1 title "bind:text"
create box #2
set #2 orientation "vertical"
set #2 spacing 6
create entry #3
insert #2 #3 before=end slot=default
create button #4
set #4 label "Set Bob"
insert #2 #4 before=end slot=default
create button #5
set #5 label "Upper"
insert #2 #5 before=end slot=default
create label #6
insert #2 #6 before=end slot=default
create label #7
insert #2 #7 before=end slot=default
insert #1 #2 before=end slot=default
set #6 label "Hello Ann"
set #7 label "changes: 0"
listen #3 changed on
set #3 text "Ann"
observe #3 text on
listen #4 clicked on
listen #5 clicked on
call #1 present []
event #3 changed ["Zed"]
set #7 label "changes: 1"
event #4 clicked []
set #6 label "Hello Bob"
set #3 text "Bob"
event #5 clicked []
set #6 label "Hello BOB"
set #3 text "BOB"
