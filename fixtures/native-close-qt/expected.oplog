create main-window #1
set #1 window-title "Main"
create box-layout #2
set #2 direction "top-to-bottom"
set #2 spacing 8
create label #3
insert #2 #3 before=end slot=default
create push-button #4
set #4 text "Toggle child"
insert #2 #4 before=end slot=default
insert #1 #2 before=end slot=default
create main-window #5
set #5 window-title "Child"
create label #6
set #6 text "Child body"
insert #5 #6 before=end slot=default
set #3 text "child open"
listen #4 clicked on
call #1 present []
call #5 present []
gone #5 closed
gone #6 parent
event #4 clicked []
set #3 text "child closed (parent)"
event #4 clicked []
create main-window #7
set #7 window-title "Child"
create label #8
set #8 text "Child body"
insert #7 #8 before=end slot=default
call #7 present []
set #3 text "child open"
