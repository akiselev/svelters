create main-window #1
set #1 window-title "Spread"
create box-layout #2
set #2 direction "top-to-bottom"
set #2 spacing 4
create push-button #3
set #3 text "Spread"
set #3 enabled true
set #3 tool-tip "from a spread"
set #3 minimum-height 30
listen #3 clicked on
set #3 flat false
insert #2 #3 before=end slot=default
create label #4
insert #2 #4 before=end slot=default
create label #5
set #5 text "dynamic"
set #5 tool-tip "step 0"
insert #2 #5 before=end slot=default
create push-button #6
set #6 text "Next"
insert #2 #6 before=end slot=default
insert #1 #2 before=end slot=default
set #4 text "clicks 0"
listen #6 clicked on
call #1 present []
event #3 clicked []
set #4 text "clicks 1"
event #6 clicked []
set #3 text "Fewer keys"
set #3 tool-tip null
set #3 minimum-height 0
create push-button #7
set #7 text "dynamic"
set #7 tool-tip "step 1"
insert #2 #7 before=#6 slot=default
remove #2 #5
destroy #5
event #3 clicked []
set #4 text "clicks 11"
event #6 clicked []
set #3 text "Explicit"
listen #3 clicked off
remove #2 #7
destroy #7
