create window #1
set #1 title "Main"
create box #2
set #2 orientation "vertical"
set #2 spacing 8
create label #3
set #3 label "waiting"
insert #2 #3 before=end slot=default
create button #4
listen #4 clicked on
set #4 label "Open"
insert #2 #4 before=end slot=default
create button #5
listen #5 clicked on
set #5 label "About"
insert #2 #5 before=end slot=default
create messagebox #6
set #6 text "Save changes?"
listen #6 finished on
insert #1 #6 before=end slot=default
insert #1 #2 before=end slot=default
call #1 present []
call #6 open []
create aboutdialog #7
set #7 programName "Dialogs"
event #6 finished [7]
remove #1 #6
set #3 label "finished 7"
destroy #6
event #4 clicked []
create messagebox #8
set #8 text "Save changes?"
listen #8 finished on
insert #1 #8 before=end slot=default
call #8 open []
event #5 clicked []
call #7 present []
gone #7 closed
