{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "svelters:override:qt/v1",
  "title": "Qt override file (metadata/overrides/qt/<Class>.yaml)",
  "description": "Declares svelters elements built on a QtWidgets class (`elements:`) and facts every element deriving from the class inherits (`inherit:`). Every fact is resolved against metadata/qt/<Class>.json (and its bases) by tools/metadata/qt/gen_cpp.py; unresolvable facts are errors. Every record carries `provenance`. Unknown keys are errors. See metadata/A1-WORKER-qt.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "unexposed": {
      "description": "This class is deliberately not exposed as an element; the reason is shown in the coverage report.",
      "type": "object", "additionalProperties": false, "required": ["reason"],
      "properties": {"reason": {"type": "string", "minLength": 3}}
    },
    "inherit": {
      "description": "Facts that apply to every element whose class derives from this file's class, unless the element declares the same JS name.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "props": {"type": "array", "items": {"$ref": "#/$defs/prop"}},
        "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}},
        "methods": {"type": "array", "items": {"$ref": "#/$defs/method"}}
      }
    },
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}}
  },
  "$defs": {
    "provenance": {
      "oneOf": [
        {"type": "string", "minLength": 3},
        {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["origin", "ref"],
          "properties": {"origin": {"enum": ["qdoc", "metaobject", "typesystem", "uic", "probe", "manual", "docs", "source"]}, "ref": {"type": "string"}}
        }}
      ]
    },
    "element": {
      "type": "object", "additionalProperties": false, "required": ["tag", "construct"],
      "properties": {
        "tag": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "construct": {
          "type": "object", "additionalProperties": false, "required": ["class"],
          "properties": {
            "class": {"type": "string"},
            "init": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["method"],
                                                 "properties": {"method": {"type": "string"}, "args": {"type": "array"}}}},
            "composite": {"type": "object"}
          }
        },
        "exclude": {"description": "Inherited JS names this element does not get.", "type": "array", "items": {"type": "string"}},
        "props": {"type": "array", "items": {"$ref": "#/$defs/prop"}},
        "methods": {"type": "array", "items": {"$ref": "#/$defs/method"}},
        "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}},
        "children": {
          "type": "object", "additionalProperties": false, "required": ["policy", "default_slot", "slots"],
          "properties": {
            "policy": {"enum": ["none", "single_child", "ordered", "named_slots", "layout_managed", "pages", "model_driven", "custom"]},
            "default_slot": {"type": ["string", "null"]},
            "slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}}
          }
        },
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "prop": {
      "type": "object", "additionalProperties": false, "required": ["js", "provenance"],
      "properties": {
        "js": {"type": "string"},
        "native": {"type": "string", "description": "Q_PROPERTY / qdoc property name."},
        "suppress_signals": {"type": "boolean", "description": "Programmatic sets from JS do not post this handle's signals (echo suppression; per-handle flag, never QSignalBlocker)."},
        "target": {"enum": ["self", "layout"]},
        "type": {"enum": ["enum"]},
        "getter": {"type": "string"},
        "setter": {"type": "string"},
        "values": {"type": "object", "additionalProperties": {"type": "string"}},
        "sample": {"type": ["string", "number", "boolean"], "description": "Value the generated test writes and reads back."},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "method": {
      "type": "object", "additionalProperties": false, "required": ["js", "native", "provenance"],
      "properties": {
        "js": {"type": "string"},
        "native": {"type": "string"},
        "params": {"type": "array", "items": {"type": "string"}, "description": "Neutral type refs of the overload (i32, f64, bool, string, record<Size>, object<QWidget>, ...)."},
        "args": {"type": "array", "description": "Arguments the generated test passes (default 10, 11, ...)."},
        "expect": {"type": "string", "description": "C++ bool expression checked after the call; `$w` is the widget, cast to the element class."},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "signal": {
      "type": "object", "additionalProperties": false, "required": ["js", "provenance"],
      "properties": {
        "js": {"type": "string"},
        "native": {"type": "string"},
        "collapses": {"type": "array", "items": {"type": "string"}},
        "connect": {"type": "string"},
        "args": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "type"],
                                             "properties": {"name": {"type": "string"}, "type": {"type": "string"}}}},
        "trigger": {"type": "string", "description": "C++ statement that makes Qt emit the signal; `$w` is the widget, `$i` the iteration (0, 1, 2)."},
        "expect_args": {"type": "array", "items": {"type": "string"}},
        "synthetic": {"enum": ["close_request", "key_press"]},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "op": {
      "type": "object", "additionalProperties": false, "required": ["native"],
      "properties": {
        "native": {"type": "string"},
        "args": {"type": "array"},
        "effects": {"type": "object"},
        "variants": {"type": "array"},
        "then": {"type": "array"},
        "receiver": {"enum": ["child"]},
        "item": {"type": "string"}
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false, "required": ["name", "cardinality", "accepts", "host", "ops", "provenance"],
      "properties": {
        "name": {"type": "string"},
        "content": {"enum": ["widget"]},
        "accepts": {"type": "array", "items": {"type": "string"}},
        "route_by_kind": {"type": "boolean"},
        "cardinality": {"enum": ["one", "many"]},
        "order": {"enum": ["none", "append_only", "native_index", "unordered"]},
        "host": {"enum": ["self", "layout"]},
        "default": {"type": "object"},
        "on_remove": {"enum": ["empty", "restore_default", "destroys_child"]},
        "requires": {"type": "array"},
        "attrs": {"type": "array", "items": {"$ref": "#/$defs/attr"}},
        "ops": {
          "type": "object", "additionalProperties": false,
          "properties": {"get": {"$ref": "#/$defs/op"}, "set": {"$ref": "#/$defs/op"}, "insert": {"$ref": "#/$defs/op"}, "remove": {"$ref": "#/$defs/op"},
                         "index_of": {"$ref": "#/$defs/op"}, "list": {"$ref": "#/$defs/op"}}
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "attr": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "set", "get", "provenance"],
      "description": "A per-child attribute of a slot (ABI v2.2 set_child_attr), spelled `parent:<name>` on the child. `set`/`get` are native calls on the slot host; args use child, value, child_index, attr.<other>, const:<c++ literal>.",
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
        "type": {"enum": ["bool", "i32", "f64", "string", "enum"]},
        "values": {"type": "object", "description": "enum: JS name -> C++ expression"},
        "default": {"description": "Value after `null` (reset) and after remove + insert; an enum's default is a key of `values`."},
        "samples": {"type": "array", "minItems": 2, "maxItems": 2, "description": "Two different non-default values the generated test writes."},
        "set": {
          "type": "object", "additionalProperties": false, "required": ["native", "args"],
          "properties": {
            "native": {"type": "string"},
            "args": {"type": "array", "items": {"type": "string", "pattern": "^(child|value|child_index|attr\\.[A-Za-z0-9]+|const:.+)$"}},
            "readd": {"type": "boolean", "description": "Remove the child from the host (the slot's remove call, without its `then` steps) before the call; the argument values are read first. For positions fixed at add time."}
          }
        },
        "get": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "expr": {"type": "string", "description": "Instead of `native`: a C++ expression over `h` (the slot host), `ch` (the child widget) and `ci` (its index)."},
            "native": {"type": "string"},
            "args": {"type": "array", "items": {"type": "string", "pattern": "^(child|child_index|attr\\.[A-Za-z0-9]+|const:.+)$"}},
            "member": {"type": "string", "description": "A method called on the object the native call returns (QLayout::itemAt(int) -> alignment)."},
            "out": {"type": "integer", "minimum": 0, "description": "Index of the pointer parameter that receives the value (pointer parameters are not listed in args)."}
          }
        },
        "reset": {"type": "boolean", "description": "State that outlives the slot (a size policy): apply the default on insert and before remove."},
        "expect": {"type": "string", "description": "C++ bool expression checked after sample 1 is set: $w = the child widget, $p = the parent element object."},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["name", "direction", "property", "type", "change", "echo", "lifetime", "provenance"],
      "properties": {
        "name": {"type": "string"},
        "direction": {"enum": ["two_way", "read_only"]},
        "property": {"type": "string"},
        "target": {},
        "type": {"type": "object"},
        "change": {"type": "object", "additionalProperties": false, "required": ["signal"],
                   "properties": {"signal": {"type": "string"}, "role": {"enum": ["any_change", "user_edit"]}, "value": {"enum": ["arg0", "prop"]}}},
        "write": {"type": "object"},
        "echo": {"type": "object", "additionalProperties": false, "required": ["strategy"],
                 "properties": {"strategy": {"enum": ["host_suppressed", "compare", "none"]}, "compare_before_set": {"type": "boolean"},
                                "read_back": {"type": "boolean"}, "sync_signals_on_set": {"type": "array", "items": {"type": "string"}}}},
        "lifetime": {"type": "object"},
        "unsupported_for": {"type": ["string", "null"]},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
