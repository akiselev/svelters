  QPointer<QWindow> frame_win;        // the window whose UpdateRequest events we watch
  QObject *frame_filter = nullptr;
  unsigned frames_by_update = 0;      // frames delivered by an UpdateRequest (the rest: the timer)
};

Core g;
bool g_test_throw = false;
QObject *g_owner = nullptr;  // the receiver of the getter or call being converted: owner of the borrowed handles it mints

// Optional measurement of the time spent inside backend calls (toolkit side of a host op).
struct Timing {
  bool on = false;
  uint64_t ns = 0;
  uint64_t calls = 0;
};
