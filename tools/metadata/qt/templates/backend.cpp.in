}

void run_checkpoint() {
  g.queued.store(false);
  if (g.host && g.host->checkpoint) g.host->checkpoint(g.host->self);
}

Entry *find(svl_handle h) {
  auto it = g.table.find(h);
  if (it == g.table.end() || it->second.obj.isNull()) return nullptr;
  return &it->second;
}

void drop_listeners(svl_handle h) {
  g.listeners.erase(g.listeners.lower_bound({h, 0, 0}), g.listeners.lower_bound({h + 1, 0, 0}));
  g.after_make.erase(g.after_make.lower_bound({h, 0, 0}), g.after_make.lower_bound({h + 1, 0, 0}));
}

// Qt runs the slots of a signal in connection order, and a signal is emitted after the widget changed
// its own state, so the `after` phase is "behind every plain listener": whenever a plain connection is
// added, the after-connections of the same signal are re-made, which puts them last.
void keep_after_last(svl_handle h, svl_id sig) {
  for (auto it = g.after_make.lower_bound({h, sig, 0});
       it != g.after_make.end() && std::get<0>(it->first) == h && std::get<1>(it->first) == sig; ++it) {
    auto lit = g.listeners.find(it->first);
    if (lit != g.listeners.end()) QObject::disconnect(lit->second);
    g.listeners[it->first] = it->second();
  }
}

svl_id gen_kind_of(QObject *o);

void report_gone(svl_handle h, uint32_t reason) {
  if (g.host && g.host->on_destroyed) g.host->on_destroyed(g.host->self, h, reason);
}

// A QObject we hold a handle for was deleted underneath us (its parent died, an owner replaced it).
// The entry is erased before the host hears about it. Qt emits `destroyed` before the children of
// a QWidget go, so a child can be reported before or after its parent: the host copes with both.
void native_destroyed(svl_handle h, QObject *o) {
  auto it = g.table.find(h);
  if (it == g.table.end()) return;
  const bool borrowed = it->second.life == SVL_LIFE_BORROWED;
  if (o) g.by_obj.erase(o);
  g.table.erase(it);
  drop_listeners(h);
  // A borrowed object is deleted by whatever owns it; an owned one by its parent.
  report_gone(h, borrowed ? SVL_GONE_OWNER : o && o->parent() ? SVL_GONE_PARENT : SVL_GONE_UNKNOWN);
}

// The user (or `close()`) closed a toplevel that JS is not controlling. Every handle at or below
// the window is forgotten here, while the object tree is still intact, and reported: the window
// as closed, the rest as `parent`. The widgets themselves are deleted later from the event loop.
void native_closed(svl_handle h, QObject *win) {
  std::vector<svl_handle> below;
  for (auto &kv : g.table) {
    if (kv.first == h || kv.second.obj.isNull()) continue;
    for (QObject *p = kv.second.obj->parent(); p; p = p->parent())
      if (p == win) {
        below.push_back(kv.first);
        break;
      }
  }
  std::sort(below.begin(), below.end());
  below.insert(below.begin(), h);
  for (svl_handle x : below) {
    auto it = g.table.find(x);
    if (it == g.table.end()) continue;
    QObject::disconnect(it->second.destroyed);
    if (it->second.obj) g.by_obj.erase(it->second.obj.data());
    g.table.erase(it);
    drop_listeners(x);
  }
  for (svl_handle x : below) report_gone(x, x == h ? SVL_GONE_CLOSED : SVL_GONE_PARENT);
  win->deleteLater();
}

svl_handle handle_of(QObject *o) {
  auto it = g.by_obj.find(o);
  return it == g.by_obj.end() ? 0 : it->second;
}

// The handle for an object a getter or call returned: its existing one (an object we created
// keeps its OWNED/TOPLEVEL handle) or a new BORROWED one. Borrowed entries hold the object through
// a QPointer only, so they never keep it alive; the `destroyed` connection reports its death.
svl_handle intern(QObject *o, QObject *owner) {
  if (!o) return 0;
  if (svl_handle h = handle_of(o)) return h;
  if (o->property("_svl_dying").toBool()) return 0;  // our own destroy() is already deleting it
  svl_handle h = g.next++;
  Entry e;
  e.obj = o;
  e.kind = gen_kind_of(o);
  e.life = SVL_LIFE_BORROWED;
  e.owner = owner ? handle_of(owner) : 0;
  e.destroyed = QObject::connect(o, &QObject::destroyed, [h](QObject *obj) { native_destroyed(h, obj); });
  g.by_obj[o] = h;
  g.table.emplace(h, std::move(e));
  return h;
}

// Sync handler result: a bool (or non-zero integer) `true` means stop/handled.
bool sync_stop(int rc, const svl_value &out) {
  if (rc != 0) return false;
  if (out.tag == SVL_BOOL) return out.u.b;
  if (out.tag == SVL_I64) return out.u.i != 0;
  return false;
}

// onRequestClose for toplevels (see backend-abi.md, ABI v2 and v2.1): while JS listens for
// close-request its handler decides each close through call_sync (`true` vetoes). A busy host
// (JS is running) queued the event itself: the close is vetoed so the late handler can decide.
// Without a listener, or when the handler does not veto, the window is closed for good.
struct CloseFilter : QObject {
  bool eventFilter(QObject *o, QEvent *ev) override {
    if (ev->type() != QEvent::Close) return false;
    svl_handle h = handle_of(o);
    if (!h) return false;
    const Entry &e = g.table[h];
    if (e.close_listen && g.host && g.host->call_sync) {
      svl_value out{};
      int rc = g.host->call_sync(g.host->self, h, e.close_sig, nullptr, 0, &out);
      if (rc == SVL_SYNC_BUSY || sync_stop(rc, out) || g.table.find(h) == g.table.end()) {
        ev->ignore();
        return true;
      }
    }
    ev->accept();
    native_closed(h, o);
    return true;
  }
};

// key-press (synthetic): while JS listens, every key press on the object goes through call_sync
// with [key, text, modifiers]; a handler result of `true` consumes the key, so the widget never
// sees it (a QLineEdit does not insert the text).
bool key_sync(svl_handle h, svl_id sig, QKeyEvent *k) {
  {
    const QByteArray text = k->text().toUtf8();
    svl_value args[3] = {};
    args[0].tag = SVL_I64;
    args[0].u.i = k->key();
    args[1].tag = SVL_STR;
    args[1].u.s.ptr = text.constData();
    args[1].u.s.len = static_cast<size_t>(text.size());
    args[2].tag = SVL_I64;
    args[2].u.i = static_cast<qint64>(k->modifiers().toInt());
    svl_value out{};
    int rc = g.host->call_sync(g.host->self, h, sig, args, 3, &out);
    return sync_stop(rc, out);
  }
}

struct KeyFilter : QObject {
  bool eventFilter(QObject *o, QEvent *ev) override {
    if (ev->type() != QEvent::KeyPress || !g.host || !g.host->call_sync) return false;
    svl_handle h = handle_of(o);
    if (!h) return false;
    auto it = g.table.find(h);
    if (it == g.table.end() || !it->second.key_listen) return false;
    return key_sync(h, it->second.key_sig, static_cast<QKeyEvent *>(ev));
  }
};

// key-press, capture phase: an application-level filter sees a key before its receiver does. For each
// listened widget that is a proper ancestor of the receiver (outermost first) the handler is called
// through call_sync with the capture wire id; a handler result of `true` consumes the key before the
// receiver or any plain listener sees it.
struct CaptureFilter : QObject {
  bool eventFilter(QObject *o, QEvent *ev) override {
    if (ev->type() != QEvent::KeyPress || !g.host || !g.host->call_sync) return false;
    auto *recv = qobject_cast<QWidget *>(o);
    if (!recv) return false;
    std::vector<std::pair<int, svl_handle>> hits;
    for (auto &kv : g.table) {
      const Entry &e = kv.second;
      if (!e.key_capture || e.obj.isNull()) continue;
      auto *w = qobject_cast<QWidget *>(e.obj.data());
      if (!w || w == recv || !w->isAncestorOf(recv)) continue;
      int depth = 0;
      for (QWidget *p = w; p; p = p->parentWidget()) ++depth;
      hits.emplace_back(depth, kv.first);
    }
    std::sort(hits.begin(), hits.end());
    for (const auto &hit : hits) {
      auto it = g.table.find(hit.second);  // an earlier handler may have changed the tree
      if (it == g.table.end() || !it->second.key_capture) continue;
      if (key_sync(hit.second, it->second.key_capture_sig, static_cast<QKeyEvent *>(ev))) return true;
    }
    return false;
  }
};

int listen_key(svl_handle h, Entry &e, svl_id sig, bool on, uint32_t flags) {
  (void)h;
  if (flags & SVL_LISTEN_AFTER)
    return on ? fail("listen: no after phase for event-filter signals (a key-press handler runs before the widget sees the key)") : 0;
  if (flags & SVL_LISTEN_CAPTURE) {
    static CaptureFilter *capture = new CaptureFilter;
    e.key_capture = on;
    e.key_capture_sig = sig | (flags << SVL_SIGNAL_FLAGS_SHIFT);
    bool any = false;
    for (auto &kv : g.table) any = any || kv.second.key_capture;
    if (any && !g.capture_filter_on) {
      QCoreApplication::instance()->installEventFilter(capture);
      g.capture_filter_on = true;
    } else if (!any && g.capture_filter_on) {
      QCoreApplication::instance()->removeEventFilter(capture);
      g.capture_filter_on = false;
    }
    return 0;
  }
  static KeyFilter *filter = new KeyFilter;
  e.key_listen = on;
  e.key_sig = sig;
  if (e.obj.isNull()) return 0;
  if (on) e.obj->installEventFilter(filter);
  else e.obj->removeEventFilter(filter);
  return 0;
}

// ---- frame clock (ABI v2.1 request_frame) ------------------------------------------------------

void deliver_frame(bool from_update) {
  if (!g.frame_pending) return;
  g.frame_pending = false;
  if (g.frame_timer) g.frame_timer->stop();
  if (from_update) g.frames_by_update++;
  if (g.host && g.host->frame) g.host->frame(g.host->self);
}

// Watches the chosen window for the update requests that QWindow::requestUpdate() delivers on the
// toolkit's frame cadence. It never consumes them: the window repaints as usual.
struct FrameFilter : QObject {
  bool eventFilter(QObject *, QEvent *ev) override {
    if (ev->type() == QEvent::UpdateRequest) deliver_frame(true);
    return false;
  }
};

// The platform-backed window of the lowest-handle visible toplevel, if any.
QWindow *frame_window() {
  svl_handle best = 0;
  QWindow *win = nullptr;
  for (auto &kv : g.table) {
    if (!kv.second.toplevel || kv.second.obj.isNull()) continue;
    auto *w = qobject_cast<QWidget *>(kv.second.obj.data());
    if (!w || !w->isVisible()) continue;
    QWindow *wh = w->windowHandle();
    if (!wh || !wh->handle()) continue;
    if (!best || kv.first < best) {
      best = kv.first;
      win = wh;
    }
  }
  return win;
}

void post(svl_handle h, svl_id sig, const svl_value *args, size_t n) {
  if (auto it = g.table.find(h); it != g.table.end() && it->second.suppress > 0) return;
  if (g.host && g.host->post_event) g.host->post_event(g.host->self, h, sig, args, n);
}

