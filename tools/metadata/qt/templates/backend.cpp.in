//@@TYPES_CORE@@

// ---- event families (synthetic signals, ABI v2.4) ----------------------------------------------
//
// An event filter turns QEvents into signals: key-release, mouse-press/release/move, mouse-double-click, wheel,
// context-menu (consumable: the JS handler's result decides through call_sync, `true` consumes the event
// before the widget sees it) and focus-in/out, enter, leave, resize (informational: posted, never consumed).
// Payloads are v3 values: positions are Point records, sizes Size records, buttons and modifiers integer masks.
// With the capture flag an application-level filter calls the listeners of proper ancestors first (outermost first).

bool ev_consumable(int fam) {
  switch (fam) {
    case EV_FOCUS_IN: case EV_FOCUS_OUT: case EV_ENTER: case EV_LEAVE: case EV_RESIZE: return false;
    default: return true;
  }
}

int ev_family(QEvent::Type t) {
  switch (t) {
    case QEvent::KeyRelease: return EV_KEY_RELEASE;
    case QEvent::MouseButtonPress: return EV_MOUSE_PRESS;
    case QEvent::MouseButtonRelease: return EV_MOUSE_RELEASE;
    case QEvent::MouseMove: return EV_MOUSE_MOVE;
    case QEvent::MouseButtonDblClick: return EV_DOUBLE_CLICK;
    case QEvent::Wheel: return EV_WHEEL;
    case QEvent::FocusIn: return EV_FOCUS_IN;
    case QEvent::FocusOut: return EV_FOCUS_OUT;
    case QEvent::Enter: return EV_ENTER;
    case QEvent::Leave: return EV_LEAVE;
    case QEvent::Resize: return EV_RESIZE;
    case QEvent::ContextMenu: return EV_CONTEXT_MENU;
    default: return -1;
  }
}

// Builds the payload of `fam` from `ev` and delivers it. Returns true when the handler consumed the event.
bool ev_dispatch(svl_handle h, svl_id wire, int fam, QEvent *ev) {
  if (!g.host) return false;
  g_out.clear();
  svl_value a[5] = {};
  size_t n = 0;
  QByteArray text;
  auto num = [&](qint64 v) { a[n].tag = SVL_I64; a[n].u.i = v; ++n; };
  switch (fam) {
    case EV_KEY_RELEASE: {
      auto *k = static_cast<QKeyEvent *>(ev);
      text = k->text().toUtf8();
      num(k->key());
      a[n].tag = SVL_STR; a[n].u.s.ptr = text.constData(); a[n].u.s.len = static_cast<size_t>(text.size()); ++n;
      num(static_cast<qint64>(k->modifiers().toInt()));
      break;
    }
    case EV_MOUSE_PRESS: case EV_MOUSE_RELEASE: case EV_MOUSE_MOVE: case EV_DOUBLE_CLICK: {
      auto *m = static_cast<QMouseEvent *>(ev);
      Conv<QPointF>::out(m->position(), &a[n++]);
      num(static_cast<qint64>(m->button()));
      num(static_cast<qint64>(m->buttons().toInt()));
      num(static_cast<qint64>(m->modifiers().toInt()));
      break;
    }
    case EV_WHEEL: {
      auto *w = static_cast<QWheelEvent *>(ev);
      Conv<QPointF>::out(w->position(), &a[n++]);
      Conv<QPoint>::out(w->angleDelta(), &a[n++]);
      num(static_cast<qint64>(w->buttons().toInt()));
      num(static_cast<qint64>(w->modifiers().toInt()));
      break;
    }
    case EV_FOCUS_IN: case EV_FOCUS_OUT: num(static_cast<qint64>(static_cast<QFocusEvent *>(ev)->reason())); break;
    case EV_ENTER: Conv<QPointF>::out(static_cast<QEnterEvent *>(ev)->position(), &a[n++]); break;
    case EV_LEAVE: break;
    case EV_RESIZE: {
      auto *r = static_cast<QResizeEvent *>(ev);
      Conv<QSize>::out(r->size(), &a[n++]);
      Conv<QSize>::out(r->oldSize(), &a[n++]);
      break;
    }
    case EV_CONTEXT_MENU: {
      auto *c = static_cast<QContextMenuEvent *>(ev);
      Conv<QPoint>::out(c->pos(), &a[n++]);
      Conv<QPoint>::out(c->globalPos(), &a[n++]);
      num(static_cast<qint64>(c->reason()));
      break;
    }
    default: return false;
  }
  if (!ev_consumable(fam) || !g.host->call_sync) {
    post(h, wire, a, n);
    return false;
  }
  svl_value out{};
  int rc = g.host->call_sync(g.host->self, h, wire, a, n, &out);
  return sync_stop(rc, out);
}

struct EventFamilyFilter : QObject {
  bool eventFilter(QObject *o, QEvent *ev) override {
    int fam = ev_family(ev->type());
    if (fam < 0) return false;
    svl_handle h = handle_of(o);
    if (!h) return false;
    auto it = g.table.find(h);
    if (it == g.table.end() || !(it->second.ev_mask & (1u << fam))) return false;
    return ev_dispatch(h, it->second.ev_sig[fam], fam, ev);
  }
};

struct EventCaptureFilter : QObject {
  bool eventFilter(QObject *o, QEvent *ev) override {
    int fam = ev_family(ev->type());
    if (fam < 0) return false;
    auto *recv = qobject_cast<QWidget *>(o);
    if (!recv) return false;
    std::vector<std::pair<int, svl_handle>> hits;
    for (auto &kv : g.table) {
      const Entry &e = kv.second;
      if (!(e.ev_cap_mask & (1u << fam)) || e.obj.isNull()) continue;
      auto *w = qobject_cast<QWidget *>(e.obj.data());
      if (!w || w == recv || !w->isAncestorOf(recv)) continue;
      int depth = 0;
      for (QWidget *p = w; p; p = p->parentWidget()) ++depth;
      hits.emplace_back(depth, kv.first);
    }
    std::sort(hits.begin(), hits.end());
    for (const auto &hit : hits) {
      auto it = g.table.find(hit.second);  // an earlier handler may have changed the tree
      if (it == g.table.end() || !(it->second.ev_cap_mask & (1u << fam))) continue;
      if (ev_dispatch(hit.second, it->second.ev_cap_sig[fam], fam, ev)) return true;
    }
    return false;
  }
};

int listen_event(svl_handle h, Entry &e, svl_id sig, bool on, uint32_t flags, int fam) {
  (void)h;
  const uint32_t bit = 1u << fam;
  if (flags & SVL_LISTEN_AFTER)
    return on ? fail("listen: no after phase for event-filter signals (the handler runs before the widget sees the event)") : 0;
  if (flags & SVL_LISTEN_CAPTURE) {
    static EventCaptureFilter *capture = new EventCaptureFilter;
    if (on) { e.ev_cap_mask |= bit; e.ev_cap_sig[fam] = sig | (flags << SVL_SIGNAL_FLAGS_SHIFT); }
    else e.ev_cap_mask &= ~bit;
    bool any = false;
    for (auto &kv : g.table) any = any || kv.second.ev_cap_mask;
    if (any && !g.ev_capture_on) {
      QCoreApplication::instance()->installEventFilter(capture);
      g.ev_capture_on = true;
    } else if (!any && g.ev_capture_on) {
      QCoreApplication::instance()->removeEventFilter(capture);
      g.ev_capture_on = false;
    }
    return 0;
  }
  static EventFamilyFilter *filter = new EventFamilyFilter;
  if (on) { e.ev_mask |= bit; e.ev_sig[fam] = sig; }
  else e.ev_mask &= ~bit;
  if (e.obj.isNull()) return 0;
  if (on) {
    // Moves without a pressed button only arrive when the widget tracks the mouse.
    if (fam == EV_MOUSE_MOVE)
      if (auto *w = qobject_cast<QWidget *>(e.obj.data())) w->setMouseTracking(true);
    e.obj->installEventFilter(filter);
  } else if (!e.ev_mask) {
    e.obj->removeEventFilter(filter);
  }
  return 0;
}

//@@CANVAS@@

// ---- name tables -----------------------------------------------------------------------------

struct NameId {
  std::string_view name;
  svl_id id;
};
struct Table {
  const NameId *items;
  size_t n;
};

//@@TABLES@@

// A table member id used on a handle whose kind does not have it (FU3, as GTK's FU1 fix): the message names the
// member (by the first element kind that has the id) and the handle's runtime class and kind.
std::string kind_label(svl_id kind) {
  Table kt = table_for(SVL_KIND, 0);
  for (size_t i = 0; i < kt.n; ++i)
    if (kt.items[i].id == kind) return std::string(kt.items[i].name);
  return "#" + std::to_string(kind);
}

int fail_wrong_kind(const char *op, uint32_t what, svl_id id, const Entry &e) {
  std::string member = "id " + std::to_string(id);
  Table kt = table_for(SVL_KIND, 0);
  for (size_t i = 0; i < kt.n && member[0] == 'i'; ++i) {
    Table t = table_for(what, kt.items[i].id);
    for (size_t j = 0; j < t.n; ++j)
      if (t.items[j].id == id && !t.items[j].name.empty()) {
        member = std::string(kt.items[i].name) + ":" + std::string(t.items[j].name);
        break;
      }
  }
  const char *noun = what == SVL_PROP ? "property" : what == SVL_METHOD ? "method" : "signal";
  const QObject *o = e.obj.data();
  const std::string cls = o ? o->metaObject()->className() : "a destroyed object";
  return fail(std::string(op) + ": " + noun + " " + member + " does not belong to " + cls + " (kind " + kind_label(e.kind) + ")");
}

