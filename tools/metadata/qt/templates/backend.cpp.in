// ---- vtable ----------------------------------------------------------------------------------

svl_id b_resolve(void *, uint32_t what, svl_id kind, const char *name, size_t len) {
  Table t = table_for(what, kind);
  std::string_view n(name, len);
  for (size_t i = 0; i < t.n; ++i)
    if (t.items[i].name == n) return t.items[i].id;
  return 0;
}

svl_handle b_create(void *, svl_id kind) {
  TimeScope timing_;
  ensure_app();
  QObject *o = gen_create(kind);
  if (!o) {
    fail("create: unknown kind id " + std::to_string(kind));
    return 0;
  }
  svl_handle h = g.next++;
  Entry e;
  e.obj = o;
  e.kind = kind;
  e.destroyed = QObject::connect(o, &QObject::destroyed, [h](QObject *obj) { native_destroyed(h, obj); });
  if (auto *w = qobject_cast<QWidget *>(o); w && w->isWindow()) {
    e.toplevel = true;
    static CloseFilter *filter = new CloseFilter;
    w->installEventFilter(filter);
  }
  g.table.emplace(h, std::move(e));
  return h;
}

int b_insert(void *, svl_handle parent, svl_handle child, svl_handle before, svl_id slot) {
  TimeScope timing_;
  Entry *p = find(parent);
  if (!p) return fail("insert: stale or unknown parent handle");
  Entry *c = find(child);
  if (!c) return fail("insert: stale or unknown child handle");
  QObject *b = nullptr;
  if (before) {
    Entry *be = find(before);
    if (!be) return fail("insert: stale or unknown `before` handle");
    b = be->obj.data();
  }
  return gen_insert(*p, c->obj.data(), b, slot);
}

int b_remove(void *, svl_handle parent, svl_handle child) {
  TimeScope timing_;
  Entry *p = find(parent);
  if (!p) return fail("remove: stale or unknown parent handle");
  Entry *c = find(child);
  if (!c) return fail("remove: stale or unknown child handle");
  return gen_remove(*p, c->obj.data());
}

void b_destroy(void *, svl_handle h) {
  TimeScope timing_;
  auto it = g.table.find(h);
  if (it == g.table.end()) return;
  QObject *o = it->second.obj.data();
  QObject::disconnect(it->second.destroyed);
  g.table.erase(it);
  drop_listeners(h);
  // Never delete synchronously: the caller may be inside one of this object's signals.
  if (o) {
    if (auto *w = qobject_cast<QWidget *>(o); w && w->isWindow()) w->hide();
    o->deleteLater();
  }
}

int b_set_prop(void *, svl_handle h, svl_id prop, const svl_value *v) {
  TimeScope timing_;
  Entry *e = find(h);
  if (!e) return fail("set_prop: stale or unknown handle");
  if (!v) return fail("set_prop: null value");
  return gen_set_prop(*e, prop, v);
}

int b_get_prop(void *, svl_handle h, svl_id prop, svl_value *out) {
  TimeScope timing_;
  Entry *e = find(h);
  if (!e) return fail("get_prop: stale or unknown handle");
  return gen_get_prop(*e, prop, out);
}

int b_call(void *, svl_handle h, svl_id method, const svl_value *args, size_t n, svl_value *out) {
  TimeScope timing_;
  Entry *e = find(h);
  if (!e) return fail("call: stale or unknown handle");
  out_null(out);
  return gen_call(*e, method, args, n, out);
}

int b_listen(void *, svl_handle h, svl_id sig, bool on) {
  TimeScope timing_;
  Entry *e = find(h);
  if (!e) return fail("listen: stale or unknown handle");
  return gen_listen(h, *e, sig, on);
}

int b_handle_info(void *, svl_handle h, svl_handle_info *out) {
  Entry *e = find(h);
  if (!e) return fail("handle_info: stale or unknown handle");
  out->kind = e->kind;
  out->lifetime = e->toplevel ? SVL_LIFE_TOPLEVEL : SVL_LIFE_OWNED;
  out->flags = 0;
  return 0;
}

// One single-shot timer, re-armed by every call. Short timeouts use a precise timer, longer ones
// a coarse timer so the toolkit can coalesce wakeups.
void b_schedule_wake(void *, int64_t ms) {
  ensure_app();
  if (!g.wake_timer) {
    g.wake_timer = new QTimer(g.waker.load());
    g.wake_timer->setSingleShot(true);
    QObject::connect(g.wake_timer, &QTimer::timeout, g.wake_timer, [] { run_checkpoint(); });
  }
  g.wake_timer->stop();
  if (ms < 0) return;
  g.wake_timer->setTimerType(ms < 20 ? Qt::PreciseTimer : Qt::CoarseTimer);
  g.wake_timer->start(static_cast<int>(ms > INT32_MAX ? INT32_MAX : ms));
}

int b_run(void *, const svl_host *host) {
  g.host = host;
  ensure_app();
  // Like GTK's `activate`: one checkpoint when the loop starts, whether or not a wake was pending.
  if (g.wake_pending.exchange(false) || !g.queued.load()) {
    g.queued.store(true);
    QMetaObject::invokeMethod(g.waker.load(), [] { run_checkpoint(); }, Qt::QueuedConnection);
  }
  return QCoreApplication::exec();
}

void b_wake(void *) {
  QObject *w = g.waker.load();
  if (!w) {
    g.wake_pending.store(true);
    return;
  }
  g.queued.store(true);
  QMetaObject::invokeMethod(w, [] { run_checkpoint(); }, Qt::QueuedConnection);
}

void b_quit(void *) {
  QObject *w = g.waker.load();
  if (w)
    QMetaObject::invokeMethod(w, [] { QCoreApplication::quit(); }, Qt::QueuedConnection);
  else if (QCoreApplication::instance())
    QCoreApplication::quit();
}

const char *b_last_error(void *) { return g.err.c_str(); }

const svl_backend kBackend = {SVL_ABI_VERSION, &g, b_resolve, b_create, b_insert, b_remove, b_destroy,
                              b_set_prop, b_get_prop, b_call, b_listen, b_handle_info, b_run, b_wake, b_schedule_wake, b_quit,
                              b_last_error};

}  // namespace

extern "C" const svl_backend *svl_qt_backend(void) { return &kBackend; }

// Test and tooling support: not part of the backend ABI.
extern "C" void svl_qt_set_host(const svl_host *host) { g.host = host; }
extern "C" void *svl_qt_debug_object(svl_handle h) {
  Entry *e = find(h);
  return e ? static_cast<void *>(e->obj.data()) : nullptr;
}

// ---- tooling hooks (tests and the counter example; not part of the backend ABI) -----------------

namespace {

QObject *debug_obj(svl_handle h) {
  Entry *e = find(h);
  return e ? e->obj.data() : nullptr;
}

void json_str(std::string &out, const QString &s) {
  out += '"';
  for (const QChar c : s) {
    ushort u = c.unicode();
    if (u == '"' || u == '\\') {
      out += '\\';
      out += static_cast<char>(u);
    } else if (u < 0x20) {
      char b[8];
      std::snprintf(b, sizeof b, "\\u%04x", u);
      out += b;
    } else {
      out += QString(c).toUtf8().constData();
    }
  }
  out += '"';
}

void dump_widget(QWidget *w, int depth, std::string &out);

void dump_layout(QLayout *l, int depth, std::string &out) {
  for (int i = 0; i < l->count(); ++i) {
    QLayoutItem *it = l->itemAt(i);
    if (QWidget *cw = it->widget()) dump_widget(cw, depth, out);
    else if (QLayout *cl = it->layout()) dump_layout(cl, depth, out);
  }
}

void dump_widget(QWidget *w, int depth, std::string &out) {
  QString text;
  if (auto *l = qobject_cast<QLabel *>(w)) text = l->text();
  else if (auto *b = qobject_cast<QAbstractButton *>(w)) text = b->text();
  else if (auto *e = qobject_cast<QLineEdit *>(w)) text = e->text();
  else if (w->isWindow()) text = w->windowTitle();
  if (!out.empty()) out += ',';
  out += "{\"d\":" + std::to_string(depth) + ",\"class\":";
  json_str(out, QString::fromLatin1(w->metaObject()->className()));
  out += ",\"text\":";
  json_str(out, text);
  out += '}';
  if (auto *mw = qobject_cast<QMainWindow *>(w)) {
    if (mw->centralWidget()) dump_widget(mw->centralWidget(), depth + 1, out);
  } else if (auto *sa = qobject_cast<QScrollArea *>(w)) {
    if (sa->widget()) dump_widget(sa->widget(), depth + 1, out);
  } else if (w->layout()) {
    dump_layout(w->layout(), depth + 1, out);
  } else {
    for (QObject *c : w->children())
      if (auto *cw = qobject_cast<QWidget *>(c)) dump_widget(cw, depth + 1, out);
  }
}

std::string dump_buf;

}  // namespace

// The widget tree below `h` in layout order as a JSON array of {d, class, text}. Valid until the next call.
extern "C" const char *svl_qt_dump(svl_handle h) {
  std::string body;
  if (auto *w = qobject_cast<QWidget *>(debug_obj(h))) dump_widget(w, 0, body);
  dump_buf = "[" + body + "]";
  return dump_buf.c_str();
}

// Grab the widget behind `h` into a PNG; a null `path` only renders it.
extern "C" int svl_qt_grab_png(svl_handle h, const char *path) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1;
  QPixmap px = w->grab();
  if (!path) return px.isNull() ? -1 : 0;
  return px.save(QString::fromUtf8(path)) ? 0 : -1;
}

// Type `utf8` into the QLineEdit behind `h` through key events, replacing its content.
extern "C" int svl_qt_type_text(svl_handle h, const char *utf8) {
  auto *e = qobject_cast<QLineEdit *>(debug_obj(h));
  if (!e) return -1;
  const QString text = QString::fromUtf8(utf8);
  e->selectAll();
  if (text.isEmpty()) {
    QKeyEvent press(QEvent::KeyPress, Qt::Key_Backspace, Qt::NoModifier);
    QApplication::sendEvent(e, &press);
    return 0;
  }
  for (const QChar c : text) {
    QKeyEvent press(QEvent::KeyPress, 0, Qt::NoModifier, QString(c));
    QApplication::sendEvent(e, &press);
    QKeyEvent release(QEvent::KeyRelease, 0, Qt::NoModifier, QString(c));
    QApplication::sendEvent(e, &release);
  }
  return 0;
}

// Close the top-level widget behind `h` as if the user clicked its close button.
extern "C" int svl_qt_close(svl_handle h) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  return w && w->close() ? 0 : -1;
}

// Number of top-level widgets that still exist (pending deleteLater included until the loop runs).
extern "C" int svl_qt_toplevel_count(void) { return QApplication::topLevelWidgets().size(); }

// Run `cb(ud)` on the Qt loop thread after `ms` milliseconds. Creates the QApplication if needed.
extern "C" void svl_qt_run_later(void (*cb)(void *), void *ud, int ms) {
  ensure_app();
  QTimer::singleShot(ms, g.waker.load(), [cb, ud] { cb(ud); });
}

extern "C" void svl_qt_set_timing(int on) { g_timing.on = on != 0; }

// Nanoseconds and call count spent inside backend calls since the last take; resets both.
extern "C" void svl_qt_take_timing(uint64_t *ns, uint64_t *calls) {
  *ns = g_timing.ns;
  *calls = g_timing.calls;
  g_timing.ns = 0;
  g_timing.calls = 0;
}

namespace {
// Reports the first QEvent::Paint delivered to any widget.
struct PaintOnce : QObject {
  void (*cb)(void *) = nullptr;
  void *ud = nullptr;
  bool eventFilter(QObject *, QEvent *e) override {
    if (cb && e->type() == QEvent::Paint) {
      auto f = cb;
      cb = nullptr;
      f(ud);
    }
    return false;
  }
};
}  // namespace

// Calls `cb(ud)` when the first widget paints. Creates the QApplication if needed.
extern "C" void svl_qt_on_first_paint(void (*cb)(void *), void *ud) {
  ensure_app();
  auto *p = new PaintOnce;
  p->cb = cb;
  p->ud = ud;
  QCoreApplication::instance()->installEventFilter(p);
}
