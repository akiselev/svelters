struct Entry {
  QPointer<QObject> obj;
  svl_id kind = 0;
  QMetaObject::Connection destroyed;
  bool toplevel = false;      // a parentless widget: lifetime class TOPLEVEL
  bool close_listen = false;  // JS listens for close-request: veto the close and post it
  svl_id close_sig = 0;
};

struct Core {
  const svl_host *host = nullptr;
  std::unordered_map<svl_handle, Entry> table;
  std::map<std::pair<svl_handle, svl_id>, QMetaObject::Connection> listeners;
  svl_handle next = 1;
  std::string err;
  std::string strbuf;
  std::atomic<QObject *> waker{nullptr};
  QTimer *wake_timer = nullptr;  // schedule_wake's single-shot timer; main thread only
  std::atomic<bool> wake_pending{false};
  std::atomic<bool> queued{false};  // a checkpoint is already queued on the loop
};

Core g;

// Optional measurement of the time spent inside backend calls (toolkit side of a host op).
struct Timing {
  bool on = false;
  uint64_t ns = 0;
  uint64_t calls = 0;
};
Timing g_timing;

struct TimeScope {
  bool on;
  std::chrono::steady_clock::time_point t0;
  TimeScope() : on(g_timing.on) {
    if (on) t0 = std::chrono::steady_clock::now();
  }
  ~TimeScope() {
    if (!on) return;
    g_timing.ns += static_cast<uint64_t>(
        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
    g_timing.calls++;
  }
};

int fail(const std::string &m) {
  g.err = m;
  return -1;
}

void ensure_app() {
  if (!QCoreApplication::instance()) {
    static int argc = 1;
    static char arg0[] = "svelters";
    static char *argv[] = {arg0, nullptr};
    static QApplication *app = new QApplication(argc, argv);
    (void)app;
    // The host decides when the app ends (`quit`), not the toolkit.
    QApplication::setQuitOnLastWindowClosed(false);
  }
  if (!g.waker.load()) {
    g.waker.store(new QObject(QCoreApplication::instance()));
  }
}

void run_checkpoint() {
  g.queued.store(false);
  if (g.host && g.host->checkpoint) g.host->checkpoint(g.host->self);
}

Entry *find(svl_handle h) {
  auto it = g.table.find(h);
  if (it == g.table.end() || it->second.obj.isNull()) return nullptr;
  return &it->second;
}

void drop_listeners(svl_handle h) {
  auto lo = g.listeners.lower_bound({h, 0});
  auto hi = g.listeners.lower_bound({h + 1, 0});
  g.listeners.erase(lo, hi);
}

void report_gone(svl_handle h, uint32_t reason) {
  if (g.host && g.host->on_destroyed) g.host->on_destroyed(g.host->self, h, reason);
}

// A QObject we hold a handle for was deleted underneath us (its parent died, an owner replaced it).
// The entry is erased before the host hears about it. Qt emits `destroyed` before the children of
// a QWidget go, so a child can be reported before or after its parent: the host copes with both.
void native_destroyed(svl_handle h, QObject *o) {
  auto it = g.table.find(h);
  if (it == g.table.end()) return;
  g.table.erase(it);
  drop_listeners(h);
  report_gone(h, o && o->parent() ? SVL_GONE_PARENT : SVL_GONE_UNKNOWN);
}

// The user (or `close()`) closed a toplevel that JS is not controlling. Every handle at or below
// the window is forgotten here, while the object tree is still intact, and reported: the window
// as closed, the rest as `parent`. The widgets themselves are deleted later from the event loop.
void native_closed(svl_handle h, QObject *win) {
  std::vector<svl_handle> below;
  for (auto &kv : g.table) {
    if (kv.first == h || kv.second.obj.isNull()) continue;
    for (QObject *p = kv.second.obj->parent(); p; p = p->parent())
      if (p == win) {
        below.push_back(kv.first);
        break;
      }
  }
  std::sort(below.begin(), below.end());
  below.insert(below.begin(), h);
  for (svl_handle x : below) {
    auto it = g.table.find(x);
    if (it == g.table.end()) continue;
    QObject::disconnect(it->second.destroyed);
    g.table.erase(it);
    drop_listeners(x);
  }
  for (svl_handle x : below) report_gone(x, x == h ? SVL_GONE_CLOSED : SVL_GONE_PARENT);
  win->deleteLater();
}

svl_handle handle_of(QObject *o) {
  for (auto &kv : g.table)
    if (kv.second.obj.data() == o) return kv.first;
  return 0;
}

// onRequestClose for toplevels (see backend-abi.md, ABI v2): while JS listens for close-request the
// close is vetoed and posted as an event; otherwise the window is closed for good.
struct CloseFilter : QObject {
  bool eventFilter(QObject *o, QEvent *ev) override {
    if (ev->type() != QEvent::Close) return false;
    svl_handle h = handle_of(o);
    if (!h) return false;
    Entry &e = g.table[h];
    if (e.close_listen) {
      ev->ignore();
      if (g.host && g.host->post_event) g.host->post_event(g.host->self, h, e.close_sig, nullptr, 0);
      return true;
    }
    ev->accept();
    native_closed(h, o);
    return true;
  }
};

void post(svl_handle h, svl_id sig, const svl_value *args, size_t n) {
  if (g.host && g.host->post_event) g.host->post_event(g.host->self, h, sig, args, n);
}

// ---- svl_value conversions -------------------------------------------------------------------

bool to_qstring(const svl_value *v, QString &out) {
  if (v->tag == SVL_NULL) {
    out.clear();
    return true;
  }
  if (v->tag != SVL_STR) return false;
  out = QString::fromUtf8(v->u.s.ptr, static_cast<qsizetype>(v->u.s.len));
  return true;
}
[[maybe_unused]] bool to_bool(const svl_value *v, bool &out) {
  if (v->tag == SVL_BOOL) { out = v->u.b; return true; }
  if (v->tag == SVL_I64) { out = v->u.i != 0; return true; }
  return false;
}
bool to_i64(const svl_value *v, qint64 &out) {
  if (v->tag == SVL_I64) { out = v->u.i; return true; }
  if (v->tag == SVL_F64) { out = static_cast<qint64>(v->u.f); return true; }
  return false;
}
bool to_i32(const svl_value *v, int &out) {
  qint64 x;
  if (!to_i64(v, x)) return false;
  out = static_cast<int>(x);
  return true;
}
[[maybe_unused]] bool to_f64(const svl_value *v, double &out) {
  if (v->tag == SVL_F64) { out = v->u.f; return true; }
  if (v->tag == SVL_I64) { out = static_cast<double>(v->u.i); return true; }
  return false;
}
[[maybe_unused]] QVariant to_variant(const svl_value *v) {
  switch (v->tag) {
    case SVL_BOOL: return QVariant(v->u.b);
    case SVL_I64: return QVariant(static_cast<qlonglong>(v->u.i));
    case SVL_F64: return QVariant(v->u.f);
    case SVL_STR: return QVariant(QString::fromUtf8(v->u.s.ptr, static_cast<qsizetype>(v->u.s.len)));
    default: return QVariant();
  }
}
void out_null(svl_value *out) {
  if (out) { out->tag = SVL_NULL; out->u.i = 0; }
}
void out_bool(svl_value *out, bool b) {
  if (out) { out->tag = SVL_BOOL; out->u.b = b; }
}
void out_i64(svl_value *out, qint64 i) {
  if (out) { out->tag = SVL_I64; out->u.i = i; }
}
void out_f64(svl_value *out, double f) {
  if (out) { out->tag = SVL_F64; out->u.f = f; }
}
void out_str(svl_value *out, const QString &s) {
  if (!out) return;
  QByteArray u = s.toUtf8();
  g.strbuf.assign(u.constData(), static_cast<size_t>(u.size()));
  out->tag = SVL_STR;
  out->u.s.ptr = g.strbuf.data();
  out->u.s.len = g.strbuf.size();
}
[[maybe_unused]] void out_variant(svl_value *out, const QVariant &v) {
  switch (v.typeId()) {
    case QMetaType::Bool: out_bool(out, v.toBool()); break;
    case QMetaType::Int: case QMetaType::UInt: case QMetaType::LongLong: case QMetaType::ULongLong:
      out_i64(out, v.toLongLong()); break;
    case QMetaType::Double: case QMetaType::Float: out_f64(out, v.toDouble()); break;
    case QMetaType::QString: out_str(out, v.toString()); break;
    default: out_null(out);
  }
}
int bad_type(const char *what, const char *want) {
  return fail(std::string(what) + ": expected " + want);
}

