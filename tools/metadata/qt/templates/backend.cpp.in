//@@GETTERS@@

//@@TYPES@@

// The mechanisms of the observe facts (metadata/observe/qt.json, generated as kObsVia): per Qt class and
// Q_PROPERTY, the `via` list of an exact or partial fact. Events end with QEvent::None, signals with nullptr.
enum : unsigned { OV_NOTIFY = 1, OV_BINDABLE = 2, OV_EVENT = 4, OV_SIGNAL = 8, OV_PROPORTIONAL = 16 };
struct ObsVia {
  const char *cls, *prop;
  unsigned mech;
  const QEvent::Type *events;
  const char *const *sigs;
};
//@@OBSERVE@@

// ---- property observation (ABI v2.6; milestone R3) ------------------------------------------
//
// Mechanics, as plans/research/REACTIVITY.md §5 decides them: while (handle, prop) is observed, every native
// change the property's mechanisms announce calls host->prop_changed(h, prop), with no value (the host reads and
// compares). The mechanisms come from the property's observe fact (metadata/observe/qt.json, the generated
// kObsVia table below), looked up by Qt class along the metaobject's superclass chain, and every one the object
// supports is installed:
//   notify    the Q_PROPERTY's NOTIFY signal (a coarse one, QAction::changed(), reports each observed prop)
//   bindable  a QPropertyNotifier on QMetaProperty::bindable (QTimer::interval, QSortFilterProxyModel, ...)
//   event     the handle's event filter, QEvent::Type -> prop ids (QWidget::enabled -> EnabledChange, geometry ->
//             Resize/Move, which Qt sends to a hidden widget only at show(): timing deferred)
//   signal    another signal of the object (QLineEdit::modified -> textEdited, QTextDocument::modified ->
//             modificationChanged, QLineEdit::selectedText -> selectionChanged)
// A property without a fact (reflected type members, NT2 types) falls back to the metaobject: NOTIFY, else
// bindable. Without any mechanism the observation is refused with SVL_OBSERVE_UNSUPPORTED (set_only, none).
// The Qt property is found by the JS name in camelCase (`tool-tip` -> toolTip) on the object's own metaobject.
//
// Ownership: relays hold ids only, never the object; deleting a relay (last `off`, destroy, native death through
// drop_listeners) disconnects it, and the sender's death disconnects it too. The notifier is destroyed with the
// observation; the event filter with the last event-based observation of the handle or with the handle.
// Threads: prop_changed is UI-thread only; notify_prop hops (a queued call) from any other thread.

const ObsVia *obs_via(const QMetaObject *mo, const std::string &prop) {
  static const std::unordered_map<std::string, const ObsVia *> idx = [] {
    std::unordered_map<std::string, const ObsVia *> m;
    for (const ObsVia *v = kObsVia; v->cls; ++v) m.emplace(std::string(v->cls) + ":" + v->prop, v);
    return m;
  }();
  for (; mo; mo = mo->superClass()) {
    auto it = idx.find(std::string(mo->className()) + ":" + prop);
    if (it != idx.end()) return it->second;
  }
  return nullptr;
}

void notify_prop(svl_handle h, svl_id prop) {
  QCoreApplication *app = QCoreApplication::instance();
  if (app && QThread::currentThread() != app->thread()) {
    QMetaObject::invokeMethod(app, [h, prop] { notify_prop(h, prop); }, Qt::QueuedConnection);
    return;
  }
  // Proportional props (whole text): our own set_prop is not reported (§5.4); the host does not read them back.
  if (g.setting.first == h && g.setting.second == prop) {
    auto it = g.observers.find({h, prop});
    if (it != g.observers.end() && it->second.proportional) return;
  }
  if (g.host && g.host->prop_changed) g.host->prop_changed(g.host->self, h, prop);
}

struct PropRelay : QObject {
  svl_handle h;
  svl_id prop;
  PropRelay(svl_handle h_, svl_id p_) : h(h_), prop(p_) {}
  int qt_metacall(QMetaObject::Call c, int id, void **a) override {
    id = QObject::qt_metacall(c, id, a);
    if (id < 0 || c != QMetaObject::InvokeMetaMethod) return id;
    if (id == 0) notify_prop(h, prop);
    return id - 1;
  }
};

// The event filter of one handle: which observed props each QEvent type announces (with a count per prop).
struct ObsFilter : QObject {
  svl_handle h;
  std::map<int, std::map<svl_id, int>> props;
  explicit ObsFilter(svl_handle h_) : h(h_) {}
  bool eventFilter(QObject *, QEvent *e) override {
    auto it = props.find(static_cast<int>(e->type()));
    if (it == props.end()) return false;
    std::vector<svl_id> ids;
    for (const auto &kv : it->second) ids.push_back(kv.first);
    for (svl_id p : ids) notify_prop(h, p);
    return false;
  }
};

std::string camel_of(const char *name) {
  std::string out;
  bool up = false;
  for (const char *c = name; *c; ++c) {
    if (*c == '-' || *c == '_') {
      up = true;
    } else {
      out.push_back(up ? static_cast<char>(std::toupper(static_cast<unsigned char>(*c))) : *c);
      up = false;
    }
  }
  return out;
}

int unsupported(const std::string &m) {
  g.err = m;
  return SVL_OBSERVE_UNSUPPORTED;
}

// A signal of `mo` by name (any overload: the relay ignores the arguments), as a method index; -1 if none.
int signal_index(const QMetaObject *mo, const char *name) {
  for (int i = mo->methodCount() - 1; i >= 0; --i) {
    const QMetaMethod m = mo->method(i);
    if (m.methodType() == QMetaMethod::Signal && m.name() == name) return i;
  }
  return -1;
}

bool relay_to(QObject *o, int signal, svl_handle h, svl_id prop, Observation &ob) {
  auto *r = new PropRelay(h, prop);
  static const int slot = QObject::staticMetaObject.methodCount();
  if (!QMetaObject::connect(o, signal, r, slot, Qt::DirectConnection, nullptr)) {
    delete r;
    return false;
  }
  ob.relays.push_back(r);
  return true;
}

// Drops the event-filter entries of one observation (the filter goes with the handle's last one).
void obs_events_off(svl_handle h, svl_id prop, const Observation &ob) {
  if (ob.events.empty()) return;
  auto fit = g.obs_filters.find(h);
  if (fit == g.obs_filters.end()) return;
  auto *f = static_cast<ObsFilter *>(fit->second);
  for (int t : ob.events) {
    auto it = f->props.find(t);
    if (it == f->props.end()) continue;
    if (--it->second[prop] <= 0) it->second.erase(prop);
    if (it->second.empty()) f->props.erase(it);
  }
  if (f->props.empty()) {
    delete f;  // also removes it from the object's event filters
    g.obs_filters.erase(fit);
  }
}

int b_observe(void *, svl_handle h, svl_id prop, bool on) {
  TimeScope timing_;
  const auto key = std::make_pair(h, prop);
  auto it = g.observers.find(key);
  if (!on) {
    if (it == g.observers.end()) return 0;  // not observed (or the handle is gone): nothing to do
    if (--it->second.count > 0) return 0;
    obs_events_off(h, prop, it->second);
    g.observers.erase(it);
    return 0;
  }
  Entry *e = find(h);
  if (!e) return fail("observe: stale or unknown handle");
  if (it != g.observers.end()) {
    ++it->second.count;
    return 0;
  }
  if (e->kind == kVListKind || e->kind == kCanvasKind) return unsupported("observe: virtual-list and canvas properties cannot be observed");
  // Type-layer props (N2) and metaobject ids carry their native name; element props their JS name.
  const char *pname = svl::is_member_id(prop) ? svl::native_name(prop) : nullptr;
  if (!pname) {
    const svl_member_desc *d = gen_describe(SVL_PROP, e->kind, prop);
    pname = d ? d->name : nullptr;
  }
  if (!pname) return fail("observe: unknown property id " + std::to_string(prop) + " for this kind");
  QObject *o = e->obj.data();
  const QMetaObject *mo = o->metaObject();
  const std::string qname = camel_of(pname);
  const int pi = mo->indexOfProperty(qname.c_str());
  const ObsVia *via = obs_via(mo, qname);
  QMetaProperty mp;
  if (pi >= 0) {
    mp = mo->property(pi);
    if (!mp.isReadable()) return fail("observe: " + qname + " is write-only");
    if (mp.isConstant()) return fail("observe: " + qname + " is CONSTANT: it never changes");
  } else if (!via) {
    return unsupported("observe: " + std::string(pname) + " is not a Q_PROPERTY of " + mo->className() +
                       " and has no observe fact, so nothing announces it");
  }
  // Without a fact: the metaobject fallback (NOTIFY, else bindable).
  const unsigned mech = via ? via->mech : (pi >= 0 && mp.hasNotifySignal() ? OV_NOTIFY : pi >= 0 && mp.isBindable() ? OV_BINDABLE : 0);
  Observation ob;
  ob.proportional = via && (via->mech & OV_PROPORTIONAL);
  if ((mech & OV_NOTIFY) && pi >= 0 && mp.hasNotifySignal() && !relay_to(o, mp.notifySignalIndex(), h, prop, ob))
    return fail("observe: connecting " + qname + "'s NOTIFY signal failed");
  if ((mech & OV_BINDABLE) && pi >= 0 && mp.isBindable()) {
    QUntypedBindable b = mp.bindable(o);
    if (b.isValid()) ob.notifier = std::make_unique<QPropertyNotifier>(b.addNotifier([h, prop] { notify_prop(h, prop); }));
  }
  if ((mech & OV_SIGNAL) && via && via->sigs) {
    for (const char *const *s = via->sigs; *s; ++s) {
      const int si = signal_index(mo, *s);
      if (si >= 0 && !relay_to(o, si, h, prop, ob)) return fail("observe: connecting " + std::string(*s) + " failed");
    }
  }
  if ((mech & OV_EVENT) && via && via->events) {
    auto fit = g.obs_filters.find(h);
    ObsFilter *f = fit == g.obs_filters.end() ? nullptr : static_cast<ObsFilter *>(fit->second);
    if (!f) {
      f = new ObsFilter(h);
      o->installEventFilter(f);
      g.obs_filters[h] = f;
    }
    for (const QEvent::Type *t = via->events; *t != QEvent::None; ++t) {
      ++f->props[static_cast<int>(*t)][prop];
      ob.events.push_back(static_cast<int>(*t));
    }
  }
  if (ob.relays.empty() && !ob.notifier && ob.events.empty())
    return unsupported("observe: " + std::string(mo->className()) + "::" + qname +
                       " has no NOTIFY signal, bindable, event or signal that announces it");
  g.observers.emplace(key, std::move(ob));
  return 0;
}

// ---- vtable ----------------------------------------------------------------------------------

svl_id b_resolve(void *, uint32_t what, svl_id kind, const char *name, size_t len) {
  std::string_view n(name, len);
  if (what == SVL_KIND && n == "virtual-list") return kVListKind;
  if (what == SVL_KIND && n == "canvas") return kCanvasKind;
  if (kind == kVListKind) return vl_resolve(what, n);
  if (kind == kCanvasKind) return cv_resolve(what, n);
  // Non-GUI type kinds (N2): their own and inherited members, then the metaobject fallback. A static that
  // shares its name with an instance method is reached as `static:<name>` (the JS modules know which).
  if (svl::is_type_kind(kind)) {
    if (what == SVL_METHOD && n.substr(0, 7) == "static:") return svl::gen_static_member(kind, n.substr(7));
    if (svl_id t = svl::resolve(what, kind, n)) return t;
  }
  Table t = table_for(what, kind);
  for (size_t i = 0; i < t.n; ++i)
    if (t.items[i].name == n) return t.items[i].id;
  // Object getters (parentWidget, viewport, lineEdit, ...) apply to any kind, annotated or not.
  if (what == SVL_METHOD)
    for (size_t i = 0; i < kGetterCount; ++i)
      if (kGetterNames[i] == n) return kGetterBase + static_cast<svl_id>(i);
  // Type kinds by native name (`QTimer`), and element kinds' methods of their class's bound type.
  if (what == SVL_KIND || !svl::is_type_kind(kind)) return svl::resolve(what, kind, n);
  return svl::resolve_dynamic(what, kind, n);
}

svl_handle b_create(void *, svl_id kind) {
  TimeScope timing_;
  ensure_app();
  QObject *o = kind == kVListKind ? vl_create() : kind == kCanvasKind ? cv_create() : gen_create(kind);
  if (!o) {
    fail("create: unknown kind id " + std::to_string(kind));
    return 0;
  }
  svl_handle h = g.next++;
  Entry e;
  e.obj = o;
  e.kind = kind;
  g.by_obj[o] = h;
  if (kind == kVListKind) vl_after_create(o, h);
  e.destroyed = QObject::connect(o, &QObject::destroyed, [h](QObject *obj) { native_destroyed(h, obj); });
  if (auto *w = qobject_cast<QWidget *>(o); w && gen_is_toplevel(kind)) {
    e.toplevel = true;
    e.life = SVL_LIFE_TOPLEVEL;
    static CloseFilter *filter = new CloseFilter;
    w->installEventFilter(filter);
  }
  g.table.emplace(h, std::move(e));
  return h;
}

int b_insert(void *, svl_handle parent, svl_handle child, svl_handle before, svl_id slot) {
  TimeScope timing_;
  Entry *p = find(parent);
  if (!p) return fail("insert: stale or unknown parent handle");
  Entry *c = find(child);
  if (!c) return fail("insert: stale or unknown child handle");
  if (p->life == SVL_LIFE_BORROWED || c->life == SVL_LIFE_BORROWED)
    return fail("insert: a borrowed native object cannot be inserted or removed through the tree");
  QObject *b = nullptr;
  if (before) {
    Entry *be = find(before);
    if (!be) return fail("insert: stale or unknown `before` handle");
    b = be->obj.data();
  }
  if (c->toplevel) {
    // A toplevel child is transient for the window of `parent` (backend-abi.md, "Toplevels in the tree"):
    // Qt's form of that is the parent widget, which keeps the window type through the explicit flags.
    auto *cw = qobject_cast<QWidget *>(c->obj.data());
    auto *pw = qobject_cast<QWidget *>(p->obj.data());
    if (!cw || !pw) return fail("insert: a toplevel needs a widget parent");
    if (c->placed) return fail("insert: the toplevel is already inserted");
    if (pw->window() == cw) return fail("insert: a window cannot be transient for itself");
    cw->setParent(pw->window(), cw->windowFlags());
    c->placed = parent;
    c->slot = 0;
    return 0;
  }
  svl_id used = slot;
  int rc = gen_is_context(c->kind) && ctx_role(p->obj.data()) ? ctx_attach(p->obj.data(), c->obj.data()) : gen_insert(*p, c->obj.data(), b, used);
  if (rc == 0) {
    c->placed = parent;
    c->slot = used;
  }
  return rc;
}

int b_remove(void *, svl_handle parent, svl_handle child) {
  TimeScope timing_;
  Entry *p = find(parent);
  if (!p) return fail("remove: stale or unknown parent handle");
  Entry *c = find(child);
  if (!c) return fail("remove: stale or unknown child handle");
  if (p->life == SVL_LIFE_BORROWED || c->life == SVL_LIFE_BORROWED)
    return fail("remove: a borrowed native object cannot be inserted or removed through the tree");
  if (c->toplevel) {
    auto *cw = qobject_cast<QWidget *>(c->obj.data());
    if (!cw || c->placed != parent) return fail("remove: child is not in this parent");
    cw->setParent(nullptr, cw->windowFlags());
    c->placed = 0;
    return 0;
  }
  int rc = gen_is_context(c->kind) && ctx_role(p->obj.data()) ? ctx_detach(p->obj.data(), c->obj.data()) : gen_remove(*p, c->obj.data());
  if (rc == 0) {
    c->placed = 0;
    c->slot = 0;
  }
  return rc;
}

void b_destroy(void *, svl_handle h) {
  TimeScope timing_;
  if (g.boxed.erase(h)) {  // a boxed value: drop the held copy (idempotent)
    g_boxed_kind.erase(h);
    return;
  }
  if (svl::destroy(h)) return;  // a unique object or an item (N2)
  auto it = g.table.find(h);
  if (it == g.table.end()) return;
  QObject *o = it->second.obj.data();
  const bool toplevel = it->second.toplevel;
  const bool borrowed = it->second.life == SVL_LIFE_BORROWED;
  // SHARED (an object JS made, decision Q1): JS's reference is the ownership unless a QObject parent took it.
  const bool parented = it->second.life == SVL_LIFE_SHARED && o && o->parent();
  QObject::disconnect(it->second.destroyed);
  if (o) g.by_obj.erase(o);
  g.table.erase(it);
  drop_listeners(h);
  // A borrowed object belongs to its native owner: forget it, never delete it.
  if (borrowed || parented) return;
  // Not a candidate for a new borrowed handle while the deferred delete is pending.
  if (o) o->setProperty("_svl_dying", true);
  // Never delete synchronously: the caller may be inside one of this object's signals.
  if (o) {
    if (auto *w = qobject_cast<QWidget *>(o); w && toplevel) w->hide();
    o->deleteLater();
  }
}

int b_set_prop(void *, svl_handle h, svl_id prop, const svl_value *v) {
  TimeScope timing_;
  Entry *e = find(h);
  if (!e) return fail("set_prop: stale or unknown handle");
  if (!v) return fail("set_prop: null value");
  g_in.clear();
  struct Setting {  // which (handle, prop) we are writing: its proportional observation stays silent (§5.4)
    std::pair<svl_handle, svl_id> prev = g.setting;
    Setting(svl_handle h, svl_id p) { g.setting = {h, p}; }
    ~Setting() { g.setting = prev; }
  } setting_(h, prop);
  try {
    if (e->kind == kVListKind) return vl_set_prop(*e, prop, v);
    if (e->kind == kCanvasKind) return cv_set_prop(*e, prop, v);
    if (svl::is_member_id(prop)) return svl::set_prop(*e, prop, v);
    return gen_set_prop(*e, prop, v);
  } catch (const std::exception &x) {
    return fail(std::string("set_prop: C++ exception: ") + x.what());
  } catch (...) {
    return fail("set_prop: unknown C++ exception");
  }
}

int b_get_prop(void *, svl_handle h, svl_id prop, svl_value *out) {
  TimeScope timing_;
  Entry *e = find(h);
  if (!e) return fail("get_prop: stale or unknown handle");
  g_out.clear();
  g_owner = e->obj.data();
  try {
    if (e->kind == kVListKind) return vl_get_prop(*e, prop, out);
    if (e->kind == kCanvasKind) return cv_get_prop(*e, prop, out);
    if (svl::is_member_id(prop)) return svl::get_prop(*e, prop, out);
    return gen_get_prop(*e, prop, out);
  } catch (const std::exception &x) {
    out_error(out, "c++", x.what());
    return fail(std::string("get_prop: C++ exception: ") + x.what());
  } catch (...) {
    out_error(out, "c++", "unknown C++ exception");
    return fail("get_prop: unknown C++ exception");
  }
}

int b_call(void *, svl_handle h, svl_id method, const svl_value *args, size_t n, svl_value *out) {
  TimeScope timing_;
  g_out.clear();
  g_in.clear();
  out_null(out);
  try {
    // VALUE, unique and item handles, and type-layer members of QObject handles (N2).
    Entry *te = find(h);
    g_owner = te ? te->obj.data() : nullptr;
    bool handled = false;
    const int rc = svl::call(h, method, args, n, out, handled);
    if (handled) return rc;
  } catch (const std::exception &x) {
    out_error(out, "c++", x.what());
    return fail(std::string("call: C++ exception: ") + x.what());
  } catch (...) {
    out_error(out, "c++", "unknown C++ exception");
    return fail("call: unknown C++ exception");
  }
  Entry *e = find(h);
  if (!e) return fail("call: stale or unknown handle");
  g_owner = e->obj.data();
  try {
    if (g_test_throw) {  // test hook: make the next call throw, to exercise the boundary
      g_test_throw = false;
      throw std::runtime_error("test exception");
    }
    if (e->kind == kVListKind) return vl_call(*e, method, args, n, out);
    if (e->kind == kCanvasKind) return fail("call: the canvas has no methods");
    if (method >= kGetterBase) {
      if (n != 0) return fail("call: object getters take no arguments");
      QObject *r = nullptr;
      int rc = gen_getter(*e, method, &r);
      if (rc != 0) return rc;
      g_owner = e->obj.data();
      Conv<QObject *>::out(r, out);
      return 0;
    }
    return gen_call(*e, method, args, n, out);
  } catch (const std::exception &x) {
    out_error(out, "c++", x.what());
    return fail(std::string("call: C++ exception: ") + x.what());
  } catch (...) {
    out_error(out, "c++", "unknown C++ exception");
    return fail("call: unknown C++ exception");
  }
}

const svl_member_desc *b_describe(void *, uint32_t what, svl_id kind, svl_id member) {
  if (what == SVL_KIND || svl::is_member_id(member)) return svl::describe(what, kind, member);
  return gen_describe(what, kind, member);
}

const svl_type_desc *b_describe_type(void *, svl_id type) { return type_desc_for(type); }

int b_listen_ex(void *, svl_handle h, svl_id sig, bool on, uint32_t flags) {
  TimeScope timing_;
  Entry *e = find(h);
  if (!e) return fail("listen: stale or unknown handle");
  if (flags & ~static_cast<uint32_t>(SVL_LISTEN_AFTER | SVL_LISTEN_CAPTURE)) return fail("listen: unknown listener flags");
  if (e->kind == kVListKind) return vl_listen(*e, sig, on);
  if (e->kind == kCanvasKind) return cv_listen(h, *e, sig, on, flags);
  if (svl::is_member_id(sig)) return svl::listen(h, *e, sig, on, flags);
  return gen_listen(h, *e, sig, on, flags);
}

int b_listen(void *self, svl_handle h, svl_id sig, bool on) { return b_listen_ex(self, h, sig, on, 0); }

// ABI v2.2 child attributes. The state lives in Qt (a grid cell, a tab label): nothing is cached, and
// removing the child from its parent takes the attributes with it.
int b_set_child_attr(void *, svl_handle parent, svl_handle child, svl_id attr, const svl_value *v) {
  TimeScope timing_;
  Entry *p = find(parent);
  if (!p) return fail("set_child_attr: stale or unknown parent handle");
  Entry *c = find(child);
  if (!c) return fail("set_child_attr: stale or unknown child handle");
  if (!v) return fail("set_child_attr: null value");
  if (c->placed != parent) return fail("set_child_attr: child attributes need an inserted child (this child is not inserted in this parent)");
  g_in.clear();
  try {
    return gen_set_child_attr(*p, *c, attr, v);
  } catch (const std::exception &x) {
    return fail(std::string("set_child_attr: C++ exception: ") + x.what());
  } catch (...) {
    return fail("set_child_attr: unknown C++ exception");
  }
}

int b_get_child_attr(void *, svl_handle parent, svl_handle child, svl_id attr, svl_value *out) {
  TimeScope timing_;
  Entry *p = find(parent);
  if (!p) return fail("get_child_attr: stale or unknown parent handle");
  Entry *c = find(child);
  if (!c) return fail("get_child_attr: stale or unknown child handle");
  if (c->placed != parent) return fail("get_child_attr: child attributes need an inserted child (this child is not inserted in this parent)");
  g_out.clear();
  try {
    return gen_get_child_attr(*p, *c, attr, out);
  } catch (const std::exception &x) {
    return fail(std::string("get_child_attr: C++ exception: ") + x.what());
  } catch (...) {
    return fail("get_child_attr: unknown C++ exception");
  }
}

int b_handle_info(void *, svl_handle h, svl_handle_info *out) {
  if (g.boxed.count(h)) {  // a boxed value is a VALUE handle: refcounted and immutable, released by `destroy`
    auto k = g_boxed_kind.find(h);
    out->kind = k == g_boxed_kind.end() ? 0 : k->second;  // N2: values of bound classes have a kind
    out->lifetime = SVL_LIFE_VALUE;
    out->flags = 0;
    return 0;
  }
  if (svl::handle_info(h, out)) return 0;  // unique objects and items
  Entry *e = find(h);
  if (!e) return fail("handle_info: stale or unknown handle");
  out->kind = e->kind;
  out->lifetime = e->life;
  out->flags = 0;
  return 0;
}

// One single-shot timer, re-armed by every call. Short timeouts use a precise timer, longer ones
// a coarse timer so the toolkit can coalesce wakeups.
void b_schedule_wake(void *, int64_t ms) {
  ensure_app();
  if (!g.wake_timer) {
    g.wake_timer = new QTimer(g.waker.load());
    g.wake_timer->setSingleShot(true);
    QObject::connect(g.wake_timer, &QTimer::timeout, g.wake_timer, [] { run_checkpoint(); });
  }
  g.wake_timer->stop();
  if (ms < 0) return;
  g.wake_timer->setTimerType(ms < 20 ? Qt::PreciseTimer : Qt::CoarseTimer);
  g.wake_timer->start(static_cast<int>(ms > INT32_MAX ? INT32_MAX : ms));
}

int b_run(void *, const svl_host *host) {
  g.host = host;
  ensure_app();
  // Like GTK's `activate`: one checkpoint when the loop starts, whether or not a wake was pending.
  g.wake_pending.store(false);
  if (!g.queued.exchange(true))
    QMetaObject::invokeMethod(g.waker.load(), [] { wake_checkpoint(); }, Qt::QueuedConnection);
  const int rc = QCoreApplication::exec();
  // The host vtable is only guaranteed while `run` is on the stack; late timers must not use it.
  g.host = nullptr;
  return rc;
}

void b_wake(void *) {
  QObject *w = g.waker.load();
  if (!w) {
    g.wake_pending.store(true);
    return;
  }
  // Coalesced (FU3, as GTK's FU2 wake): while a posted checkpoint is pending, more wakes add nothing.
  if (g.queued.exchange(true)) return;
  QMetaObject::invokeMethod(w, [] { wake_checkpoint(); }, Qt::QueuedConnection);
}

// ABI v2.7: attaches the host without running the loop (the caller pumps Qt's events, or `run` follows);
// creates the QApplication. A wake that came before the waker existed is delivered now. NULL detaches:
// queued checkpoints and timers then skip the host (`run_checkpoint` reads g.host).
int b_start(void *, const svl_host *host) {
  g.host = host;
  if (!host) return 0;
  try {
    ensure_app();
  } catch (...) {
    return fail("start: unknown C++ exception");
  }
  if (g.wake_pending.exchange(false)) b_wake(nullptr);
  return 0;
}

void b_quit(void *) {
  QObject *w = g.waker.load();
  if (w)
    QMetaObject::invokeMethod(w, [] { QCoreApplication::quit(); }, Qt::QueuedConnection);
  else if (QCoreApplication::instance())
    QCoreApplication::quit();
}

const char *b_last_error(void *) { return g.err.c_str(); }

// The JS side aborted an async operation: stop it and reject its Promise.
int b_cancel(void *, uint64_t callback) {
  auto it = g.asyncs.find(callback);
  if (it == g.asyncs.end()) return 0;
  if (!it->second.cancel) return 0;
  AsyncOp op = std::move(it->second);
  QObject::disconnect(op.conn);
  g.asyncs.erase(it);
  if (!op.obj.isNull()) op.cancel();
  svl_value err = mkv(SVL_NULL);
  out_error(&err, "qt", "operation cancelled");
  if (g.host && g.host->invoke_callback) {
    svl_value res = mkv(SVL_NULL);
    g.host->invoke_callback(g.host->self, callback, &err, 1, &res);
  }
  return 1;
}

// One host->frame on the next frame: QWindow::requestUpdate() on a platform-backed toplevel, whose
// UpdateRequest event the frame filter turns into the callback. Without such a window a 16 ms
// timer stands in; with one, a 250 ms watchdog covers a window that stops updating (hidden).
// ---- styling (ABI v2.3 `style`; plans/architecture/backend-abi.md, docs/notes/x6-styling.md) -------
//
// Qt speaks QSS. JS renders the token placeholders before sending, so the backend only keeps the
// component sheets by id, concatenates them in registration order into the application stylesheet
// and sets it once. Setting the sheet is a full re-polish, so it happens immediately while no
// window is visible (the app's startup: nothing to polish yet) and coalesced into one zero-delay
// timer turn afterwards. Classes are the dynamic property `class = "<QtClass> a b"`: QSS reads the
// class name from that very property, so `.QPushButton` keeps matching next to our classes.
struct StyleState {
  std::vector<std::pair<std::string, std::string>> sheets;  // id -> QSS text, registration order
  bool fusion = false;
  bool apply_queued = false;
  std::string applied;  // the last application stylesheet set
};
StyleState g_style;

QString style_class_name(QObject *o) { return QString::fromLatin1(o->metaObject()->className()); }

void style_repolish(QObject *o) {
  if (auto *w = qobject_cast<QWidget *>(o)) {
    if (QStyle *st = w->style()) {
      st->unpolish(w);
      st->polish(w);
    }
    w->update();
  }
}

void style_ensure_fusion() {
  if (g_style.fusion) return;
  g_style.fusion = true;
  if (QApplication::style() && QApplication::style()->name().compare(QLatin1String("fusion"), Qt::CaseInsensitive) != 0) {
    if (QStyle *s = QStyleFactory::create(QStringLiteral("Fusion"))) QApplication::setStyle(s);
  }
}

bool style_any_visible() {
  for (QWidget *w : QApplication::topLevelWidgets())
    if (w->isVisible()) return true;
  return false;
}

void style_apply_now() {
  g_style.apply_queued = false;
  std::string all;
  for (auto &s : g_style.sheets) {
    all += s.second;
    if (!all.empty() && all.back() != '\n') all += '\n';
  }
  if (all == g_style.applied) return;
  g_style.applied = all;
  qApp->setStyleSheet(QString::fromUtf8(all.data(), static_cast<qsizetype>(all.size())));
}

void style_apply() {
  if (!style_any_visible()) {
    style_apply_now();
    return;
  }
  if (g_style.apply_queued) return;
  g_style.apply_queued = true;
  QTimer::singleShot(0, g.waker.load(), [] { style_apply_now(); });
}

QString style_str(const svl_value *v) { return QString::fromUtf8(static_cast<const char *>(v->u.s.ptr), static_cast<qsizetype>(v->u.s.len)); }

// ---- TR1 visual channels (ABI v2.8): the per-frame values of transitions ----------------------
// One graphics effect per widget carries opacity and transform: a QGraphicsOpacityEffect (so the
// opacity path and its readers stay as they were) that, while a transform is set, paints the
// source pixmap through it. Clip is maximumWidth/Height (the layout gives the space back, the
// content is cut or squeezed); inert is WA_TransparentForMouseEvents + NoFocus.
class SvlVisualEffect : public QGraphicsOpacityEffect {
 public:
  explicit SvlVisualEffect(QObject *parent) : QGraphicsOpacityEffect(parent) { setOpacity(1.0); }
  bool tf = false;
  double tx = 0, ty = 0, sx = 1, sy = 1, ox = 0.5, oy = 0.5;
  QTransform transformFor(const QRectF &r) const {
    const QPointF o(r.x() + r.width() * ox, r.y() + r.height() * oy);
    QTransform t;
    t.translate(o.x() + tx, o.y() + ty);
    t.scale(sx, sy);
    t.translate(-o.x(), -o.y());
    return t;
  }
  // updateBoundingRect is protected on QGraphicsEffect
  void transformChanged() {
    updateBoundingRect();
    update();
  }

 protected:
  QRectF boundingRectFor(const QRectF &r) const override { return tf ? transformFor(r).mapRect(r) : r; }
  void draw(QPainter *p) override {
    if (!tf) {
      QGraphicsOpacityEffect::draw(p);
      return;
    }
    QPoint offset;
    const QPixmap pm = sourcePixmap(Qt::LogicalCoordinates, &offset, QGraphicsEffect::NoPad);
    if (pm.isNull()) return;
    const QRectF r = sourceBoundingRect(Qt::LogicalCoordinates);
    p->save();
    p->setOpacity(p->opacity() * opacity());
    p->setRenderHint(QPainter::SmoothPixmapTransform, true);
    p->setWorldTransform(transformFor(r), true);
    p->drawPixmap(offset, pm);
    p->restore();
  }
};

SvlVisualEffect *visual_fx(QWidget *w, bool create) {
  auto *fx = dynamic_cast<SvlVisualEffect *>(w->graphicsEffect());
  if (!fx && create) {
    // an opacity effect someone else set: carry its opacity over
    const auto *old = qobject_cast<QGraphicsOpacityEffect *>(w->graphicsEffect());
    const double a = old ? old->opacity() : 1.0;
    fx = new SvlVisualEffect(w);
    fx->setOpacity(a);
    w->setGraphicsEffect(fx);
  }
  return fx;
}

// Drops the effect once it does nothing (opacity 1, no transform): no offscreen rendering at rest.
void visual_prune(QWidget *w) {
  auto *fx = dynamic_cast<SvlVisualEffect *>(w->graphicsEffect());
  if (fx && !fx->tf && fx->opacity() >= 1.0) w->setGraphicsEffect(nullptr);
}

bool parse_nums(const QString &text, double *out, int n) {
  const QStringList parts = text.split(QLatin1Char(' '), Qt::SkipEmptyParts);
  if (parts.size() != n) return false;
  for (int i = 0; i < n; ++i) {
    bool ok = false;
    out[i] = parts[i].toDouble(&ok);
    if (!ok) return false;
  }
  return true;
}

int visual_op(QWidget *w, uint32_t op, bool has, const QString &text) {
  if (op == SVL_STYLE_TRANSFORM) {
    if (!has) {
      if (auto *fx = visual_fx(w, false)) {
        fx->tf = false;
        fx->transformChanged();
      }
      visual_prune(w);
      return 0;
    }
    double t[6];
    if (!parse_nums(text, t, 6)) return fail("style: transform is not 6 numbers");
    auto *fx = visual_fx(w, true);
    fx->tf = true;
    fx->tx = t[0];
    fx->ty = t[1];
    fx->sx = t[2];
    fx->sy = t[3];
    fx->ox = t[4];
    fx->oy = t[5];
    fx->transformChanged();
    return 0;
  }
  if (op == SVL_STYLE_CLIP) {
    // the widget's own maximum size, saved before the first clip and restored after the last
    const char *saved = "_svl_clip_saved";
    QVariant orig = w->property(saved);
    if (!has) {
      if (orig.isValid()) {
        const QSize s = orig.toSize();
        w->setMaximumSize(s);
        w->setProperty(saved, QVariant());
      }
      return 0;
    }
    double c[2];
    if (!parse_nums(text, c, 2)) return fail("style: clip is not 2 numbers");
    if (!orig.isValid()) {
      orig = QVariant(w->maximumSize());
      w->setProperty(saved, orig);
    }
    const QSize s = orig.toSize();
    w->setMaximumWidth(c[0] >= 0 ? qMin(s.width(), static_cast<int>(std::lround(c[0]))) : s.width());
    w->setMaximumHeight(c[1] >= 0 ? qMin(s.height(), static_cast<int>(std::lround(c[1]))) : s.height());
    return 0;
  }
  // SVL_STYLE_INERT
  const char *saved = "_svl_inert_focus";
  if (has) {
    if (!w->property(saved).isValid()) {
      w->setProperty(saved, static_cast<int>(w->focusPolicy()));
      w->setAttribute(Qt::WA_TransparentForMouseEvents, true);
      w->setFocusPolicy(Qt::NoFocus);
    }
  } else if (w->property(saved).isValid()) {
    w->setFocusPolicy(static_cast<Qt::FocusPolicy>(w->property(saved).toInt()));
    w->setProperty(saved, QVariant());
    w->setAttribute(Qt::WA_TransparentForMouseEvents, false);
  }
  return 0;
}

// ABI v2.8 bounds: the widget's rect in its window, after the window's layout is brought up to
// date (QLayout::activate: synchronous), or (0, 0, sizeHint) while it is not shown.
int b_bounds(void *, svl_handle h, double *out) {
  TimeScope timing_;
  try {
    Entry *e = find(h);
    if (!e) return fail("bounds: stale or unknown handle");
    auto *w = qobject_cast<QWidget *>(e->obj.data());
    if (!w) return fail("bounds: not a widget");
    if (!w->isVisible()) {
      const QSize s = w->sizeHint().expandedTo(w->minimumSizeHint());
      out[0] = out[1] = 0;
      out[2] = s.isValid() ? s.width() : 0;
      out[3] = s.isValid() ? s.height() : 0;
      return 0;
    }
    QWidget *win = w->window();
    if (win && win->layout()) win->layout()->activate();
    for (QWidget *p = w->parentWidget(); p && p != win; p = p->parentWidget())
      if (p->layout()) p->layout()->activate();
    const QPoint pos = win && win != w ? w->mapTo(win, QPoint(0, 0)) : QPoint(0, 0);
    out[0] = pos.x();
    out[1] = pos.y();
    out[2] = w->width();
    out[3] = w->height();
    return 0;
  } catch (const std::exception &ex) {
    return fail(std::string("bounds: ") + ex.what());
  } catch (...) {
    return fail("bounds: unknown C++ exception");
  }
}

int b_style(void *, uint32_t op, svl_handle h, const svl_value *v) {
  TimeScope timing_;
  ensure_app();
  const bool has = v && v->tag == SVL_STR;
  const QString text = has ? style_str(v) : QString();
  try {
    switch (op) {
      case SVL_STYLE_TARGET:
        return SVL_STYLE_TARGET_QSS;
      case SVL_STYLE_CLASSES:
      case SVL_STYLE_NAME:
      case SVL_STYLE_INLINE:
      case SVL_STYLE_OPACITY: {
        Entry *e = find(h);
        if (!e) return fail("style: stale or unknown handle");
        QObject *o = e->obj.data();
        if (op == SVL_STYLE_CLASSES) {
          style_ensure_fusion();
          const QString value = text.isEmpty() ? style_class_name(o) : style_class_name(o) + QLatin1Char(' ') + text;
          o->setProperty("class", value);
          style_repolish(o);
        } else if (op == SVL_STYLE_NAME) {
          o->setObjectName(text);
          style_repolish(o);
        } else if (auto *w = qobject_cast<QWidget *>(o)) {
          if (op == SVL_STYLE_INLINE) {
            style_ensure_fusion();
            w->setStyleSheet(text.trimmed().isEmpty() ? QString() : QStringLiteral(".") + style_class_name(o) + QStringLiteral(" {\n") + text + QStringLiteral("\n}"));
          } else {
            bool ok = true;
            const double a = has ? text.toDouble(&ok) : 1.0;
            if (!ok) return fail("style: opacity is not a number");
            if (!has || a >= 1.0) {
              // TR1: the effect may still carry a transform
              if (auto *fx = visual_fx(w, false)) fx->setOpacity(1.0);
              visual_prune(w);
            } else {
              visual_fx(w, true)->setOpacity(a < 0.0 ? 0.0 : a);
            }
          }
        } else {
          return fail("style: inline style and opacity need a widget");
        }
        return 0;
      }
      case SVL_STYLE_TRANSFORM:
      case SVL_STYLE_CLIP:
      case SVL_STYLE_INERT: {
        Entry *e = find(h);
        if (!e) return fail("style: stale or unknown handle");
        auto *w = qobject_cast<QWidget *>(e->obj.data());
        if (!w) return fail("style: transform, clip and inert need a widget");
        return visual_op(w, op, has, text);
      }
      case SVL_STYLE_SHEET: {
        style_ensure_fusion();
        if (!v || v->tag != SVL_STR) {
          g_style.sheets.clear();
          style_apply();
          return 0;
        }
        const std::string raw(static_cast<const char *>(v->u.s.ptr), v->u.s.len);
        const size_t sep = raw.find('\x01');
        const std::string id = raw.substr(0, sep);
        auto it = g_style.sheets.begin();
        for (; it != g_style.sheets.end(); ++it)
          if (it->first == id) break;
        if (sep == std::string::npos) {
          if (it != g_style.sheets.end()) g_style.sheets.erase(it);
        } else if (it != g_style.sheets.end()) {
          it->second = raw.substr(sep + 1);
        } else {
          g_style.sheets.emplace_back(id, raw.substr(sep + 1));
        }
        style_apply();
        return 0;
      }
      case SVL_STYLE_SCHEME: {
        style_ensure_fusion();
        const QStringList parts = text.split(QChar(1));
        static const QPalette original = QApplication::palette();
        QPalette pal = original;
        static const std::pair<const char *, QPalette::ColorRole> roles[] = {
            {"window", QPalette::Window},       {"button", QPalette::Button},
            {"windowText", QPalette::WindowText}, {"text", QPalette::Text},
            {"buttonText", QPalette::ButtonText}, {"base", QPalette::Base},
            {"highlight", QPalette::Highlight}, {"highlightedText", QPalette::HighlightedText},
            {"placeholderText", QPalette::PlaceholderText}};
        for (int i = 1; i < parts.size(); ++i) {
          const int eq = parts[i].indexOf(QLatin1Char('='));
          if (eq < 0) continue;
          const QString name = parts[i].left(eq);
          const QColor c(parts[i].mid(eq + 1));
          if (!c.isValid()) continue;
          for (const auto &r : roles)
            if (name == QLatin1String(r.first)) pal.setColor(r.second, c);
        }
        QApplication::setPalette(pal);
        return 0;
      }
      default:
        return fail("style: unknown op " + std::to_string(op));
    }
  } catch (const std::exception &x) {
    return fail(std::string("style: C++ exception: ") + x.what());
  }
}

void b_request_frame(void *) {
  ensure_app();
  if (g.frame_pending) return;
  g.frame_pending = true;
  if (!g.frame_timer) {
    g.frame_timer = new QTimer(g.waker.load());
    g.frame_timer->setSingleShot(true);
    QObject::connect(g.frame_timer, &QTimer::timeout, g.frame_timer, [] { deliver_frame(false); });
  }
  int delay = 16;
  if (QWindow *win = frame_window()) {
    if (g.frame_win.data() != win) {
      if (!g.frame_filter) g.frame_filter = new FrameFilter;
      if (!g.frame_win.isNull()) g.frame_win->removeEventFilter(g.frame_filter);
      win->installEventFilter(g.frame_filter);
      g.frame_win = win;
    }
    win->requestUpdate();
    delay = 250;
  }
  g.frame_timer->setTimerType(delay < 20 ? Qt::PreciseTimer : Qt::CoarseTimer);
  g.frame_timer->start(delay);
}

// ABI v2.5 construct: a type kind through the non-GUI core (SHARED, default constructor then setters);
// an element kind is `create` plus `set_prop`, so a widget made this way is OWNED / TOPLEVEL as usual.
int b_construct(void *self, svl_id kind, const svl_id *props, const svl_value *values, size_t n, svl_value *out) {
  TimeScope timing_;
  g_out.clear();
  g_in.clear();
  try {
    if (svl::is_type_kind(kind)) return svl::construct(kind, props, values, n, out);
    const svl_handle h = b_create(self, kind);
    if (!h) return -1;
    for (size_t i = 0; i < n; ++i)
      if (b_set_prop(self, h, props[i], &values[i]) != 0) {
        const std::string why = g.err;
        b_destroy(self, h);
        return fail(why);
      }
    *out = mkv(SVL_HANDLE);
    out->u.h = h;
    return 0;
  } catch (const std::exception &x) {
    return fail(std::string("construct: C++ exception: ") + x.what());
  }
}

// ABI v2.5 call_static: statics and constructors (`new`) of the type kinds.
int b_call_static(void *, svl_id kind, svl_id method, const svl_value *args, size_t n, svl_value *out) {
  TimeScope timing_;
  try {
    if (!svl::is_type_kind(kind)) return fail("call_static: element kinds have no static methods");
    return svl::call_static(kind, method, args, n, out);
  } catch (const std::exception &x) {
    out_error(out, "c++", x.what());
    return fail(std::string("call_static: C++ exception: ") + x.what());
  } catch (...) {
    out_error(out, "c++", "unknown C++ exception");
    return fail("call_static: unknown C++ exception");
  }
}

// v3 members (caps, describe, describe_type, cancel) follow `last_error`; v2.1/v2.2 members follow those.
const svl_backend kBackend = {SVL_ABI_VERSION, &g, b_resolve, b_create, b_insert, b_remove, b_destroy,
                              b_set_prop, b_get_prop, b_call, b_listen, b_handle_info, b_run, b_wake, b_schedule_wake, b_quit,
                              b_last_error, SVL_CAP_UTF16_IN | SVL_CAP_UTF16_OUT, b_describe, b_describe_type, b_cancel, b_request_frame,
                              b_set_child_attr, b_get_child_attr, b_listen_ex, b_style,
                              /* ABI v2.5 (N2) */ b_construct, b_call_static,
                              /* ABI v2.6 */ b_observe,
                              /* ABI v2.7 */ b_start,
                              /* ABI v2.8 */ b_bounds};

}  // namespace

extern "C" const svl_backend *svl_qt_backend(void) { return &kBackend; }

// Test and tooling support: not part of the backend ABI.
extern "C" void svl_qt_set_host(const svl_host *host) { g.host = host; }
extern "C" void *svl_qt_debug_object(svl_handle h) {
  Entry *e = find(h);
  return e ? static_cast<void *>(e->obj.data()) : nullptr;
}
// The metaobject id of a Q_PROPERTY by its native name (what `resolve` gives NT2 type kinds for an unbound name):
// lets the generated observe tests reach QWidget properties no element exposes (`font`, `visible`, `width`).
extern "C" svl_id svl_qt_meta_prop_id(const char *native) { return svl::dyn_id(native); }
// How many observations and event filters the backend holds (teardown checks of the observe tests).
extern "C" size_t svl_qt_observations(size_t *filters) {
  if (filters) *filters = g.obs_filters.size();
  return g.observers.size();
}

// ---- tooling hooks (tests and the counter example; not part of the backend ABI) -----------------

namespace {

QObject *debug_obj(svl_handle h) {
  Entry *e = find(h);
  return e ? e->obj.data() : nullptr;
}

void json_str(std::string &out, const QString &s) {
  out += '"';
  for (const QChar c : s) {
    ushort u = c.unicode();
    if (u == '"' || u == '\\') {
      out += '\\';
      out += static_cast<char>(u);
    } else if (u < 0x20) {
      char b[8];
      std::snprintf(b, sizeof b, "\\u%04x", u);
      out += b;
    } else {
      out += QString(c).toUtf8().constData();
    }
  }
  out += '"';
}

void dump_widget(QWidget *w, int depth, std::string &out);

void dump_layout(QLayout *l, int depth, std::string &out) {
  for (int i = 0; i < l->count(); ++i) {
    QLayoutItem *it = l->itemAt(i);
    if (QWidget *cw = it->widget()) dump_widget(cw, depth, out);
    else if (QLayout *cl = it->layout()) dump_layout(cl, depth, out);
  }
}

void dump_widget(QWidget *w, int depth, std::string &out) {
  QString text;
  if (auto *l = qobject_cast<QLabel *>(w)) text = l->text();
  else if (auto *b = qobject_cast<QAbstractButton *>(w)) text = b->text();
  else if (auto *e = qobject_cast<QLineEdit *>(w)) text = e->text();
  else if (w->isWindow()) text = w->windowTitle();
  if (!out.empty()) out += ',';
  out += "{\"d\":" + std::to_string(depth) + ",\"class\":";
  json_str(out, QString::fromLatin1(w->metaObject()->className()));
  out += ",\"text\":";
  json_str(out, text);
  if (w->isWindow()) {
    out += std::string(",\"modal\":") + (w->isModal() ? "true" : "false") + ",\"transient\":" + (w->parentWidget() ? "true" : "false") +
           ",\"visible\":" + (w->isVisible() ? "true" : "false");
  }
  out += '}';
  if (auto *mw = qobject_cast<QMainWindow *>(w)) {
    if (mw->centralWidget()) dump_widget(mw->centralWidget(), depth + 1, out);
  } else if (auto *sa = qobject_cast<QScrollArea *>(w)) {
    if (sa->widget()) dump_widget(sa->widget(), depth + 1, out);
  } else if (w->layout()) {
    dump_layout(w->layout(), depth + 1, out);
  } else {
    for (QObject *c : w->children())
      if (auto *cw = qobject_cast<QWidget *>(c); cw && !cw->isWindow()) dump_widget(cw, depth + 1, out);
  }
}

std::string dump_buf;

}  // namespace

// Makes the next `call` throw a C++ exception (tests the exception-to-ERROR boundary).
extern "C" void svl_qt_test_throw_next(void) { g_test_throw = true; }

// Reads a Q_PROPERTY of the object behind `h` (or of its layout) as text, for tests that check what the
// toolkit really holds. Valid until the next call. Empty when the object or property does not exist.
// Test hook (FU3): a native change, made by the toolkit and not through `set_prop`: `QObject::setProperty` of the
// Qt property for the JS (kebab-case) name, so the backend's own-set echo suppression does not apply. 0 on
// success, -1 for an unknown handle or a property Qt refuses.
extern "C" int svl_qt_native_set(svl_handle h, const char *name, const svl_value *v) {
  QObject *o = debug_obj(h);
  if (!o || !name || !v) return -1;
  return o->setProperty(camel_of(name).c_str(), to_variant(v)) ? 0 : -1;
}

extern "C" const char *svl_qt_native_prop(svl_handle h, const char *name, int on_layout) {
  static std::string buf;
  buf.clear();
  QObject *o = debug_obj(h);
  if (o && on_layout) o = qobject_cast<QWidget *>(o) ? qobject_cast<QWidget *>(o)->layout() : nullptr;
  if (!o) return buf.c_str();
  QVariant v = o->property(name);
  if (!v.isValid()) return buf.c_str();
  QString text;
  QDebug(&text).nospace() << v;
  buf = text.toStdString();
  return buf.c_str();
}

// The widget tree below `h` in layout order as a JSON array of {d, class, text}. Valid until the next call.
extern "C" const char *svl_qt_dump(svl_handle h) {
  std::string body;
  if (auto *w = qobject_cast<QWidget *>(debug_obj(h))) dump_widget(w, 0, body);
  dump_buf = "[" + body + "]";
  return dump_buf.c_str();
}

// Grab the widget behind `h` into a PNG; a null `path` only renders it.
extern "C" int svl_qt_grab_png(svl_handle h, const char *path) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1;
  QPixmap px = w->grab();
  if (!path) return px.isNull() ? -1 : 0;
  return px.save(QString::fromUtf8(path)) ? 0 : -1;
}

// Styling read-back for tests (X6): a rendered pixel (0xRRGGBB, -1 if out of range or not a widget), the
// widget's foreground / background palette colour after QSS, the application stylesheet.
extern "C" int svl_qt_pixel(svl_handle h, int x, int y) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1;
  QImage img = w->grab().toImage();
  if (x < 0 || y < 0 || x >= img.width() || y >= img.height()) return -1;
  return static_cast<int>(img.pixelColor(x, y).rgb() & 0xFFFFFF);
}

extern "C" int svl_qt_palette_color(svl_handle h, int background) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1;
  return static_cast<int>(w->palette().color(background ? w->backgroundRole() : w->foregroundRole()).rgb() & 0xFFFFFF);
}

extern "C" const char *svl_qt_app_stylesheet(void) {
  static std::string buf;
  buf = qApp->styleSheet().toStdString();
  return buf.c_str();
}

extern "C" double svl_qt_opacity(svl_handle h) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1.0;
  auto *fx = qobject_cast<QGraphicsOpacityEffect *>(w->graphicsEffect());
  return fx ? fx->opacity() : 1.0;
}

// TR1 (tests): the visual channels of `h`: tx, ty, sx, sy (identity without a transform), the
// maximum width and height, and 1 when inert (mouse-transparent).
extern "C" int svl_qt_visual(svl_handle h, double *out) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1;
  auto *fx = dynamic_cast<SvlVisualEffect *>(w->graphicsEffect());
  const bool tf = fx && fx->tf;
  out[0] = tf ? fx->tx : 0;
  out[1] = tf ? fx->ty : 0;
  out[2] = tf ? fx->sx : 1;
  out[3] = tf ? fx->sy : 1;
  out[4] = w->maximumWidth();
  out[5] = w->maximumHeight();
  out[6] = w->testAttribute(Qt::WA_TransparentForMouseEvents) ? 1 : 0;
  return 0;
}

// Triggers every QAction of the widget behind `h` (a menu's items), as a click on each would.
extern "C" int svl_qt_trigger_actions(svl_handle h) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1;
  const auto actions = w->actions();
  for (QAction *a : actions) a->trigger();
  return static_cast<int>(actions.size());
}

// Type `utf8` into the QLineEdit behind `h` through key events, replacing its content.
// Test hook: a mouse event for the widget behind `h`. kind: 0 press, 1 release, 2 move, 3 wheel (dy in `button`).
// Returns whether the widget (or an event filter) accepted it, or -1 for an unknown handle.
extern "C" int svl_qt_send_mouse(svl_handle h, int kind, double x, double y, int button) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1;
  const QPointF pos(x, y);
  const QPointF global = w->mapToGlobal(pos);
  if (kind == 3) {
    QWheelEvent ev(pos, global, QPoint(), QPoint(0, button), Qt::NoButton, Qt::NoModifier, Qt::NoScrollPhase, false);
    return QApplication::sendEvent(w, &ev) ? 1 : 0;
  }
  const QEvent::Type t = kind == 0 ? QEvent::MouseButtonPress : kind == 1 ? QEvent::MouseButtonRelease : QEvent::MouseMove;
  const Qt::MouseButton b = static_cast<Qt::MouseButton>(button);
  QMouseEvent ev(t, pos, global, b, kind == 1 ? Qt::NoButton : b, Qt::NoModifier);
  return QApplication::sendEvent(w, &ev) ? 1 : 0;
}

extern "C" int svl_qt_type_text(svl_handle h, const char *utf8) {
  auto *e = qobject_cast<QLineEdit *>(debug_obj(h));
  if (!e) return -1;
  const QString text = QString::fromUtf8(utf8);
  e->selectAll();
  if (text.isEmpty()) {
    QKeyEvent press(QEvent::KeyPress, Qt::Key_Backspace, Qt::NoModifier);
    QApplication::sendEvent(e, &press);
    return 0;
  }
  for (const QChar c : text) {
    QKeyEvent press(QEvent::KeyPress, 0, Qt::NoModifier, QString(c));
    QApplication::sendEvent(e, &press);
    QKeyEvent release(QEvent::KeyRelease, 0, Qt::NoModifier, QString(c));
    QApplication::sendEvent(e, &release);
  }
  return 0;
}

// Row, column, row span and column span of the cell of the widget `child` in the QGridLayout of the
// widget `grid`; -1 when `child` is not in such a layout. For tests that check what the toolkit holds.
extern "C" int svl_qt_grid_cell(svl_handle grid, svl_handle child, int *row, int *col, int *row_span, int *col_span) {
  auto *p = qobject_cast<QWidget *>(debug_obj(grid));
  auto *c = qobject_cast<QWidget *>(debug_obj(child));
  auto *l = p ? qobject_cast<QGridLayout *>(p->layout()) : nullptr;
  if (!l || !c) return -1;
  int i = l->indexOf(c);
  if (i < 0) return -1;
  l->getItemPosition(i, row, col, row_span, col_span);
  return 0;
}

// Close the top-level widget behind `h` as if the user clicked its close button.
extern "C" int svl_qt_close(svl_handle h) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  return w && w->close() ? 0 : -1;
}

// ---- WG3 native-reference hooks (conformance/, plans/milestones/WG3-native-references.md) ----------
// What the capture observes that the ABI cannot read: a QLineEdit's selection anchor (selectionStart is
// not a property), and where a character sits, for XTEST clicks. Offsets cross as Unicode scalar values;
// Qt counts UTF-16 units.
namespace {
int na_u16_to_scalar(const QString &s, int u) {
  int n = 0;
  for (int i = 0; i < u && i < s.size(); ++i)
    if (!s.at(i).isLowSurrogate()) ++n;
  return n;
}
int na_scalar_to_u16(const QString &s, int n) {
  int i = 0;
  for (int k = 0; k < n && i < s.size(); ++k) i += (s.at(i).isHighSurrogate() && i + 1 < s.size()) ? 2 : 1;
  return i;
}
}  // namespace

// The observed state of the widget behind `h` as compact JSON: for a QLineEdit
// {"text","anchor","caret","u16caret","focus"} (offsets in scalars; u16caret is what `cursor-position`
// reports), otherwise {"focus"}. Focus: QWidget::hasFocus in an active window. Valid until the next call.
extern "C" const char *svl_qt_na_state(svl_handle h) {
  static std::string buf;
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return "";
  QJsonObject o;
  if (auto *e = qobject_cast<QLineEdit *>(w)) {
    const QString t = e->text();
    const int caret = e->cursorPosition();
    int anchor = caret;
    if (e->hasSelectedText()) anchor = caret == e->selectionStart() ? e->selectionEnd() : e->selectionStart();
    o.insert("text", t);
    o.insert("anchor", na_u16_to_scalar(t, anchor));
    o.insert("caret", na_u16_to_scalar(t, caret));
    o.insert("u16caret", caret);
  }
  o.insert("focus", w->hasFocus() && w->window()->isActiveWindow());
  buf = QJsonDocument(o).toJson(QJsonDocument::Compact).toStdString();
  return buf.c_str();
}

// A point in the coordinates of the widget's top-level window (its X window) to click at: inside the
// character at scalar `offset` of a QLineEdit, just left of its centre, so a single click puts the caret
// before it (the last x that QLineEdit::cursorPositionAt maps to `offset`); past the end for the text's
// length; the centre for `offset` < 0 or another widget. 0, or -1 for an unknown handle.
extern "C" int svl_qt_na_point(svl_handle h, int offset, double *x, double *y) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1;
  QPoint p(w->width() / 2, w->height() / 2);
  if (auto *e = qobject_cast<QLineEdit *>(w); e && offset >= 0) {
    const QString t = e->text();
    const int u = na_scalar_to_u16(t, offset);
    int best = -1, first = -1;
    for (int px = 0; px < e->width(); ++px) {
      if (e->cursorPositionAt(QPoint(px, p.y())) == u) {
        if (first < 0) first = px;
        best = px;
      }
    }
    if (best >= 0) p.setX(u >= t.size() ? first + 3 : best - 1);
  }
  const QPoint g = w->mapTo(w->window(), p);
  *x = g.x();
  *y = g.y();
  return 0;
}

// Capture setup: the selection of a QLineEdit in scalars ([anchor, caret]; the cursor ends at `caret`),
// and with `focus` the widget takes the keyboard focus programmatically (Qt::OtherFocusReason, which does
// not select all) in its activated window.
extern "C" int svl_qt_na_setup(svl_handle h, int focus, int anchor, int caret) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1;
  if (focus) {
    w->window()->activateWindow();
    w->setFocus(Qt::OtherFocusReason);
  }
  if (auto *e = qobject_cast<QLineEdit *>(w); e && anchor >= 0) {
    const QString t = e->text();
    const int a = na_scalar_to_u16(t, anchor), c = na_scalar_to_u16(t, caret);
    if (a == c) e->setCursorPosition(c);
    else e->setSelection(a, c - a);
  }
  return 0;
}

// The style hints that decide the captured behaviour, as compact JSON.
extern "C" const char *svl_qt_na_settings(void) {
  static std::string buf;
  ensure_app();
  const QStyleHints *s = QGuiApplication::styleHints();
  QJsonObject o;
  o.insert("mouseDoubleClickInterval", s->mouseDoubleClickInterval());
  o.insert("mouseDoubleClickDistance", s->mouseDoubleClickDistance());
  o.insert("startDragDistance", s->startDragDistance());
  o.insert("platform", QGuiApplication::platformName());
  o.insert("qtVersion", QString::fromLatin1(qVersion()));
  o.insert("style", QApplication::style() ? QApplication::style()->name() : QString());
  buf = QJsonDocument(o).toJson(QJsonDocument::Compact).toStdString();
  return buf.c_str();
}

// Number of top-level widgets that still exist (pending deleteLater included until the loop runs).
extern "C" int svl_qt_toplevel_count(void) { return QApplication::topLevelWidgets().size(); }

// ---- virtual-list test hooks (M5; not part of the backend ABI) --------------------------------------
// The tests find widgets by what they show, not by handle: the Svelte app decides creation order.
namespace {
SvVirtualList *vl_find() {
  for (QWidget *w : QApplication::allWidgets())
    if (auto *v = dynamic_cast<SvVirtualList *>(w)) return v;
  return nullptr;
}
std::string g_vl_str;
std::string g_vl_changes;
}  // namespace

// Clicks the QPushButton whose text is `label`. 0 when found.
extern "C" int svl_qt_click_button(const char *label) {
  for (QWidget *w : QApplication::allWidgets())
    if (auto *b = qobject_cast<QPushButton *>(w); b && b->text() == QString::fromUtf8(label)) {
      b->click();
      return 0;
    }
  return -1;
}

// Text of the first QLabel whose text starts with `prefix`, or "".
extern "C" const char *svl_qt_label_starting(const char *prefix) {
  g_vl_str.clear();
  for (QWidget *w : QApplication::allWidgets())
    if (auto *l = qobject_cast<QLabel *>(w); l && l->text().startsWith(QString::fromUtf8(prefix))) {
      g_vl_str = l->text().toStdString();
      break;
    }
  return g_vl_str.c_str();
}

// ---- menu test hooks (X4; not part of the backend ABI) ---------------------------------------------

// Declared by QtTest's qtestkeyboard.h, exported by QtGui: runs the shortcut map for a key press.
Q_GUI_EXPORT bool qt_sendShortcutOverrideEvent(QObject *o, ulong timestamp, int k, Qt::KeyboardModifiers mods, const QString &text, bool autorep, ushort count);

// The lowest handle of a QAction (not a separator) or QMenu whose text or title is `label`, or 0.
extern "C" svl_handle svl_qt_find_item(const char *label) {
  svl_handle best = 0;
  const QString l = QString::fromUtf8(label);
  for (auto &kv : g.table) {
    QObject *o = kv.second.obj.data();
    bool hit = false;
    if (auto *a = qobject_cast<QAction *>(o)) hit = !a->isSeparator() && a->text() == l;
    else if (auto *m = qobject_cast<QMenu *>(o)) hit = m->title() == l;
    if (hit && (!best || kv.first < best)) best = kv.first;
  }
  return best;
}

// The handle of the push button with this text, or 0.
extern "C" svl_handle svl_qt_find_button(const char *label) {
  for (QWidget *w : QApplication::allWidgets())
    if (auto *b = qobject_cast<QPushButton *>(w); b && b->text().trimmed() == QString::fromUtf8(label))
      if (auto it = g.by_obj.find(b); it != g.by_obj.end()) return it->second;
  return 0;
}

extern "C" int svl_qt_trigger_item(svl_handle h) {
  QAction *a = menu_item_action(debug_obj(h));
  if (!a) return -1;
  a->trigger();
  return 0;
}

extern "C" int svl_qt_item_checked(svl_handle h) {
  QAction *a = menu_item_action(debug_obj(h));
  return a ? (a->isChecked() ? 1 : 0) : -1;
}

static void menu_dump_into(QWidget *w, std::string &out) {
  for (QAction *a : w->actions()) {
    if (a->isSeparator()) {
      out += "-,";
    } else if (QMenu *m = a->menu()) {
      out += m->title().toStdString() + "[";
      menu_dump_into(m, out);
      out += "],";
    } else {
      out += a->text().toStdString() + (a->isChecked() ? "*" : "") + ",";
    }
  }
}

// The items of the menu, menu bar or tool bar behind `h`: `Open,Autosave*,-,Recent[a,b,],` (`-` separator, `*` checked).
extern "C" const char *svl_qt_menu_dump(svl_handle h) {
  g_vl_str.clear();
  if (auto *w = qobject_cast<QWidget *>(debug_obj(h))) menu_dump_into(w, g_vl_str);
  return g_vl_str.c_str();
}

// Presses a key sequence like `Ctrl+O` in the window behind `h` through the shortcut map; 1 when a shortcut ran.
extern "C" int svl_qt_shortcut(svl_handle h, const char *seq) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  const QKeySequence ks(QString::fromUtf8(seq));
  if (!w || ks.isEmpty()) return -1;
  QApplication::setActiveWindow(w->window());  // no window manager under xvfb: nothing else activates it
  const QKeyCombination kc = ks[0];
  return qt_sendShortcutOverrideEvent(w->window()->windowHandle(), 0, kc.key(), kc.keyboardModifiers(), QString(), false, 1) ? 1 : 0;
}

// Sends the widget behind `h` a real context-menu request (what a right click delivers).
extern "C" int svl_qt_context_request(svl_handle h) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1;
  QContextMenuEvent ev(QContextMenuEvent::Mouse, QPoint(3, 4), w->mapToGlobal(QPoint(3, 4)));
  QApplication::sendEvent(w, &ev);
  return 0;
}

// QMenus that are open (visible popups).
extern "C" int svl_qt_open_menus(void) {
  int n = 0;
  for (QWidget *w : QApplication::allWidgets())
    if (qobject_cast<QMenu *>(w) && w->isVisible()) ++n;
  return n;
}

extern "C" void svl_qt_close_menus(void) {
  for (QWidget *w : QApplication::allWidgets())
    if (qobject_cast<QMenu *>(w) && w->isVisible()) w->hide();
}

// One line per visible row widget: the texts of its labels joined by a space.
// The shown rows of every virtual list (N3 tests show several), one line per row.
extern "C" const char *svl_qt_vlist_rows(void) {
  g_vl_str.clear();
  for (QWidget *top : QApplication::allWidgets()) {
    auto *v = dynamic_cast<SvVirtualList *>(top);
    if (!v) continue;
    for (QObject *c : v->viewport()->children()) {
      auto *w = qobject_cast<QWidget *>(c);
      if (!w || !w->isVisibleTo(v->viewport())) continue;
      QStringList parts;
      for (QLabel *l : w->findChildren<QLabel *>()) parts << l->text();
      g_vl_str += parts.join(' ').toStdString() + "\n";
    }
  }
  return g_vl_str.c_str();
}

extern "C" long svl_qt_vlist_count(void) {
  SvVirtualList *v = vl_find();
  return v ? v->cur()->rowCount() : -1;
}

extern "C" int svl_qt_vlist_pool(void) {
  SvVirtualList *v = vl_find();
  return v ? static_cast<int>(v->pool.size()) : -1;
}

extern "C" int svl_qt_vlist_present(void) { return vl_find() != nullptr; }

// Starts recording the change notifications of the model the list shows (its id model, or the app's
// model in model mode): "I first count;", "R first count;", "C first count;", "M first count dest;",
// "reset;", "layout;". A later call moves the recording to the model shown then.
extern "C" void svl_qt_vlist_watch(void) {
  static std::vector<QMetaObject::Connection> conns;
  for (auto &c : conns) QObject::disconnect(c);
  conns.clear();
  SvVirtualList *v = vl_find();
  if (!v) return;
  QAbstractItemModel *m = v->cur();
  conns.push_back(QObject::connect(m, &QAbstractItemModel::rowsInserted, v, [](const QModelIndex &, int a, int b) {
    g_vl_changes += "I " + std::to_string(a) + " " + std::to_string(b - a + 1) + ";";
  }));
  conns.push_back(QObject::connect(m, &QAbstractItemModel::rowsRemoved, v, [](const QModelIndex &, int a, int b) {
    g_vl_changes += "R " + std::to_string(a) + " " + std::to_string(b - a + 1) + ";";
  }));
  conns.push_back(QObject::connect(m, &QAbstractItemModel::rowsMoved, v,
                                   [](const QModelIndex &, int a, int b, const QModelIndex &, int d) {
                                     g_vl_changes += "M " + std::to_string(a) + " " + std::to_string(b - a + 1) + " " + std::to_string(d) + ";";
                                   }));
  conns.push_back(QObject::connect(m, &QAbstractItemModel::dataChanged, v, [](const QModelIndex &a, const QModelIndex &b) {
    g_vl_changes += "C " + std::to_string(a.row()) + " " + std::to_string(b.row() - a.row() + 1) + ";";
  }));
  conns.push_back(QObject::connect(m, &QAbstractItemModel::modelReset, v, [] { g_vl_changes += "reset;"; }));
  conns.push_back(QObject::connect(m, &QAbstractItemModel::layoutChanged, v, [] { g_vl_changes += "layout;"; }));
}

extern "C" const char *svl_qt_vlist_changes(int clear) {
  g_vl_str = g_vl_changes;
  if (clear) g_vl_changes.clear();
  return g_vl_str.c_str();
}

// The user selects / activates an item (as a click or Enter would).
extern "C" int svl_qt_vlist_select(int pos) {
  SvVirtualList *v = vl_find();
  if (!v || pos < 0 || pos >= v->cur()->rowCount()) return -1;
  v->setCurrentIndex(v->cur()->index(pos, 0));
  return 0;
}

extern "C" int svl_qt_vlist_activate(int pos) {
  SvVirtualList *v = vl_find();
  if (!v || pos < 0 || pos >= v->cur()->rowCount()) return -1;
  emit v->activated(v->cur()->index(pos, 0));
  return 0;
}

// Handles in the table (owned, toplevel and borrowed): the leak check of the tests.
extern "C" size_t svl_qt_live_handles(void) { return g.table.size(); }

// Runs the Qt loop for `ms` milliseconds, deferred deletes included (tests that drive the backend directly).
extern "C" void svl_qt_pump(int ms) {
  ensure_app();
  const auto until = std::chrono::steady_clock::now() + std::chrono::milliseconds(ms);
  do {
    QCoreApplication::sendPostedEvents(nullptr, QEvent::DeferredDelete);
    QCoreApplication::processEvents(QEventLoop::AllEvents, 5);
  } while (std::chrono::steady_clock::now() < until);
  QCoreApplication::sendPostedEvents(nullptr, QEvent::DeferredDelete);
}

// The QTextEdits of the app (N2 host tests): "<count>|<1 when they all show one document>|<its plain text>".
// With `set_text`, the first editor's document is changed natively first (as typing would).
extern "C" const char *svl_qt_text_edits(const char *set_text) {
  static std::string buf;
  std::vector<QTextEdit *> eds;
  for (QWidget *w : QApplication::allWidgets())
    if (auto *e = qobject_cast<QTextEdit *>(w)) eds.push_back(e);
  if (set_text && !eds.empty()) eds.front()->document()->setPlainText(QString::fromUtf8(set_text));
  bool shared = !eds.empty();
  for (QTextEdit *e : eds) shared = shared && e->document() == eds.front()->document();
  buf = std::to_string(eds.size()) + "|" + (shared ? "1" : "0") + "|" + (eds.empty() ? std::string() : eds.front()->toPlainText().toStdString());
  return buf.c_str();
}

// Whether the push button with this text has a non-null icon (-1: no such button).
extern "C" int svl_qt_button_icon(const char *label) {
  for (QWidget *w : QApplication::allWidgets())
    if (auto *b = qobject_cast<QPushButton *>(w); b && b->text() == QString::fromUtf8(label)) return b->icon().isNull() ? 0 : 1;
  return -1;
}

// QObject children of the object behind `h` (-1 for an unknown handle): ownership checks of the tests.
extern "C" int svl_qt_child_count(svl_handle h) {
  QObject *o = debug_obj(h);
  return o ? static_cast<int>(o->children().size()) : -1;
}

// The QFuture adapter (svl::async_from_future) on a promise this hook fulfils after `ms` milliseconds
// with `value`, or cancels when `value` < 0: no bound Qt API returns a QFuture yet (N2), so the tests drive it.
extern "C" void svl_qt_test_future(uint64_t callback, int ms, int value) {
  ensure_app();
  auto promise = std::make_shared<QPromise<int>>();
  promise->start();
  svl::async_from_future(promise->future(), callback);
  QTimer::singleShot(ms, g.waker.load(), [promise, value] {
    if (value < 0) {
      promise->future().cancel();
    } else {
      promise->addResult(value);
    }
    promise->finish();
  });
}

// Non-GUI type accounting (N2): VALUE handles, unique objects and items JS holds, and live tracked items.
extern "C" void svl_qt_type_counts(size_t *values, size_t *ptrs, size_t *tracked) {
  *values = g.boxed.size();
  *ptrs = svl::g_ptrs.size();
  *tracked = svl::g_tracked.size();
}

// Run `cb(ud)` on the Qt loop thread after `ms` milliseconds. Creates the QApplication if needed.
extern "C" void svl_qt_run_later(void (*cb)(void *), void *ud, int ms) {
  ensure_app();
  QTimer::singleShot(ms, g.waker.load(), [cb, ud] { cb(ud); });
}

// Frames delivered by a window's UpdateRequest so far (the others came from the fallback timer).
extern "C" unsigned svl_qt_frames_by_update() { return g.frames_by_update; }

extern "C" void svl_qt_set_timing(int on) { g_timing.on = on != 0; }

// Nanoseconds and call count spent inside backend calls since the last take; resets both.
extern "C" void svl_qt_take_timing(uint64_t *ns, uint64_t *calls) {
  *ns = g_timing.ns;
  *calls = g_timing.calls;
  g_timing.ns = 0;
  g_timing.calls = 0;
}

namespace {
// Reports the first QEvent::Paint delivered to any widget.
struct PaintOnce : QObject {
  void (*cb)(void *) = nullptr;
  void *ud = nullptr;
  bool eventFilter(QObject *, QEvent *e) override {
    if (cb && e->type() == QEvent::Paint) {
      auto f = cb;
      cb = nullptr;
      f(ud);
    }
    return false;
  }
};
}  // namespace

// Calls `cb(ud)` when the first widget paints. Creates the QApplication if needed.
extern "C" void svl_qt_on_first_paint(void (*cb)(void *), void *ud) {
  ensure_app();
  auto *p = new PaintOnce;
  p->cb = cb;
  p->ud = ud;
  QCoreApplication::instance()->installEventFilter(p);
}
