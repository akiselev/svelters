bool to_qstring(const svl_value *v, QString &out) {
  if (v->tag == SVL_NULL) {
    out.clear();
    return true;
  }
  if (v->tag != SVL_STR) return false;
  out = QString::fromUtf8(v->u.s.ptr, static_cast<qsizetype>(v->u.s.len));
  return true;
}
[[maybe_unused]] bool to_bool(const svl_value *v, bool &out) {
  if (v->tag == SVL_BOOL) { out = v->u.b; return true; }
  if (v->tag == SVL_I64) { out = v->u.i != 0; return true; }
  return false;
}
bool to_i64(const svl_value *v, qint64 &out) {
  if (v->tag == SVL_I64) { out = v->u.i; return true; }
  if (v->tag == SVL_F64) { out = static_cast<qint64>(v->u.f); return true; }
  return false;
}
bool to_i32(const svl_value *v, int &out) {
  qint64 x;
  if (!to_i64(v, x)) return false;
  out = static_cast<int>(x);
  return true;
}
[[maybe_unused]] bool to_f64(const svl_value *v, double &out) {
  if (v->tag == SVL_F64) { out = v->u.f; return true; }
  if (v->tag == SVL_I64) { out = static_cast<double>(v->u.i); return true; }
  return false;
}
[[maybe_unused]] QVariant to_variant(const svl_value *v) {
  switch (v->tag) {
    case SVL_BOOL: return QVariant(v->u.b);
    case SVL_I64: return QVariant(static_cast<qlonglong>(v->u.i));
    case SVL_F64: return QVariant(v->u.f);
    case SVL_STR: return QVariant(QString::fromUtf8(v->u.s.ptr, static_cast<qsizetype>(v->u.s.len)));
    default: return QVariant();
  }
}
void out_null(svl_value *out) {
  if (out) { out->tag = SVL_NULL; out->u.i = 0; }
}
void out_bool(svl_value *out, bool b) {
  if (out) { out->tag = SVL_BOOL; out->u.b = b; }
}
void out_i64(svl_value *out, qint64 i) {
  if (out) { out->tag = SVL_I64; out->u.i = i; }
}
void out_f64(svl_value *out, double f) {
