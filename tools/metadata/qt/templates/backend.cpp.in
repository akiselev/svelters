svl_id b_resolve(void *, uint32_t what, svl_id kind, const char *name, size_t len) {
  std::string_view n(name, len);
  if (what == SVL_KIND && n == "virtuallist") return kVListKind;
  if (kind == kVListKind) return vl_resolve(what, n);
  Table t = table_for(what, kind);
  for (size_t i = 0; i < t.n; ++i)
    if (t.items[i].name == n) return t.items[i].id;
  // Object getters (parentWidget, viewport, lineEdit, ...) apply to any kind, annotated or not.
  if (what == SVL_METHOD)
    for (size_t i = 0; i < kGetterCount; ++i)
      if (kGetterNames[i] == n) return kGetterBase + static_cast<svl_id>(i);
  return 0;
}

svl_handle b_create(void *, svl_id kind) {
  TimeScope timing_;
  ensure_app();
  QObject *o = kind == kVListKind ? vl_create() : gen_create(kind);
  if (!o) {
    fail("create: unknown kind id " + std::to_string(kind));
    return 0;
  }
  svl_handle h = g.next++;
  Entry e;
  e.obj = o;
  e.kind = kind;
  g.by_obj[o] = h;
  if (kind == kVListKind) vl_after_create(o, h);
  e.destroyed = QObject::connect(o, &QObject::destroyed, [h](QObject *obj) { native_destroyed(h, obj); });
  if (auto *w = qobject_cast<QWidget *>(o); w && gen_is_toplevel(kind)) {
    e.toplevel = true;
    e.life = SVL_LIFE_TOPLEVEL;
    static CloseFilter *filter = new CloseFilter;
    w->installEventFilter(filter);
  }
  g.table.emplace(h, std::move(e));
  return h;
}

int b_insert(void *, svl_handle parent, svl_handle child, svl_handle before, svl_id slot) {
  TimeScope timing_;
  Entry *p = find(parent);
  if (!p) return fail("insert: stale or unknown parent handle");
  Entry *c = find(child);
  if (!c) return fail("insert: stale or unknown child handle");
  if (p->life == SVL_LIFE_BORROWED || c->life == SVL_LIFE_BORROWED)
    return fail("insert: a borrowed native object cannot be inserted or removed through the tree");
  QObject *b = nullptr;
  if (before) {
    Entry *be = find(before);
    if (!be) return fail("insert: stale or unknown `before` handle");
    b = be->obj.data();
  }
  return gen_insert(*p, c->obj.data(), b, slot);
}

int b_remove(void *, svl_handle parent, svl_handle child) {
  TimeScope timing_;
  Entry *p = find(parent);
  if (!p) return fail("remove: stale or unknown parent handle");
  Entry *c = find(child);
  if (!c) return fail("remove: stale or unknown child handle");
  if (p->life == SVL_LIFE_BORROWED || c->life == SVL_LIFE_BORROWED)
    return fail("remove: a borrowed native object cannot be inserted or removed through the tree");
  return gen_remove(*p, c->obj.data());
}

void b_destroy(void *, svl_handle h) {
  TimeScope timing_;
  if (g.boxed.erase(h)) return;  // a boxed value: drop the held copy (idempotent)
  auto it = g.table.find(h);
  if (it == g.table.end()) return;
  QObject *o = it->second.obj.data();
  const bool toplevel = it->second.toplevel;
  const bool borrowed = it->second.life == SVL_LIFE_BORROWED;
  QObject::disconnect(it->second.destroyed);
  if (o) g.by_obj.erase(o);
  g.table.erase(it);
  drop_listeners(h);
  // A borrowed object belongs to its native owner: forget it, never delete it.
  if (borrowed) return;
  // Not a candidate for a new borrowed handle while the deferred delete is pending.
  if (o) o->setProperty("_svl_dying", true);
  // Never delete synchronously: the caller may be inside one of this object's signals.
  if (o) {
    if (auto *w = qobject_cast<QWidget *>(o); w && toplevel) w->hide();
    o->deleteLater();
  }
}

int b_set_prop(void *, svl_handle h, svl_id prop, const svl_value *v) {
  TimeScope timing_;
  Entry *e = find(h);
  if (!e) return fail("set_prop: stale or unknown handle");
  if (!v) return fail("set_prop: null value");
  g_in.clear();
  try {
    if (e->kind == kVListKind) return vl_set_prop(*e, prop, v);
    return gen_set_prop(*e, prop, v);
  } catch (const std::exception &x) {
    return fail(std::string("set_prop: C++ exception: ") + x.what());
  } catch (...) {
    return fail("set_prop: unknown C++ exception");
  }
}

int b_get_prop(void *, svl_handle h, svl_id prop, svl_value *out) {
  TimeScope timing_;
  Entry *e = find(h);
  if (!e) return fail("get_prop: stale or unknown handle");
  g_out.clear();
  g_owner = e->obj.data();
  try {
    if (e->kind == kVListKind) return vl_get_prop(*e, prop, out);
    return gen_get_prop(*e, prop, out);
  } catch (const std::exception &x) {
    out_error(out, "c++", x.what());
    return fail(std::string("get_prop: C++ exception: ") + x.what());
  } catch (...) {
    out_error(out, "c++", "unknown C++ exception");
    return fail("get_prop: unknown C++ exception");
  }
}

int b_call(void *, svl_handle h, svl_id method, const svl_value *args, size_t n, svl_value *out) {
  TimeScope timing_;
  Entry *e = find(h);
  if (!e) return fail("call: stale or unknown handle");
  g_out.clear();
  g_in.clear();
  g_owner = e->obj.data();
  out_null(out);
  try {
    if (g_test_throw) {  // test hook: make the next call throw, to exercise the boundary
      g_test_throw = false;
      throw std::runtime_error("test exception");
    }
    if (e->kind == kVListKind) return vl_call(*e, method, args, n, out);
    if (method >= kGetterBase) {
      if (n != 0) return fail("call: object getters take no arguments");
      QObject *r = nullptr;
      int rc = gen_getter(*e, method, &r);
      if (rc != 0) return rc;
      g_owner = e->obj.data();
      Conv<QObject *>::out(r, out);
      return 0;
    }
    return gen_call(*e, method, args, n, out);
  } catch (const std::exception &x) {
    out_error(out, "c++", x.what());
    return fail(std::string("call: C++ exception: ") + x.what());
  } catch (...) {
    out_error(out, "c++", "unknown C++ exception");
    return fail("call: unknown C++ exception");
  }
}

const svl_member_desc *b_describe(void *, uint32_t what, svl_id kind, svl_id member) {
  return gen_describe(what, kind, member);
}

const svl_type_desc *b_describe_type(void *, svl_id type) { return type_desc_for(type); }

int b_listen(void *, svl_handle h, svl_id sig, bool on) {
  TimeScope timing_;
  Entry *e = find(h);
  if (!e) return fail("listen: stale or unknown handle");
  if (e->kind == kVListKind) return vl_listen(*e, sig, on);
  return gen_listen(h, *e, sig, on);
}

int b_handle_info(void *, svl_handle h, svl_handle_info *out) {
  Entry *e = find(h);
  if (!e) return fail("handle_info: stale or unknown handle");
  out->kind = e->kind;
  out->lifetime = e->life;
  out->flags = 0;
  return 0;
}

// One single-shot timer, re-armed by every call. Short timeouts use a precise timer, longer ones
// a coarse timer so the toolkit can coalesce wakeups.
void b_schedule_wake(void *, int64_t ms) {
  ensure_app();
  if (!g.wake_timer) {
    g.wake_timer = new QTimer(g.waker.load());
    g.wake_timer->setSingleShot(true);
    QObject::connect(g.wake_timer, &QTimer::timeout, g.wake_timer, [] { run_checkpoint(); });
  }
  g.wake_timer->stop();
  if (ms < 0) return;
  g.wake_timer->setTimerType(ms < 20 ? Qt::PreciseTimer : Qt::CoarseTimer);
  g.wake_timer->start(static_cast<int>(ms > INT32_MAX ? INT32_MAX : ms));
}

int b_run(void *, const svl_host *host) {
  g.host = host;
  ensure_app();
  // Like GTK's `activate`: one checkpoint when the loop starts, whether or not a wake was pending.
  if (g.wake_pending.exchange(false) || !g.queued.load()) {
    g.queued.store(true);
    QMetaObject::invokeMethod(g.waker.load(), [] { run_checkpoint(); }, Qt::QueuedConnection);
  }
  const int rc = QCoreApplication::exec();
  // The host vtable is only guaranteed while `run` is on the stack; late timers must not use it.
  g.host = nullptr;
  return rc;
}

void b_wake(void *) {
  QObject *w = g.waker.load();
  if (!w) {
    g.wake_pending.store(true);
    return;
  }
  g.queued.store(true);
  QMetaObject::invokeMethod(w, [] { run_checkpoint(); }, Qt::QueuedConnection);
}

void b_quit(void *) {
  QObject *w = g.waker.load();
  if (w)
    QMetaObject::invokeMethod(w, [] { QCoreApplication::quit(); }, Qt::QueuedConnection);
  else if (QCoreApplication::instance())
    QCoreApplication::quit();
}

const char *b_last_error(void *) { return g.err.c_str(); }

// One host->frame on the next frame: QWindow::requestUpdate() on a platform-backed toplevel, whose
// UpdateRequest event the frame filter turns into the callback. Without such a window a 16 ms
// timer stands in; with one, a 250 ms watchdog covers a window that stops updating (hidden).
void b_request_frame(void *) {
  ensure_app();
  if (g.frame_pending) return;
  g.frame_pending = true;
  if (!g.frame_timer) {
    g.frame_timer = new QTimer(g.waker.load());
    g.frame_timer->setSingleShot(true);
    QObject::connect(g.frame_timer, &QTimer::timeout, g.frame_timer, [] { deliver_frame(false); });
  }
  int delay = 16;
  if (QWindow *win = frame_window()) {
    if (g.frame_win.data() != win) {
      if (!g.frame_filter) g.frame_filter = new FrameFilter;
      if (!g.frame_win.isNull()) g.frame_win->removeEventFilter(g.frame_filter);
      win->installEventFilter(g.frame_filter);
      g.frame_win = win;
    }
    win->requestUpdate();
    delay = 250;
  }
  g.frame_timer->setTimerType(delay < 20 ? Qt::PreciseTimer : Qt::CoarseTimer);
  g.frame_timer->start(delay);
}

// v3 members (caps, describe, describe_type, cancel) follow `last_error`.
const svl_backend kBackend = {SVL_ABI_VERSION, &g, b_resolve, b_create, b_insert, b_remove, b_destroy,
                              b_set_prop, b_get_prop, b_call, b_listen, b_handle_info, b_run, b_wake, b_schedule_wake, b_quit,
                              b_last_error, SVL_CAP_UTF16_IN, b_describe, b_describe_type, nullptr, b_request_frame};

}  // namespace

extern "C" const svl_backend *svl_qt_backend(void) { return &kBackend; }

// Test and tooling support: not part of the backend ABI.
extern "C" void svl_qt_set_host(const svl_host *host) { g.host = host; }
extern "C" void *svl_qt_debug_object(svl_handle h) {
  Entry *e = find(h);
  return e ? static_cast<void *>(e->obj.data()) : nullptr;
}

// ---- tooling hooks (tests and the counter example; not part of the backend ABI) -----------------

namespace {

QObject *debug_obj(svl_handle h) {
  Entry *e = find(h);
  return e ? e->obj.data() : nullptr;
}

void json_str(std::string &out, const QString &s) {
  out += '"';
  for (const QChar c : s) {
    ushort u = c.unicode();
    if (u == '"' || u == '\\') {
      out += '\\';
      out += static_cast<char>(u);
    } else if (u < 0x20) {
      char b[8];
      std::snprintf(b, sizeof b, "\\u%04x", u);
      out += b;
    } else {
      out += QString(c).toUtf8().constData();
    }
  }
  out += '"';
}

void dump_widget(QWidget *w, int depth, std::string &out);

void dump_layout(QLayout *l, int depth, std::string &out) {
  for (int i = 0; i < l->count(); ++i) {
    QLayoutItem *it = l->itemAt(i);
    if (QWidget *cw = it->widget()) dump_widget(cw, depth, out);
    else if (QLayout *cl = it->layout()) dump_layout(cl, depth, out);
  }
}

void dump_widget(QWidget *w, int depth, std::string &out) {
  QString text;
  if (auto *l = qobject_cast<QLabel *>(w)) text = l->text();
  else if (auto *b = qobject_cast<QAbstractButton *>(w)) text = b->text();
  else if (auto *e = qobject_cast<QLineEdit *>(w)) text = e->text();
  else if (w->isWindow()) text = w->windowTitle();
  if (!out.empty()) out += ',';
  out += "{\"d\":" + std::to_string(depth) + ",\"class\":";
  json_str(out, QString::fromLatin1(w->metaObject()->className()));
  out += ",\"text\":";
  json_str(out, text);
  out += '}';
  if (auto *mw = qobject_cast<QMainWindow *>(w)) {
    if (mw->centralWidget()) dump_widget(mw->centralWidget(), depth + 1, out);
  } else if (auto *sa = qobject_cast<QScrollArea *>(w)) {
    if (sa->widget()) dump_widget(sa->widget(), depth + 1, out);
  } else if (w->layout()) {
    dump_layout(w->layout(), depth + 1, out);
  } else {
    for (QObject *c : w->children())
      if (auto *cw = qobject_cast<QWidget *>(c)) dump_widget(cw, depth + 1, out);
  }
}

std::string dump_buf;

}  // namespace

// Makes the next `call` throw a C++ exception (tests the exception-to-ERROR boundary).
extern "C" void svl_qt_test_throw_next(void) { g_test_throw = true; }

// Reads a Q_PROPERTY of the object behind `h` (or of its layout) as text, for tests that check what the
// toolkit really holds. Valid until the next call. Empty when the object or property does not exist.
extern "C" const char *svl_qt_native_prop(svl_handle h, const char *name, int on_layout) {
  static std::string buf;
  buf.clear();
  QObject *o = debug_obj(h);
  if (o && on_layout) o = qobject_cast<QWidget *>(o) ? qobject_cast<QWidget *>(o)->layout() : nullptr;
  if (!o) return buf.c_str();
  QVariant v = o->property(name);
  if (!v.isValid()) return buf.c_str();
  QString text;
  QDebug(&text).nospace() << v;
  buf = text.toStdString();
  return buf.c_str();
}

// The widget tree below `h` in layout order as a JSON array of {d, class, text}. Valid until the next call.
extern "C" const char *svl_qt_dump(svl_handle h) {
  std::string body;
  if (auto *w = qobject_cast<QWidget *>(debug_obj(h))) dump_widget(w, 0, body);
  dump_buf = "[" + body + "]";
  return dump_buf.c_str();
}

// Grab the widget behind `h` into a PNG; a null `path` only renders it.
extern "C" int svl_qt_grab_png(svl_handle h, const char *path) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  if (!w) return -1;
  QPixmap px = w->grab();
  if (!path) return px.isNull() ? -1 : 0;
  return px.save(QString::fromUtf8(path)) ? 0 : -1;
}

// Type `utf8` into the QLineEdit behind `h` through key events, replacing its content.
extern "C" int svl_qt_type_text(svl_handle h, const char *utf8) {
  auto *e = qobject_cast<QLineEdit *>(debug_obj(h));
  if (!e) return -1;
  const QString text = QString::fromUtf8(utf8);
  e->selectAll();
  if (text.isEmpty()) {
    QKeyEvent press(QEvent::KeyPress, Qt::Key_Backspace, Qt::NoModifier);
    QApplication::sendEvent(e, &press);
    return 0;
  }
  for (const QChar c : text) {
    QKeyEvent press(QEvent::KeyPress, 0, Qt::NoModifier, QString(c));
    QApplication::sendEvent(e, &press);
    QKeyEvent release(QEvent::KeyRelease, 0, Qt::NoModifier, QString(c));
    QApplication::sendEvent(e, &release);
  }
  return 0;
}

// Close the top-level widget behind `h` as if the user clicked its close button.
extern "C" int svl_qt_close(svl_handle h) {
  auto *w = qobject_cast<QWidget *>(debug_obj(h));
  return w && w->close() ? 0 : -1;
}

// Number of top-level widgets that still exist (pending deleteLater included until the loop runs).
extern "C" int svl_qt_toplevel_count(void) { return QApplication::topLevelWidgets().size(); }

// ---- virtuallist test hooks (M5; not part of the backend ABI) --------------------------------------
// The tests find widgets by what they show, not by handle: the Svelte app decides creation order.
namespace {
SvVirtualList *vl_find() {
  for (QWidget *w : QApplication::allWidgets())
    if (auto *v = dynamic_cast<SvVirtualList *>(w)) return v;
  return nullptr;
}
std::string g_vl_str;
std::string g_vl_changes;
}  // namespace

// Clicks the QPushButton whose text is `label`. 0 when found.
extern "C" int svl_qt_click_button(const char *label) {
  for (QWidget *w : QApplication::allWidgets())
    if (auto *b = qobject_cast<QPushButton *>(w); b && b->text() == QString::fromUtf8(label)) {
      b->click();
      return 0;
    }
  return -1;
}

// Text of the first QLabel whose text starts with `prefix`, or "".
extern "C" const char *svl_qt_label_starting(const char *prefix) {
  g_vl_str.clear();
  for (QWidget *w : QApplication::allWidgets())
    if (auto *l = qobject_cast<QLabel *>(w); l && l->text().startsWith(QString::fromUtf8(prefix))) {
      g_vl_str = l->text().toStdString();
      break;
    }
  return g_vl_str.c_str();
}

// One line per visible row widget: the texts of its labels joined by a space.
extern "C" const char *svl_qt_vlist_rows(void) {
  g_vl_str.clear();
  SvVirtualList *v = vl_find();
  if (!v) return "";
  for (QObject *c : v->viewport()->children()) {
    auto *w = qobject_cast<QWidget *>(c);
    if (!w || !w->isVisibleTo(v->viewport())) continue;
    QStringList parts;
    for (QLabel *l : w->findChildren<QLabel *>()) parts << l->text();
    g_vl_str += parts.join(' ').toStdString() + "\n";
  }
  return g_vl_str.c_str();
}

extern "C" long svl_qt_vlist_count(void) {
  SvVirtualList *v = vl_find();
  return v ? v->mdl->rowCount() : -1;
}

extern "C" int svl_qt_vlist_pool(void) {
  SvVirtualList *v = vl_find();
  return v ? static_cast<int>(v->pool.size()) : -1;
}

extern "C" int svl_qt_vlist_present(void) { return vl_find() != nullptr; }

// Starts recording the model's change notifications ("I first count;", "R first count;", "C first count;").
extern "C" void svl_qt_vlist_watch(void) {
  SvVirtualList *v = vl_find();
  if (!v) return;
  QObject::connect(v->mdl, &QAbstractItemModel::rowsInserted, v, [](const QModelIndex &, int a, int b) {
    g_vl_changes += "I " + std::to_string(a) + " " + std::to_string(b - a + 1) + ";";
  });
  QObject::connect(v->mdl, &QAbstractItemModel::rowsRemoved, v, [](const QModelIndex &, int a, int b) {
    g_vl_changes += "R " + std::to_string(a) + " " + std::to_string(b - a + 1) + ";";
  });
  QObject::connect(v->mdl, &QAbstractItemModel::dataChanged, v, [](const QModelIndex &a, const QModelIndex &b) {
    g_vl_changes += "C " + std::to_string(a.row()) + " " + std::to_string(b.row() - a.row() + 1) + ";";
  });
  QObject::connect(v->mdl, &QAbstractItemModel::modelReset, v, [] { g_vl_changes += "reset;"; });
}

extern "C" const char *svl_qt_vlist_changes(int clear) {
  g_vl_str = g_vl_changes;
  if (clear) g_vl_changes.clear();
  return g_vl_str.c_str();
}

// The user selects / activates an item (as a click or Enter would).
extern "C" int svl_qt_vlist_select(int pos) {
  SvVirtualList *v = vl_find();
  if (!v || pos < 0 || pos >= v->mdl->rowCount()) return -1;
  v->setCurrentIndex(v->mdl->index(pos));
  return 0;
}

extern "C" int svl_qt_vlist_activate(int pos) {
  SvVirtualList *v = vl_find();
  if (!v || pos < 0 || pos >= v->mdl->rowCount()) return -1;
  emit v->activated(v->mdl->index(pos));
  return 0;
}

// Handles in the table (owned, toplevel and borrowed): the leak check of the tests.
extern "C" size_t svl_qt_live_handles(void) { return g.table.size(); }

// Run `cb(ud)` on the Qt loop thread after `ms` milliseconds. Creates the QApplication if needed.
extern "C" void svl_qt_run_later(void (*cb)(void *), void *ud, int ms) {
  ensure_app();
  QTimer::singleShot(ms, g.waker.load(), [cb, ud] { cb(ud); });
}

// Frames delivered by a window's UpdateRequest so far (the others came from the fallback timer).
extern "C" unsigned svl_qt_frames_by_update() { return g.frames_by_update; }

extern "C" void svl_qt_set_timing(int on) { g_timing.on = on != 0; }

// Nanoseconds and call count spent inside backend calls since the last take; resets both.
extern "C" void svl_qt_take_timing(uint64_t *ns, uint64_t *calls) {
  *ns = g_timing.ns;
  *calls = g_timing.calls;
  g_timing.ns = 0;
  g_timing.calls = 0;
}

namespace {
// Reports the first QEvent::Paint delivered to any widget.
struct PaintOnce : QObject {
  void (*cb)(void *) = nullptr;
  void *ud = nullptr;
  bool eventFilter(QObject *, QEvent *e) override {
    if (cb && e->type() == QEvent::Paint) {
      auto f = cb;
      cb = nullptr;
      f(ud);
    }
    return false;
  }
};
}  // namespace

// Calls `cb(ud)` when the first widget paints. Creates the QApplication if needed.
extern "C" void svl_qt_on_first_paint(void (*cb)(void *), void *ud) {
  ensure_app();
  auto *p = new PaintOnce;
  p->cb = cb;
  p->ud = ud;
  QCoreApplication::instance()->installEventFilter(p);
}
