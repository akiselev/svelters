}
void out_str(svl_value *out, const QString &s) {
  if (!out) return;
  QByteArray u = s.toUtf8();
  g.strbuf.assign(u.constData(), static_cast<size_t>(u.size()));
  out->tag = SVL_STR;
  out->u.s.ptr = g.strbuf.data();
  out->u.s.len = g.strbuf.size();
}
[[maybe_unused]] void out_variant(svl_value *out, const QVariant &v) {
