// (handle, signal, listen flags): one connection per phase of a signal.
using ListenKey = std::tuple<svl_handle, svl_id, uint32_t>;

// Event families of the synthetic signals (see "event families" below); bit `fam` of an Entry's masks.
enum EvFam { EV_KEY_RELEASE, EV_MOUSE_PRESS, EV_MOUSE_RELEASE, EV_MOUSE_MOVE, EV_DOUBLE_CLICK, EV_WHEEL, EV_FOCUS_IN,
             EV_FOCUS_OUT, EV_ENTER, EV_LEAVE, EV_RESIZE, EV_CONTEXT_MENU, EV_N };

struct Entry {
  QPointer<QObject> obj;
  svl_id kind = 0;
  QMetaObject::Connection destroyed;
  bool toplevel = false;      // a parentless widget: lifetime class TOPLEVEL
  uint32_t life = SVL_LIFE_OWNED;  // SVL_LIFE_*: BORROWED entries are native-made objects we never delete
  svl_handle owner = 0;       // BORROWED: the handle whose getter first returned the object
  bool close_listen = false;  // JS listens for close: the handler decides (call_sync)
  svl_id close_sig = 0;
  int suppress = 0;           // > 0 while JS writes an echo-suppressed property: posts are dropped
  bool key_listen = false;    // JS listens for key-press: the handler may consume the key
  svl_id key_sig = 0;
  bool key_capture = false;   // JS listens for key-press in the capture phase (descendants' keys)
  uint32_t ev_mask = 0;       // event families JS listens to (bit EvFam)
  svl_id ev_sig[EV_N] = {};
  uint32_t ev_cap_mask = 0;   // ... in the capture phase
  svl_id ev_cap_sig[EV_N] = {};
  svl_id key_capture_sig = 0; // the wire id of that listener (signal | flags << SVL_SIGNAL_FLAGS_SHIFT)
  svl_handle placed = 0;      // the parent this child is inserted into through the backend (0: none)
  svl_id slot = 0;            // ... and the slot it went through, which picks the child attributes
};

// Echo suppression for programmatic sets: our own connections drop their posts for this handle
// while the guard lives. Other observers of the widget still see the signal (never QSignalBlocker).
struct Suppress {
  Entry &e;
  explicit Suppress(Entry &x) : e(x) { ++e.suppress; }
  ~Suppress() { --e.suppress; }
};

// An async method in flight (see `async:` in the Qt overrides): the signal connection that completes it
// and the optional way to stop it.
struct AsyncOp {
  QPointer<QObject> obj;
  QMetaObject::Connection conn;
  std::function<void()> cancel;
};

// ABI v2.6: the native mechanisms of one observed (handle, prop) (see "property observation" below).
struct Observation {
  int count = 1;                                // observe calls nest per (handle, prop)
  std::vector<QObject *> relays;                // NOTIFY and signal relays; deleting one disconnects it
  std::unique_ptr<QPropertyNotifier> notifier;  // QBindable: QUntypedBindable::addNotifier
  std::vector<int> events;                      // QEvent types counted in the handle's event filter
  bool proportional = false;                    // value_cost proportional: our own set_prop is not reported
  Observation() = default;
  Observation(Observation &&) = default;
  Observation &operator=(Observation &&) = default;
  ~Observation() {
    for (QObject *r : relays) delete r;
  }
};

struct Core {
  const svl_host *host = nullptr;
  std::unordered_map<uint64_t, AsyncOp> asyncs;  // by completion callback id
  std::unordered_map<svl_handle, Entry> table;
  // Identity: one handle per live object. Erased in the `destroyed` slot, so a recycled address
  // can never alias another handle.
