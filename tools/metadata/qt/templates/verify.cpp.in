bool t_runtime_handle_info_and_idempotent_destroy(std::string &why) {
  CHECK(K("main-window") && K("label"));
  svl_handle w = mk("main-window");
  svl_handle l = mk("label");
  svl_handle_info info{};
  CHECK(B->handle_info(B->self, w, &info) == 0);
  CHECK(info.kind == K("main-window"));
  CHECK(info.lifetime == SVL_LIFE_TOPLEVEL);
  CHECK(B->handle_info(B->self, l, &info) == 0);
  CHECK(info.kind == K("label"));
  CHECK(info.lifetime == SVL_LIFE_OWNED);
  B->destroy(B->self, l);
  B->destroy(B->self, l);          // idempotent
  B->destroy(B->self, 424242);     // never issued: harmless
  CHECK(B->handle_info(B->self, l, &info) < 0);
  CHECK(std::strlen(B->last_error(B->self)) > 0);
  CHECK(!was_destroyed(l));        // the app's own destroy is silent
  B->destroy(B->self, w);
  flush();
  return true;
}

bool t_runtime_uncontrolled_close_cascades(std::string &why) {
  svl_handle w = mk("main-window");
  svl_handle l = mk("label");
  CHECK(B->insert(B->self, w, l, 0, 0) == 0);
  auto *widget = qobject_cast<QWidget *>(O(w));
  CHECK(widget);
  CHECK(widget->close());
