const TestCase kTests[] = {
    {"runtime/stale_handles_error", t_runtime_stale_handles_error},
    {"runtime/host_destroy_is_silent", t_runtime_host_destroy_is_silent},
    {"runtime/native_destroy_notifies_host", t_runtime_native_destroy_notifies_host},
    {"runtime/parent_destroy_notifies_children", t_runtime_parent_destroy_notifies_children},
    {"runtime/handle_info_and_idempotent_destroy", t_runtime_handle_info_and_idempotent_destroy},
    {"runtime/uncontrolled_close_cascades", t_runtime_uncontrolled_close_cascades},
    {"runtime/controlled_close_is_vetoed", t_runtime_controlled_close_is_vetoed},
    {"runtime/close_handler_decides_through_call_sync", t_runtime_close_handler_decides_through_call_sync},
    {"runtime/key_press_handler_consumes_the_key", t_runtime_key_press_handler_consumes_the_key},
    {"runtime/mouse_press_handler_consumes_and_reports_a_point", t_runtime_mouse_press_handler_consumes_and_reports_a_point},
    {"runtime/other_event_families_deliver_their_payloads", t_runtime_other_event_families_deliver_their_payloads},
    {"runtime/capture_reaches_descendant_mouse_press_first", t_runtime_capture_reaches_descendant_mouse_press_first},
    {"runtime/canvas_replays_ops_into_pixels", t_runtime_canvas_replays_ops_into_pixels},
    {"runtime/listen_after_runs_behind_plain", t_runtime_listen_after_runs_behind_plain},
    {"runtime/listen_phase_refusals", t_runtime_listen_phase_refusals},
    {"runtime/capture_reaches_descendant_key_before_its_own_listener", t_runtime_capture_reaches_descendant_key_before_its_own_listener},
    {"runtime/request_frame_delivers_once_per_request", t_runtime_request_frame_delivers_once_per_request},
    {"runtime/wake_queues_checkpoint", t_runtime_wake_queues_checkpoint},
    {"runtime/wrong_value_type_is_error", t_runtime_wrong_value_type_is_error},
//@@TEST_TABLE@@
};

}  // namespace

extern "C" int svl_qt_verify_run(void) {
  B = svl_qt_backend();
  svl_qt_set_host(&kHost);
  // The backend creates the QApplication lazily; force it before touching Qt directly.
  svl_handle warm = B->create(B->self, K("@@ANY_TAG@@"));
  B->destroy(B->self, warm);
  int failures = 0;
  for (const TestCase &t : kTests) {
    rec.clear();
    reply = Reply::Busy;
    sync_calls.clear();
    frames = 0;
    std::string why;
    bool ok = t.fn(why);
    flush();
    if (ok) {
      std::printf("ok   %s\n", t.name);
    } else {
      std::printf("FAIL %s: %s (backend: %s)\n", t.name, why.c_str(), B->last_error(B->self));
      failures++;
    }
  }
  std::printf("%d tests, %d failed\n", static_cast<int>(sizeof(kTests) / sizeof(kTests[0])), failures);
  std::fflush(stdout);
  return failures;
}
