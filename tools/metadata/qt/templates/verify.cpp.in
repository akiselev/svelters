  v.type = type;
  v.u.i = value;
  return v;
}
int64_t enum_member_value(const svl_type_desc *td, const char *name) {
  for (uint32_t i = 0; i < td->n_members; ++i)
    if (std::strcmp(td->members[i].name, name) == 0) return td->members[i].value;
  return INT64_MIN;
}
std::string getstr(svl_handle h, svl_id p) {
  svl_value out{};
  if (B->get_prop(B->self, h, p, &out) != 0 || out.tag != SVL_STR) return "<err>";
  return std::string(static_cast<const char *>(out.u.s.ptr), out.u.s.len);
}

