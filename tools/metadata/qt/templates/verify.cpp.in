bool t_runtime_mouse_press_handler_consumes_and_reports_a_point(std::string &why) {
  svl_handle e = mk("line-edit");
  svl_id sig = G("line-edit", "mouse-press");
  CHECK(sig != 0);
  auto *edit = qobject_cast<QLineEdit *>(O(e));
  edit->setText("hello");
  edit->setCursorPosition(5);
  auto press = [&]() {
    QMouseEvent ev(QEvent::MouseButtonPress, QPointF(0, 5), edit->mapToGlobal(QPointF(0, 5)), Qt::LeftButton, Qt::LeftButton, Qt::NoModifier);
    QCoreApplication::sendEvent(edit, &ev);
  };
  CHECK(B->listen(B->self, e, sig, true) == 0);
  CHECK(B->listen(B->self, e, sig, true) == 0);  // idempotent
  reply = Reply::Stop;
  press();
  CHECK(edit->cursorPosition() == 5);  // consumed: the line edit never moved its cursor
  CHECK(sync_calls.size() == 1 && sync_calls[0].h == e && sync_calls[0].sig == sig && sync_calls[0].n == 4);
  CHECK(sync_calls[0].tags[0] == SVL_RECORD && sync_calls[0].ints[1] == Qt::LeftButton && sync_calls[0].ints[2] == Qt::LeftButton);
  reply = Reply::Continue;
  press();
  CHECK(edit->cursorPosition() == 0);  // propagated: default handling ran
  CHECK(B->listen(B->self, e, sig, false) == 0);
  sync_calls.clear();
  press();
  CHECK(sync_calls.empty());
  B->destroy(B->self, e);
  return true;
}

bool t_runtime_other_event_families_deliver_their_payloads(std::string &why) {
  svl_handle e = mk("line-edit");
  auto *edit = qobject_cast<QLineEdit *>(O(e));
  // Consumable families: call_sync with the payload.
  reply = Reply::Continue;
  CHECK(B->listen(B->self, e, G("line-edit", "key-release"), true) == 0);
  QKeyEvent kr(QEvent::KeyRelease, Qt::Key_Q, Qt::ShiftModifier, QStringLiteral("Q"));
  QCoreApplication::sendEvent(edit, &kr);
  CHECK(sync_calls.size() == 1 && sync_calls[0].n == 3 && sync_calls[0].key == Qt::Key_Q && sync_calls[0].text == "Q");
  CHECK(B->listen(B->self, e, G("line-edit", "wheel"), true) == 0);
  QWheelEvent wh(QPointF(1, 2), QPointF(3, 4), QPoint(), QPoint(0, 120), Qt::NoButton, Qt::NoModifier, Qt::NoScrollPhase, false);
  QCoreApplication::sendEvent(edit, &wh);
  CHECK(sync_calls.size() == 2 && sync_calls[1].n == 4 && sync_calls[1].tags[0] == SVL_RECORD && sync_calls[1].tags[1] == SVL_RECORD);
  CHECK(B->listen(B->self, e, G("line-edit", "context-menu"), true) == 0);
  QContextMenuEvent cm(QContextMenuEvent::Mouse, QPoint(3, 4), QPoint(13, 14));
  QCoreApplication::sendEvent(edit, &cm);
  CHECK(sync_calls.size() == 3 && sync_calls[2].n == 3);
  // Informational families are posted and never consume.
  CHECK(B->listen(B->self, e, G("line-edit", "resize"), true) == 0);
  CHECK(B->listen(B->self, e, G("line-edit", "focus-in"), true) == 0);
  CHECK(B->listen(B->self, e, G("line-edit", "enter"), true) == 0);
  CHECK(B->listen(B->self, e, G("line-edit", "leave"), true) == 0);
  rec.events.clear();
  QResizeEvent rs(QSize(5, 6), QSize(1, 2));
  QCoreApplication::sendEvent(edit, &rs);
  QFocusEvent fi(QEvent::FocusIn, Qt::TabFocusReason);
  QCoreApplication::sendEvent(edit, &fi);
  QEnterEvent en(QPointF(1, 1), QPointF(1, 1), QPointF(1, 1));
  QCoreApplication::sendEvent(edit, &en);
  QEvent lv(QEvent::Leave);
  QCoreApplication::sendEvent(edit, &lv);
  CHECK(rec.events.size() == 4);
  CHECK(rec.events[0].sig == G("line-edit", "resize") && rec.events[0].n == 2);
  CHECK(rec.events[1].sig == G("line-edit", "focus-in") && rec.events[1].n == 1 && rec.events[1].strs[0] == std::to_string(Qt::TabFocusReason));
  CHECK(rec.events[2].sig == G("line-edit", "enter") && rec.events[2].n == 1);
  CHECK(rec.events[3].sig == G("line-edit", "leave") && rec.events[3].n == 0);
  B->destroy(B->self, e);
  return true;
}

bool t_runtime_capture_reaches_descendant_mouse_press_first(std::string &why) {
  svl_handle box = mk("box-layout");
  svl_handle e = mk("line-edit");
  CHECK(B->insert(B->self, box, e, 0, 0) == 0);
  auto *edit = qobject_cast<QLineEdit *>(O(e));
  edit->setText("hello");
  edit->setCursorPosition(5);
  svl_id bsig = G("box-layout", "mouse-press");
  CHECK(B->listen_ex(B->self, box, bsig, true, SVL_LISTEN_CAPTURE) == 0);
  CHECK(B->listen_ex(B->self, box, bsig, true, SVL_LISTEN_AFTER) != 0);  // no after phase
  auto press = [&]() {
    QMouseEvent ev(QEvent::MouseButtonPress, QPointF(0, 5), edit->mapToGlobal(QPointF(0, 5)), Qt::LeftButton, Qt::LeftButton, Qt::NoModifier);
    QCoreApplication::sendEvent(edit, &ev);
  };
  reply = Reply::Stop;
  press();
  CHECK(sync_calls.size() == 1 && sync_calls[0].h == box && sync_calls[0].sig == (bsig | (SVL_LISTEN_CAPTURE << SVL_SIGNAL_FLAGS_SHIFT)));
  CHECK(edit->cursorPosition() == 5);  // consumed in the capture phase
  CHECK(B->listen_ex(B->self, box, bsig, false, SVL_LISTEN_CAPTURE) == 0);
  sync_calls.clear();
  press();
  CHECK(sync_calls.empty());
  B->destroy(B->self, box);
  return true;
}

// ---- canvas (X8) -----------------------------------------------------------------------------------

bool t_runtime_canvas_replays_ops_into_pixels(std::string &why) {
  svl_handle c = mk("canvas");
  auto *w = qobject_cast<QWidget *>(O(c));
  CHECK(w);
  w->resize(60, 50);
  auto set_ops = [&](const char *json) {
    svl_value v{};
    v.tag = SVL_STR;
    v.u.s.ptr = json;
    v.u.s.len = std::strlen(json);
    return B->set_prop(B->self, c, P("canvas", "ops"), &v);
  };
  auto px = [&](int x, int y) { return w->grab().toImage().pixelColor(x, y).name().toStdString(); };
  CHECK(set_ops(R"J([["fillStyle","#ff0000"],["fillRect",0,0,10,10],
    ["save"],["translate",20,0],["fillStyle","rgba(0,0,255,1)"],["fillRect",0,0,10,10],["restore"],
    ["beginPath"],["arc",30,30,8,0,6.2831853],["fillStyle","#00ff00"],["fill"],
    ["beginPath"],["rect",0,0,50,5],["clip"],["fillStyle","#ffff00"],["fillRect",40,0,10,40]])J"
            ) == 0);
  CHECK(px(5, 5) == "#ff0000");
  CHECK(px(25, 8) == "#0000ff");  // translate inside save/restore (y 8 is below the clip band)
  CHECK(px(30, 30) == "#00ff00");  // arc
  CHECK(px(45, 3) == "#ffff00");   // inside the clip
  CHECK(px(45, 20) != "#ffff00");  // clipped away
  CHECK(px(55, 45) != "#ff0000");
  // Text inks pixels.
  CHECK(set_ops(R"J([["fillStyle","#000000"],["font","bold 20px sans-serif"],["fillText","Hi",2,25]])J") == 0);
  QImage img = w->grab().toImage();
  int dark = 0;
  for (int y = 0; y < img.height(); ++y)
    for (int x = 0; x < img.width(); ++x)
      if (img.pixelColor(x, y).lightness() < 100) ++dark;
  CHECK(dark > 30);
  // Invalid lists are errors, not crashes; a null value clears the canvas.
  CHECK(set_ops("{not json") != 0);
  CHECK(set_ops(R"({"a":1})") != 0);
  svl_value n{};
  CHECK(B->set_prop(B->self, c, P("canvas", "ops"), &n) == 0);
  svl_value out{};
  CHECK(B->get_prop(B->self, c, P("canvas", "ops"), &out) == 0 && str_of(out).empty());
  // The event families work on the canvas: resize is posted with [size, oldSize].
  svl_id rs = G("canvas", "resize");
  CHECK(rs != 0 && B->listen(B->self, c, rs, true) == 0);
  rec.events.clear();
  QResizeEvent re(QSize(7, 8), QSize(1, 2));
  QCoreApplication::sendEvent(w, &re);
  CHECK(rec.events.size() == 1 && rec.events[0].sig == rs && rec.events[0].n == 2);
  B->destroy(B->self, c);
  return true;
}

// ---- listener phases (ABI v2.2 listen_ex) ----------------------------------------------------

constexpr svl_id wire_id(svl_id sig, uint32_t flags) { return sig | (flags << SVL_SIGNAL_FLAGS_SHIFT); }

bool t_runtime_listen_after_runs_behind_plain(std::string &why) {
  svl_handle h = mk("@@SIG_TAG@@");
  svl_id sig = G("@@SIG_TAG@@", "@@SIG_NAME@@");
  CHECK(sig != 0 && B->listen_ex != nullptr);
  auto fire = [&](int i) { auto *w = static_cast<@@SIG_CLASS@@ *>(O(h)); (void)w; (void)i; @@SIG_TRIGGER@@; };
  // The after-connection is made first and the plain one later: the plain listener is still reported first.
  CHECK(B->listen_ex(B->self, h, sig, true, SVL_LISTEN_AFTER) == 0);
  CHECK(B->listen_ex(B->self, h, sig, true, SVL_LISTEN_AFTER) == 0);  // idempotent
  CHECK(B->listen(B->self, h, sig, true) == 0);
  fire(0);
  CHECK(rec.events.size() == 2);
  CHECK(rec.events[0].sig == sig && rec.events[1].sig == wire_id(sig, SVL_LISTEN_AFTER));
  rec.events.clear();
  // off removes only the matching connection.
  CHECK(B->listen_ex(B->self, h, sig, false, SVL_LISTEN_AFTER) == 0);
  fire(1);
  CHECK(rec.events.size() == 1 && rec.events[0].sig == sig);
  rec.events.clear();
  CHECK(B->listen_ex(B->self, h, sig, true, SVL_LISTEN_AFTER) == 0);
  CHECK(B->listen(B->self, h, sig, false) == 0);
  fire(2);
  CHECK(rec.events.size() == 1 && rec.events[0].sig == wire_id(sig, SVL_LISTEN_AFTER));
  B->destroy(B->self, h);
  return true;
}

bool t_runtime_listen_phase_refusals(std::string &why) {
  svl_handle h = mk("@@SIG_TAG@@");
  svl_id sig = G("@@SIG_TAG@@", "@@SIG_NAME@@");
  CHECK(B->listen_ex(B->self, h, sig, true, SVL_LISTEN_CAPTURE) < 0);
  CHECK(std::strstr(B->last_error(B->self), "capture") != nullptr);
  CHECK(B->listen_ex(B->self, h, sig, true, SVL_LISTEN_CAPTURE | SVL_LISTEN_AFTER) < 0);
  CHECK(B->listen_ex(B->self, h, sig, true, 8) < 0);  // unknown flag
  B->destroy(B->self, h);
  svl_handle e = mk("line-edit");
  svl_id key = G("line-edit", "key-press");
  CHECK(B->listen_ex(B->self, e, key, true, SVL_LISTEN_AFTER) < 0);
  CHECK(std::strstr(B->last_error(B->self), "no after phase") != nullptr);
  CHECK(B->listen_ex(B->self, e, key, true, SVL_LISTEN_CAPTURE) == 0);  // allowed (a capture listener on the entry itself never fires)
  CHECK(B->listen_ex(B->self, e, key, false, SVL_LISTEN_CAPTURE) == 0);
  B->destroy(B->self, e);
  svl_handle w = mk("main-window");
  svl_id close = G("main-window", "close");
  CHECK(B->listen_ex(B->self, w, close, true, SVL_LISTEN_CAPTURE) < 0);
  CHECK(B->listen_ex(B->self, w, close, true, SVL_LISTEN_AFTER) < 0);
  CHECK(std::strstr(B->last_error(B->self), "event-filter") != nullptr);
  B->destroy(B->self, w);
  return true;
}

bool t_runtime_capture_reaches_descendant_key_before_its_own_listener(std::string &why) {
  svl_handle box = mk("box-layout");
  svl_handle e = mk("line-edit");
  CHECK(B->insert(B->self, box, e, 0, 0) == 0);
  auto *edit = qobject_cast<QLineEdit *>(O(e));
  CHECK(edit);
  svl_id bsig = G("box-layout", "key-press");
  svl_id esig = G("line-edit", "key-press");
  CHECK(bsig != 0 && esig != 0);
  auto press = [&](QWidget *w, int key, const char *text) {
    QKeyEvent ev(QEvent::KeyPress, key, Qt::NoModifier, QString::fromUtf8(text));
    QCoreApplication::sendEvent(w, &ev);
  };
  CHECK(B->listen_ex(B->self, box, bsig, true, SVL_LISTEN_CAPTURE) == 0);
  CHECK(B->listen_ex(B->self, box, bsig, true, SVL_LISTEN_CAPTURE) == 0);  // idempotent
  CHECK(B->listen(B->self, e, esig, true) == 0);
  reply = Reply::Continue;
  press(edit, Qt::Key_A, "a");
  CHECK(sync_calls.size() == 2);
  CHECK(sync_calls[0].h == box && sync_calls[0].sig == wire_id(bsig, SVL_LISTEN_CAPTURE));  // capture first
  CHECK(sync_calls[1].h == e && sync_calls[1].sig == esig);
  CHECK(sync_calls[0].n == 3 && sync_calls[0].key == Qt::Key_A && sync_calls[0].text == "a");
  CHECK(edit->text() == "a");
  // The capture handler consumes the key: neither the entry's listener nor the entry see it.
  sync_calls.clear();
  reply = Reply::Stop;
  press(edit, Qt::Key_B, "b");
  CHECK(sync_calls.size() == 1 && sync_calls[0].h == box);
  CHECK(edit->text() == "a");
  // A key sent to the box itself is not a descendant's key.
  sync_calls.clear();
  press(qobject_cast<QWidget *>(O(box)), Qt::Key_C, "c");
  CHECK(sync_calls.empty());
  // off removes the capture listener (and the application filter with the last one).
  CHECK(B->listen_ex(B->self, box, bsig, false, SVL_LISTEN_CAPTURE) == 0);
  reply = Reply::Continue;
  press(edit, Qt::Key_D, "d");
  CHECK(sync_calls.size() == 1 && sync_calls[0].h == e);
  CHECK(edit->text() == "ad");
  B->destroy(B->self, box);
  return true;
}

bool t_runtime_request_frame_delivers_once_per_request(std::string &why) {
  // No visible window: the fallback timer stands in for the frame clock.
  B->request_frame(B->self);
  B->request_frame(B->self);  // idempotent while pending
  CHECK(frames == 0);
  for (int i = 0; i < 100 && frames == 0; ++i) {
    QCoreApplication::processEvents(QEventLoop::AllEvents, 10);
    std::this_thread::sleep_for(std::chrono::milliseconds(5));
  }
  CHECK(frames == 1);
  for (int i = 0; i < 20; ++i) {
    QCoreApplication::processEvents(QEventLoop::AllEvents, 10);
    std::this_thread::sleep_for(std::chrono::milliseconds(5));
  }
  CHECK(frames == 1);
  // A visible window: QWindow::requestUpdate drives it.
  svl_handle w = mk("main-window");
  auto *widget = qobject_cast<QWidget *>(O(w));
  widget->show();
  for (int i = 0; i < 40; ++i) QCoreApplication::processEvents(QEventLoop::AllEvents, 10);
  const unsigned before = svl_qt_frames_by_update();
  for (int round = 0; round < 3; ++round) {
    const int start = frames;
    B->request_frame(B->self);
    for (int i = 0; i < 100 && frames == start; ++i) {
      QCoreApplication::processEvents(QEventLoop::AllEvents, 10);
      std::this_thread::sleep_for(std::chrono::milliseconds(5));
    }
    CHECK(frames == start + 1);
  }
  CHECK(svl_qt_frames_by_update() - before == 3);
  B->destroy(B->self, w);
  return true;
}

bool t_runtime_wake_queues_checkpoint(std::string &why) {
  rec.clear();
  std::thread t([] { B->wake(B->self); });
  t.join();
  CHECK(rec.checkpoints == 0);
  QCoreApplication::processEvents();
  CHECK(rec.checkpoints == 1);
  return true;
}

bool t_runtime_wrong_value_type_is_error(std::string &why) {
  svl_handle h = mk("@@VALUE_TAG@@");
  svl_value v = vi64(5);
  CHECK(B->set_prop(B->self, h, P("@@VALUE_TAG@@", "@@VALUE_PROP@@"), &v) < 0);
  CHECK(std::strlen(B->last_error(B->self)) > 0);
  CHECK(B->set_prop(B->self, h, 0, &v) < 0);
  B->destroy(B->self, h);
  flush();
  return true;
}

