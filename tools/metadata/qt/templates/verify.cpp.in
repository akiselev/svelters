bool t_runtime_mouse_press_handler_consumes_and_reports_a_point(std::string &why) {
  svl_handle e = mk("line-edit");
  svl_id sig = G("line-edit", "mouse-press");
  CHECK(sig != 0);
  auto *edit = qobject_cast<QLineEdit *>(O(e));
  edit->setText("hello");
  edit->setCursorPosition(5);
  auto press = [&]() {
    QMouseEvent ev(QEvent::MouseButtonPress, QPointF(0, 5), edit->mapToGlobal(QPointF(0, 5)), Qt::LeftButton, Qt::LeftButton, Qt::NoModifier);
    QCoreApplication::sendEvent(edit, &ev);
  };
  CHECK(B->listen(B->self, e, sig, true) == 0);
  CHECK(B->listen(B->self, e, sig, true) == 0);  // idempotent
  reply = Reply::Stop;
  press();
  CHECK(edit->cursorPosition() == 5);  // consumed: the line edit never moved its cursor
  CHECK(sync_calls.size() == 1 && sync_calls[0].h == e && sync_calls[0].sig == sig && sync_calls[0].n == 4);
  CHECK(sync_calls[0].tags[0] == SVL_RECORD && sync_calls[0].ints[1] == Qt::LeftButton && sync_calls[0].ints[2] == Qt::LeftButton);
  reply = Reply::Continue;
  press();
  CHECK(edit->cursorPosition() == 0);  // propagated: default handling ran
  CHECK(B->listen(B->self, e, sig, false) == 0);
  sync_calls.clear();
  press();
  CHECK(sync_calls.empty());
  B->destroy(B->self, e);
  return true;
}

bool t_runtime_other_event_families_deliver_their_payloads(std::string &why) {
  svl_handle e = mk("line-edit");
  auto *edit = qobject_cast<QLineEdit *>(O(e));
  // Consumable families: call_sync with the payload.
  reply = Reply::Continue;
  CHECK(B->listen(B->self, e, G("line-edit", "key-release"), true) == 0);
  QKeyEvent kr(QEvent::KeyRelease, Qt::Key_Q, Qt::ShiftModifier, QStringLiteral("Q"));
  QCoreApplication::sendEvent(edit, &kr);
  CHECK(sync_calls.size() == 1 && sync_calls[0].n == 3 && sync_calls[0].key == Qt::Key_Q && sync_calls[0].text == "Q");
  CHECK(B->listen(B->self, e, G("line-edit", "wheel"), true) == 0);
  QWheelEvent wh(QPointF(1, 2), QPointF(3, 4), QPoint(), QPoint(0, 120), Qt::NoButton, Qt::NoModifier, Qt::NoScrollPhase, false);
  QCoreApplication::sendEvent(edit, &wh);
  CHECK(sync_calls.size() == 2 && sync_calls[1].n == 4 && sync_calls[1].tags[0] == SVL_RECORD && sync_calls[1].tags[1] == SVL_RECORD);
  CHECK(B->listen(B->self, e, G("line-edit", "context-menu"), true) == 0);
  QContextMenuEvent cm(QContextMenuEvent::Mouse, QPoint(3, 4), QPoint(13, 14));
  QCoreApplication::sendEvent(edit, &cm);
  CHECK(sync_calls.size() == 3 && sync_calls[2].n == 3);
  // Informational families are posted and never consume.
  CHECK(B->listen(B->self, e, G("line-edit", "resize"), true) == 0);
  CHECK(B->listen(B->self, e, G("line-edit", "focus-in"), true) == 0);
  CHECK(B->listen(B->self, e, G("line-edit", "enter"), true) == 0);
  CHECK(B->listen(B->self, e, G("line-edit", "leave"), true) == 0);
  rec.events.clear();
  QResizeEvent rs(QSize(5, 6), QSize(1, 2));
  QCoreApplication::sendEvent(edit, &rs);
  QFocusEvent fi(QEvent::FocusIn, Qt::TabFocusReason);
  QCoreApplication::sendEvent(edit, &fi);
  QEnterEvent en(QPointF(1, 1), QPointF(1, 1), QPointF(1, 1));
  QCoreApplication::sendEvent(edit, &en);
  QEvent lv(QEvent::Leave);
  QCoreApplication::sendEvent(edit, &lv);
  CHECK(rec.events.size() == 4);
  CHECK(rec.events[0].sig == G("line-edit", "resize") && rec.events[0].n == 2);
  CHECK(rec.events[1].sig == G("line-edit", "focus-in") && rec.events[1].n == 1 && rec.events[1].strs[0] == std::to_string(Qt::TabFocusReason));
  CHECK(rec.events[2].sig == G("line-edit", "enter") && rec.events[2].n == 1);
  CHECK(rec.events[3].sig == G("line-edit", "leave") && rec.events[3].n == 0);
  B->destroy(B->self, e);
  return true;
}

bool t_runtime_capture_reaches_descendant_mouse_press_first(std::string &why) {
  svl_handle box = mk("box-layout");
  svl_handle e = mk("line-edit");
  CHECK(B->insert(B->self, box, e, 0, 0) == 0);
  auto *edit = qobject_cast<QLineEdit *>(O(e));
  edit->setText("hello");
  edit->setCursorPosition(5);
  svl_id bsig = G("box-layout", "mouse-press");
  CHECK(B->listen_ex(B->self, box, bsig, true, SVL_LISTEN_CAPTURE) == 0);
  CHECK(B->listen_ex(B->self, box, bsig, true, SVL_LISTEN_AFTER) != 0);  // no after phase
  auto press = [&]() {
    QMouseEvent ev(QEvent::MouseButtonPress, QPointF(0, 5), edit->mapToGlobal(QPointF(0, 5)), Qt::LeftButton, Qt::LeftButton, Qt::NoModifier);
    QCoreApplication::sendEvent(edit, &ev);
  };
  reply = Reply::Stop;
  press();
  CHECK(sync_calls.size() == 1 && sync_calls[0].h == box && sync_calls[0].sig == (bsig | (SVL_LISTEN_CAPTURE << SVL_SIGNAL_FLAGS_SHIFT)));
  CHECK(edit->cursorPosition() == 5);  // consumed in the capture phase
  CHECK(B->listen_ex(B->self, box, bsig, false, SVL_LISTEN_CAPTURE) == 0);
  sync_calls.clear();
  press();
  CHECK(sync_calls.empty());
  B->destroy(B->self, box);
  return true;
}

