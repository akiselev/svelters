  CHECK(B->handle_info(B->self, l, &info) < 0);
  B->destroy(B->self, w);  // stale: ignored
  flush();
  CHECK(rec.destroyed.size() == 2);  // at most once
  return true;
}

bool t_runtime_controlled_close_is_vetoed(std::string &why) {
  reply = Reply::Busy;
  svl_handle w = mk("main-window");
  svl_id sig = G("main-window", "close");
  CHECK(sig != 0);
  CHECK(B->listen(B->self, w, sig, true) == 0);
  auto *widget = qobject_cast<QWidget *>(O(w));
  CHECK(widget);
  CHECK(!widget->close());  // vetoed
  CHECK(rec.events.size() == 1 && rec.events[0].h == w && rec.events[0].sig == sig);
  CHECK(rec.destroyed.empty());
  svl_handle_info info{};
  CHECK(B->handle_info(B->self, w, &info) == 0);  // still alive
  CHECK(B->listen(B->self, w, sig, false) == 0);
  CHECK(widget->close());  // no listener: closed for good
  CHECK(rec.destroyed.size() == 1 && rec.destroyed[0] == w && rec.reasons[0] == SVL_GONE_CLOSED);
  return true;
}

bool t_runtime_close_handler_decides_through_call_sync(std::string &why) {
  svl_handle w = mk("main-window");
  svl_id sig = G("main-window", "close");
  CHECK(B->listen(B->self, w, sig, true) == 0);
  auto *widget = qobject_cast<QWidget *>(O(w));
  CHECK(widget);
  // The handler vetoes: the window stays, the call is synchronous and nothing is queued.
  reply = Reply::Stop;
  CHECK(!widget->close());
  CHECK(sync_calls.size() == 1 && sync_calls[0].h == w && sync_calls[0].sig == sig && sync_calls[0].n == 0);
  CHECK(rec.events.empty() && rec.destroyed.empty());
  // Explicit "continue" and no decision both let the close through.
  reply = Reply::Continue;
  CHECK(widget->close());
  CHECK(rec.destroyed.size() == 1 && rec.destroyed[0] == w && rec.reasons[0] == SVL_GONE_CLOSED);
  // A failing call (no handler ran) also falls back to the toolkit default.
  svl_handle w2 = mk("main-window");
  CHECK(B->listen(B->self, w2, G("main-window", "close"), true) == 0);
  reply = Reply::Failed;
  CHECK(qobject_cast<QWidget *>(O(w2))->close());
  CHECK(rec.destroyed.size() == 2 && rec.destroyed[1] == w2);
  return true;
}

bool t_runtime_key_press_handler_consumes_the_key(std::string &why) {
  svl_handle e = mk("line-edit");
  svl_id sig = G("line-edit", "key-press");
  CHECK(sig != 0);
  auto *edit = qobject_cast<QLineEdit *>(O(e));
  CHECK(edit);
  auto press = [&](int key, const char *text) {
    QKeyEvent ev(QEvent::KeyPress, key, Qt::NoModifier, QString::fromUtf8(text));
    QCoreApplication::sendEvent(edit, &ev);
  };
  // Not listened: the widget handles the key as usual.
  press(Qt::Key_A, "a");
  CHECK(edit->text() == "a");
  CHECK(B->listen(B->self, e, sig, true) == 0);
  CHECK(B->listen(B->self, e, sig, true) == 0);  // idempotent: one filter
  reply = Reply::Stop;  // handled: the entry never sees the key
  press(Qt::Key_B, "b");
  CHECK(edit->text() == "a");
  CHECK(sync_calls.size() == 1 && sync_calls[0].h == e && sync_calls[0].n == 3);
  CHECK(sync_calls[0].key == Qt::Key_B && sync_calls[0].text == "b");
  // Not handled (false, no decision, failed call, busy host): default handling goes on.
  for (Reply r : {Reply::Continue, Reply::Null, Reply::Failed, Reply::Busy}) {
    reply = r;
    press(Qt::Key_C, "c");
  }
  CHECK(edit->text() == "acccc");
  CHECK(rec.events.size() == 1);  // the busy call was queued as an ordinary event
  // Listening off restores plain delivery.
  CHECK(B->listen(B->self, e, sig, false) == 0);
  reply = Reply::Stop;
  sync_calls.clear();
  press(Qt::Key_D, "d");
  CHECK(edit->text() == "accccd" && sync_calls.empty());
  B->destroy(B->self, e);
  return true;
}

