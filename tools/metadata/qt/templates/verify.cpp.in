  void clear() { events.clear(); destroyed.clear(); reasons.clear(); checkpoints = 0; }
} rec;

// Text of a STR value as UTF-8, whichever encoding the backend chose.
std::string str_of(const svl_value &v) {
  if (v.flags & SVL_F_UTF16)
    return QString::fromUtf16(static_cast<const char16_t *>(v.u.s.ptr), static_cast<qsizetype>(v.u.s.len)).toStdString();
  return std::string(static_cast<const char *>(v.u.s.ptr), v.u.s.len);
}

// Signal args and property values as strings, so tests compare any scalar type the same way.
std::string valstr(const svl_value &v) {
  switch (v.tag) {
    case SVL_STR: return str_of(v);
    case SVL_BOOL: return v.u.b ? "true" : "false";
    case SVL_I64: return std::to_string(v.u.i);
    case SVL_F64: { char b[64]; std::snprintf(b, sizeof b, "%g", v.u.f); return b; }
    default: return std::string();
  }
}

void h_post(void *, svl_handle h, svl_id sig, const svl_value *args, size_t n) {
  Ev e{h, sig, {}, n};
  for (size_t i = 0; i < n; ++i) e.strs.push_back(valstr(args[i]));
  rec.events.push_back(std::move(e));
}
void h_checkpoint(void *) { rec.checkpoints++; }
// What the stub host answers to call_sync: busy (queue the call as an event, like a host that is
// already running JS), a failure, or a handler result.
enum class Reply { Busy, Failed, Stop, Continue, Null };
Reply reply = Reply::Busy;
struct SyncCall {
  svl_handle h;
  svl_id sig;
  size_t n;
  int64_t key;
  std::string text;
  std::vector<int> tags;      // value tag of each argument
  std::vector<int64_t> ints;  // integer value of each argument (0 for others)
};
std::vector<SyncCall> sync_calls;
int h_call_sync(void *, svl_handle h, svl_id sig, const svl_value *args, size_t n, svl_value *out) {
  if (reply == Reply::Busy) {
    h_post(nullptr, h, sig, args, n);
    return SVL_SYNC_BUSY;
  }
  SyncCall c{h, sig, n, n > 0 && args[0].tag == SVL_I64 ? args[0].u.i : 0,
             n > 1 && args[1].tag == SVL_STR ? std::string(static_cast<const char *>(args[1].u.s.ptr), args[1].u.s.len) : std::string()};
  for (size_t i = 0; i < n; ++i) {
    c.tags.push_back(args[i].tag);
    c.ints.push_back(args[i].tag == SVL_I64 ? args[i].u.i : 0);
  }
  sync_calls.push_back(c);
  switch (reply) {
    case Reply::Failed: return SVL_SYNC_FAILED;
    case Reply::Stop: out->tag = SVL_BOOL; out->u.b = true; return 0;
    case Reply::Continue: out->tag = SVL_BOOL; out->u.b = false; return 0;
    default: out->tag = SVL_NULL; out->u.i = 0; return 0;
  }
}
void h_destroyed(void *, svl_handle h, uint32_t reason) {
  rec.destroyed.push_back(h);
  rec.reasons.push_back(reason);
}
int frames = 0;
void h_frame(void *) { frames++; }
