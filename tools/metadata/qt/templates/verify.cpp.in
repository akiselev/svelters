svl_id R(uint32_t what, svl_id kind, const char *n) { return B->resolve(B->self, what, kind, n, std::strlen(n)); }
svl_id K(const char *tag) { return R(SVL_KIND, 0, tag); }
svl_id P(const char *tag, const char *n) { return R(SVL_PROP, K(tag), n); }
svl_id G(const char *tag, const char *n) { return R(SVL_SIGNAL, K(tag), n); }
svl_id M(const char *tag, const char *n) { return R(SVL_METHOD, K(tag), n); }
svl_id S(const char *tag, const char *n) { return R(SVL_SLOT, K(tag), n); }
svl_handle mk(const char *tag) { return B->create(B->self, K(tag)); }
QObject *O(svl_handle h) { return static_cast<QObject *>(svl_qt_debug_object(h)); }
void flush() {
  QCoreApplication::sendPostedEvents(nullptr, QEvent::DeferredDelete);
  QCoreApplication::processEvents();
}
svl_value vstr(const std::string &s) {
  svl_value v{};
  v.tag = SVL_STR;
  v.u.s.ptr = s.data();
  v.u.s.len = s.size();
  return v;
