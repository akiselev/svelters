bool t_runtime_stale_handles_error(std::string &why) {
  svl_handle h = mk("@@ANY_TAG@@");
  svl_handle other = mk("@@ANY_TAG@@");
  CHECK(h != 0 && other != 0);
  B->destroy(B->self, h);
  flush();
  svl_value v = vstr("x");
  svl_value out{};
  CHECK(B->set_prop(B->self, h, 1, &v) < 0);
  CHECK(B->get_prop(B->self, h, 1, &out) < 0);
  CHECK(B->call(B->self, h, 1, nullptr, 0, &out) < 0);
  CHECK(B->listen(B->self, h, 1, true) < 0);
  CHECK(B->insert(B->self, h, other, 0, 0) < 0);
  CHECK(B->insert(B->self, other, h, 0, 0) < 0);
  CHECK(B->remove(B->self, h, other) < 0);
  CHECK(B->set_prop(B->self, 987654321, 1, &v) < 0);
  CHECK(std::strlen(B->last_error(B->self)) > 0);
  B->destroy(B->self, h);  // double destroy is a no-op
  B->destroy(B->self, other);
  flush();
  return true;
}

bool t_runtime_host_destroy_is_silent(std::string &why) {
  rec.clear();
  svl_handle h = mk("@@ANY_TAG@@");
  QPointer<QObject> p(O(h));
  B->destroy(B->self, h);
  flush();
  CHECK(p.isNull());
  CHECK(!was_destroyed(h));
  return true;
}

bool t_runtime_native_destroy_notifies_host(std::string &why) {
  rec.clear();
  svl_handle h = mk("@@ANY_TAG@@");
  QObject *o = O(h);
  CHECK(o);
  delete o;
  CHECK(rec.destroyed.size() == 1 && rec.destroyed[0] == h);
  svl_value v = vstr("x");
  CHECK(B->set_prop(B->self, h, 1, &v) < 0);
  return true;
}

bool t_runtime_parent_destroy_notifies_children(std::string &why) {
  rec.clear();
  svl_handle p = mk("@@PARENT_TAG@@");
  svl_handle c = mk("@@CHILD_TAG@@");
  CHECK(B->insert(B->self, p, c, 0, 0) == 0);
  B->destroy(B->self, p);
  flush();
  CHECK(was_destroyed(c));
  B->destroy(B->self, c);  // stale after native deletion: ignored
  return true;
}

bool t_runtime_handle_info_and_idempotent_destroy(std::string &why) {
  CHECK(K("window") && K("label"));
  svl_handle w = mk("window");
  svl_handle l = mk("label");
  svl_handle_info info{};
  CHECK(B->handle_info(B->self, w, &info) == 0);
  CHECK(info.kind == K("window"));
  CHECK(info.lifetime == SVL_LIFE_TOPLEVEL);
  CHECK(B->handle_info(B->self, l, &info) == 0);
  CHECK(info.kind == K("label"));
  CHECK(info.lifetime == SVL_LIFE_OWNED);
  B->destroy(B->self, l);
  B->destroy(B->self, l);          // idempotent
  B->destroy(B->self, 424242);     // never issued: harmless
  CHECK(B->handle_info(B->self, l, &info) < 0);
  CHECK(std::strlen(B->last_error(B->self)) > 0);
  CHECK(!was_destroyed(l));        // the app's own destroy is silent
  B->destroy(B->self, w);
  flush();
  return true;
}

bool t_runtime_uncontrolled_close_cascades(std::string &why) {
  svl_handle w = mk("window");
  svl_handle l = mk("label");
  CHECK(B->insert(B->self, w, l, 0, 0) == 0);
  auto *widget = qobject_cast<QWidget *>(O(w));
  CHECK(widget);
  CHECK(widget->close());
  // The window is reported first (closed), then what was inserted below it (parent).
  CHECK(rec.destroyed.size() == 2);
  CHECK(rec.destroyed[0] == w && rec.reasons[0] == SVL_GONE_CLOSED);
  CHECK(rec.destroyed[1] == l && rec.reasons[1] == SVL_GONE_PARENT);
  svl_handle_info info{};
  CHECK(B->handle_info(B->self, w, &info) < 0);
  CHECK(B->handle_info(B->self, l, &info) < 0);
  B->destroy(B->self, w);  // stale: ignored
  flush();
  CHECK(rec.destroyed.size() == 2);  // at most once
  return true;
}

bool t_runtime_controlled_close_is_vetoed(std::string &why) {
  svl_handle w = mk("window");
  svl_id sig = G("window", "close-request");
  CHECK(sig != 0);
  CHECK(B->listen(B->self, w, sig, true) == 0);
  auto *widget = qobject_cast<QWidget *>(O(w));
  CHECK(widget);
  CHECK(!widget->close());  // vetoed
  CHECK(rec.events.size() == 1 && rec.events[0].h == w && rec.events[0].sig == sig);
  CHECK(rec.destroyed.empty());
  svl_handle_info info{};
  CHECK(B->handle_info(B->self, w, &info) == 0);  // still alive
  CHECK(B->listen(B->self, w, sig, false) == 0);
  CHECK(widget->close());  // no listener: closed for good
  CHECK(rec.destroyed.size() == 1 && rec.destroyed[0] == w && rec.reasons[0] == SVL_GONE_CLOSED);
  return true;
}

bool t_runtime_wake_queues_checkpoint(std::string &why) {
  rec.clear();
  std::thread t([] { B->wake(B->self); });
  t.join();
  CHECK(rec.checkpoints == 0);
  QCoreApplication::processEvents();
  CHECK(rec.checkpoints == 1);
  return true;
}

