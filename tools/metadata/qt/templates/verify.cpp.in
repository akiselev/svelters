bool t_runtime_canvas_replays_ops_into_pixels(std::string &why) {
  svl_handle c = mk("canvas");
  auto *w = qobject_cast<QWidget *>(O(c));
  CHECK(w);
  w->resize(60, 50);
  auto set_ops = [&](const char *json) {
    svl_value v{};
    v.tag = SVL_STR;
    v.u.s.ptr = json;
    v.u.s.len = std::strlen(json);
    return B->set_prop(B->self, c, P("canvas", "ops"), &v);
  };
  auto px = [&](int x, int y) { return w->grab().toImage().pixelColor(x, y).name().toStdString(); };
  CHECK(set_ops(R"J([["fillStyle","#ff0000"],["fillRect",0,0,10,10],
    ["save"],["translate",20,0],["fillStyle","rgba(0,0,255,1)"],["fillRect",0,0,10,10],["restore"],
    ["beginPath"],["arc",30,30,8,0,6.2831853],["fillStyle","#00ff00"],["fill"],
    ["beginPath"],["rect",0,0,50,5],["clip"],["fillStyle","#ffff00"],["fillRect",40,0,10,40]])J"
            ) == 0);
  CHECK(px(5, 5) == "#ff0000");
  CHECK(px(25, 8) == "#0000ff");  // translate inside save/restore (y 8 is below the clip band)
  CHECK(px(30, 30) == "#00ff00");  // arc
  CHECK(px(45, 3) == "#ffff00");   // inside the clip
  CHECK(px(45, 20) != "#ffff00");  // clipped away
  CHECK(px(55, 45) != "#ff0000");
  // Text inks pixels.
  CHECK(set_ops(R"J([["fillStyle","#000000"],["font","bold 20px sans-serif"],["fillText","Hi",2,25]])J") == 0);
  QImage img = w->grab().toImage();
  int dark = 0;
  for (int y = 0; y < img.height(); ++y)
    for (int x = 0; x < img.width(); ++x)
      if (img.pixelColor(x, y).lightness() < 100) ++dark;
  CHECK(dark > 30);
  // Invalid lists are errors, not crashes; a null value clears the canvas.
  CHECK(set_ops("{not json") != 0);
  CHECK(set_ops(R"({"a":1})") != 0);
  svl_value n{};
  CHECK(B->set_prop(B->self, c, P("canvas", "ops"), &n) == 0);
  svl_value out{};
  CHECK(B->get_prop(B->self, c, P("canvas", "ops"), &out) == 0 && str_of(out).empty());
  // The event families work on the canvas: resize is posted with [size, oldSize].
  svl_id rs = G("canvas", "resize");
  CHECK(rs != 0 && B->listen(B->self, c, rs, true) == 0);
  rec.events.clear();
  QResizeEvent re(QSize(7, 8), QSize(1, 2));
  QCoreApplication::sendEvent(w, &re);
  CHECK(rec.events.size() == 1 && rec.events[0].sig == rs && rec.events[0].n == 2);
  B->destroy(B->self, c);
  return true;
}

// ---- listener phases (ABI v2.2 listen_ex) ----------------------------------------------------

constexpr svl_id wire_id(svl_id sig, uint32_t flags) { return sig | (flags << SVL_SIGNAL_FLAGS_SHIFT); }

bool t_runtime_listen_after_runs_behind_plain(std::string &why) {
  svl_handle h = mk("@@SIG_TAG@@");
  svl_id sig = G("@@SIG_TAG@@", "@@SIG_NAME@@");
  CHECK(sig != 0 && B->listen_ex != nullptr);
  auto fire = [&](int i) { auto *w = static_cast<@@SIG_CLASS@@ *>(O(h)); (void)w; (void)i; @@SIG_TRIGGER@@; };
  // The after-connection is made first and the plain one later: the plain listener is still reported first.
  CHECK(B->listen_ex(B->self, h, sig, true, SVL_LISTEN_AFTER) == 0);
  CHECK(B->listen_ex(B->self, h, sig, true, SVL_LISTEN_AFTER) == 0);  // idempotent
  CHECK(B->listen(B->self, h, sig, true) == 0);
  fire(0);
  CHECK(rec.events.size() == 2);
  CHECK(rec.events[0].sig == sig && rec.events[1].sig == wire_id(sig, SVL_LISTEN_AFTER));
  rec.events.clear();
  // off removes only the matching connection.
  CHECK(B->listen_ex(B->self, h, sig, false, SVL_LISTEN_AFTER) == 0);
  fire(1);
  CHECK(rec.events.size() == 1 && rec.events[0].sig == sig);
  rec.events.clear();
  CHECK(B->listen_ex(B->self, h, sig, true, SVL_LISTEN_AFTER) == 0);
  CHECK(B->listen(B->self, h, sig, false) == 0);
  fire(2);
  CHECK(rec.events.size() == 1 && rec.events[0].sig == wire_id(sig, SVL_LISTEN_AFTER));
  B->destroy(B->self, h);
  return true;
}

bool t_runtime_listen_phase_refusals(std::string &why) {
  svl_handle h = mk("@@SIG_TAG@@");
  svl_id sig = G("@@SIG_TAG@@", "@@SIG_NAME@@");
  CHECK(B->listen_ex(B->self, h, sig, true, SVL_LISTEN_CAPTURE) < 0);
  CHECK(std::strstr(B->last_error(B->self), "capture") != nullptr);
  CHECK(B->listen_ex(B->self, h, sig, true, SVL_LISTEN_CAPTURE | SVL_LISTEN_AFTER) < 0);
  CHECK(B->listen_ex(B->self, h, sig, true, 8) < 0);  // unknown flag
  B->destroy(B->self, h);
  svl_handle e = mk("line-edit");
  svl_id key = G("line-edit", "key-press");
  CHECK(B->listen_ex(B->self, e, key, true, SVL_LISTEN_AFTER) < 0);
  CHECK(std::strstr(B->last_error(B->self), "no after phase") != nullptr);
  CHECK(B->listen_ex(B->self, e, key, true, SVL_LISTEN_CAPTURE) == 0);  // allowed (a capture listener on the entry itself never fires)
  CHECK(B->listen_ex(B->self, e, key, false, SVL_LISTEN_CAPTURE) == 0);
  B->destroy(B->self, e);
  svl_handle w = mk("main-window");
  svl_id close = G("main-window", "close");
  CHECK(B->listen_ex(B->self, w, close, true, SVL_LISTEN_CAPTURE) < 0);
  CHECK(B->listen_ex(B->self, w, close, true, SVL_LISTEN_AFTER) < 0);
  CHECK(std::strstr(B->last_error(B->self), "event-filter") != nullptr);
  B->destroy(B->self, w);
  return true;
}

bool t_runtime_capture_reaches_descendant_key_before_its_own_listener(std::string &why) {
  svl_handle box = mk("box-layout");
  svl_handle e = mk("line-edit");
  CHECK(B->insert(B->self, box, e, 0, 0) == 0);
  auto *edit = qobject_cast<QLineEdit *>(O(e));
  CHECK(edit);
  svl_id bsig = G("box-layout", "key-press");
  svl_id esig = G("line-edit", "key-press");
  CHECK(bsig != 0 && esig != 0);
  auto press = [&](QWidget *w, int key, const char *text) {
    QKeyEvent ev(QEvent::KeyPress, key, Qt::NoModifier, QString::fromUtf8(text));
    QCoreApplication::sendEvent(w, &ev);
  };
  CHECK(B->listen_ex(B->self, box, bsig, true, SVL_LISTEN_CAPTURE) == 0);
  CHECK(B->listen_ex(B->self, box, bsig, true, SVL_LISTEN_CAPTURE) == 0);  // idempotent
  CHECK(B->listen(B->self, e, esig, true) == 0);
  reply = Reply::Continue;
  press(edit, Qt::Key_A, "a");
  CHECK(sync_calls.size() == 2);
  CHECK(sync_calls[0].h == box && sync_calls[0].sig == wire_id(bsig, SVL_LISTEN_CAPTURE));  // capture first
  CHECK(sync_calls[1].h == e && sync_calls[1].sig == esig);
  CHECK(sync_calls[0].n == 3 && sync_calls[0].key == Qt::Key_A && sync_calls[0].text == "a");
  CHECK(edit->text() == "a");
  // The capture handler consumes the key: neither the entry's listener nor the entry see it.
  sync_calls.clear();
  reply = Reply::Stop;
  press(edit, Qt::Key_B, "b");
  CHECK(sync_calls.size() == 1 && sync_calls[0].h == box);
  CHECK(edit->text() == "a");
  // A key sent to the box itself is not a descendant's key.
  sync_calls.clear();
  press(qobject_cast<QWidget *>(O(box)), Qt::Key_C, "c");
  CHECK(sync_calls.empty());
  // off removes the capture listener (and the application filter with the last one).
  CHECK(B->listen_ex(B->self, box, bsig, false, SVL_LISTEN_CAPTURE) == 0);
  reply = Reply::Continue;
  press(edit, Qt::Key_D, "d");
  CHECK(sync_calls.size() == 1 && sync_calls[0].h == e);
  CHECK(edit->text() == "ad");
  B->destroy(B->self, box);
  return true;
}

bool t_runtime_request_frame_delivers_once_per_request(std::string &why) {
  // No visible window: the fallback timer stands in for the frame clock.
  B->request_frame(B->self);
  B->request_frame(B->self);  // idempotent while pending
  CHECK(frames == 0);
  for (int i = 0; i < 100 && frames == 0; ++i) {
    QCoreApplication::processEvents(QEventLoop::AllEvents, 10);
    std::this_thread::sleep_for(std::chrono::milliseconds(5));
  }
  CHECK(frames == 1);
  for (int i = 0; i < 20; ++i) {
    QCoreApplication::processEvents(QEventLoop::AllEvents, 10);
    std::this_thread::sleep_for(std::chrono::milliseconds(5));
  }
  CHECK(frames == 1);
  // A visible window: QWindow::requestUpdate drives it.
  svl_handle w = mk("main-window");
  auto *widget = qobject_cast<QWidget *>(O(w));
  widget->show();
  for (int i = 0; i < 40; ++i) QCoreApplication::processEvents(QEventLoop::AllEvents, 10);
  const unsigned before = svl_qt_frames_by_update();
  for (int round = 0; round < 3; ++round) {
    const int start = frames;
    B->request_frame(B->self);
    for (int i = 0; i < 100 && frames == start; ++i) {
      QCoreApplication::processEvents(QEventLoop::AllEvents, 10);
      std::this_thread::sleep_for(std::chrono::milliseconds(5));
    }
    CHECK(frames == start + 1);
  }
  CHECK(svl_qt_frames_by_update() - before == 3);
  B->destroy(B->self, w);
  return true;
}

bool t_runtime_wake_queues_checkpoint(std::string &why) {
  rec.clear();
  std::thread t([] { B->wake(B->self); });
  t.join();
  CHECK(rec.checkpoints == 0);
  QCoreApplication::processEvents();
  CHECK(rec.checkpoints == 1);
  return true;
}

bool t_runtime_wrong_value_type_is_error(std::string &why) {
  svl_handle h = mk("@@VALUE_TAG@@");
  svl_value v = vi64(5);
  CHECK(B->set_prop(B->self, h, P("@@VALUE_TAG@@", "@@VALUE_PROP@@"), &v) < 0);
  CHECK(std::strlen(B->last_error(B->self)) > 0);
  CHECK(B->set_prop(B->self, h, 0, &v) < 0);
  B->destroy(B->self, h);
  flush();
  return true;
}

// ---- generated facts -------------------------------------------------------------------------

// ---- table-driven tests of inferred facts --------------------------------------------------------------------
// metadata/inferred/qt facts (tools/metadata/qt/infer.py) are verified by one generic body per section and a
// table row per fact (gen_cpp.py Tests.row_*), so thousands of facts do not mean thousands of functions.
// A property value: bool/int/enum in `i`, double in `f`, UTF-8 string in `s`.
enum VT : int { VT_BOOL, VT_INT, VT_F64, VT_STR, VT_ENUM };
struct Val {
  VT t;
  int64_t i;
  double f;
  const char *s;
};
using Setup = void (*)(QObject *);  // a precondition (populate, range, text) run on the new widget
struct PropRow {
  const char *name;
  const char *tag, *js, *native;
  Setup setup;
  Val v;
};
struct MethodRow {
  const char *name;
  const char *tag, *js, *prop;  // a READ accessor and the read-only property it returns
};
struct SignalRow {
  const char *name;
  const char *tag, *js, *prop;  // the property whose sets (a, b, a) emit the signal once each
  Setup setup;
  Val a, b;
  size_t nargs, nexpect;
  const char *expect[4];  // valstr of the first arguments on the first emission
};
struct EmitRow {
  const char *name;
  const char *tag, *js, *signature;  // emitted through QMetaMethod::invoke (delivery only)
  size_t nargs;
  Val args[4];
  size_t nexpect;
  const char *expect[4];
};
struct BindingRow {
  const char *name;
  const char *tag, *prop, *signal, *native;
  Setup setup;
  Val a, b;
  bool arg0;  // the change signal's first argument is the new value
};

QVariant qv(const Val &v) {
  switch (v.t) {
    case VT_BOOL: return QVariant(v.i != 0);
    case VT_INT:
    case VT_ENUM: return QVariant(static_cast<qlonglong>(v.i));
    case VT_F64: return QVariant(v.f);
    case VT_STR: return QVariant(QString::fromUtf8(v.s));
  }
  return QVariant();
}
bool close_to(double a, double b) { return std::fabs(a - b) <= 1e-6 * std::max(1.0, std::fabs(b)); }
// The native property (QObject::property) holds `v`.
bool native_is(QObject *o, const char *native, const Val &v) {
  const QVariant r = o->property(native);
  switch (v.t) {
    case VT_BOOL: return r.toBool() == (v.i != 0);
    case VT_INT:
    case VT_ENUM: return r.toLongLong() == v.i;
    case VT_F64: return close_to(r.toDouble(), v.f);
    case VT_STR: return r.toString() == QString::fromUtf8(v.s);
  }
  return false;
}
// A backend value equals `v`.
bool out_is(const svl_value &out, const Val &v) {
  switch (v.t) {
    case VT_BOOL: return out.tag == SVL_BOOL && out.u.b == (v.i != 0);
    case VT_INT: return out.tag == SVL_I64 && out.u.i == v.i;
    case VT_ENUM: return out.tag == SVL_ENUM && out.u.i == v.i;
    case VT_F64: return out.tag == SVL_F64 && close_to(out.u.f, v.f);
    case VT_STR: return out.tag == SVL_STR && str_of(out) == v.s;
  }
  return false;
}
// A backend value equals a native QVariant.
bool out_matches(const svl_value &out, const QVariant &r) {
  switch (out.tag) {
    case SVL_BOOL: return out.u.b == r.toBool();
    case SVL_I64:
    case SVL_ENUM: return out.u.i == r.toLongLong();
    case SVL_F64: return close_to(out.u.f, r.toDouble());
    case SVL_STR: return str_of(out) == r.toString().toStdString();
    default: return false;
  }
}
// The backend value for `v`; `keep` owns string bytes, `etype` is the property's enum type id.
svl_value sv(const Val &v, svl_id etype, std::string &keep) {
  switch (v.t) {
    case VT_BOOL: return vbool(v.i != 0);
    case VT_INT: return vi64(v.i);
    case VT_ENUM: return venum(etype, v.i);
    case VT_F64: return vf64(v.f);
    case VT_STR: keep = v.s; return vstr(keep);
  }
  return svl_value{};
}
// The enum type id of a property (0 for other types), from describe().
svl_id prop_enum_type(const char *tag, svl_id p) {
  const svl_member_desc *d = B->describe(B->self, SVL_PROP, K(tag), p);
  return d && d->n_params == 1 && d->params[0].tag == SVL_ENUM ? d->params[0].type : 0;
}

bool tt_prop(const PropRow &r, std::string &why) {
  svl_handle h = mk(r.tag);
  CHECK(h != 0);
  if (r.setup) r.setup(O(h));
  svl_id p = P(r.tag, r.js);
  CHECK(p != 0);
  svl_id et = r.v.t == VT_ENUM ? prop_enum_type(r.tag, p) : 0;
  CHECK(r.v.t != VT_ENUM || et != 0);
  std::string keep;
  svl_value v = sv(r.v, et, keep);
  CHECK(B->set_prop(B->self, h, p, &v) == 0);
  CHECK(native_is(O(h), r.native, r.v));  // the backend set the native property
  svl_value out{};
  CHECK(B->get_prop(B->self, h, p, &out) == 0 && out_is(out, r.v));  // and reads it back
  B->destroy(B->self, h);
  return true;
}

bool tt_method(const MethodRow &r, std::string &why) {
  svl_handle h = mk(r.tag);
  CHECK(h != 0);
  svl_id m = M(r.tag, r.js);
  CHECK(m != 0);
  svl_value out{};
  CHECK(B->call(B->self, h, m, nullptr, 0, &out) == 0);
  CHECK(out_matches(out, O(h)->property(r.prop)));  // returns the property
  CHECK(B->call(B->self, h, m, nullptr, 1, nullptr) < 0);  // arity is checked
  B->destroy(B->self, h);
  return true;
}

bool tt_signal(const SignalRow &r, std::string &why) {
  svl_handle h = mk(r.tag);
  CHECK(h != 0);
  if (r.setup) r.setup(O(h));
  svl_id sig = G(r.tag, r.js);
  CHECK(sig != 0);
  CHECK(B->listen(B->self, h, sig, true) == 0);
  CHECK(B->listen(B->self, h, sig, true) == 0);  // idempotent: must not double-connect
  O(h)->setProperty(r.prop, qv(r.a));
  CHECK(rec.events.size() == 1);  // delivered exactly once
  CHECK(rec.events[0].h == h && rec.events[0].sig == sig);
  CHECK(rec.events[0].n == r.nargs);
  for (size_t i = 0; i < r.nexpect && i < rec.events[0].strs.size(); ++i)
    CHECK(rec.events[0].strs[i] == r.expect[i]);
  CHECK(B->listen(B->self, h, sig, false) == 0);
  O(h)->setProperty(r.prop, qv(r.b));
  CHECK(rec.events.size() == 1);  // no delivery after listen(off)
  CHECK(B->listen(B->self, h, sig, true) == 0);
  O(h)->setProperty(r.prop, qv(r.a));
  CHECK(rec.events.size() == 2);
  B->destroy(B->self, h);
  return true;
}

// Emit a signal with the given arguments, each converted to the parameter's type.
bool emit_signal(QObject *o, const char *signature, const Val *args, size_t n) {
  const QMetaObject *mo = o->metaObject();
  const int i = mo->indexOfSignal(QMetaObject::normalizedSignature(signature).constData());
  if (i < 0 || n > 4) return false;
  const QMetaMethod m = mo->method(i);
  if (static_cast<size_t>(m.parameterCount()) != n) return false;
  QVariant vs[4];
  QByteArray names[4];
  QGenericArgument ga[4];
  for (size_t k = 0; k < n; ++k) {
    vs[k] = qv(args[k]);
    if (!vs[k].convert(m.parameterMetaType(static_cast<int>(k)))) return false;
    names[k] = m.parameterTypeName(static_cast<int>(k));
    ga[k] = QGenericArgument(names[k].constData(), vs[k].constData());
  }
  return m.invoke(o, Qt::DirectConnection, ga[0], ga[1], ga[2], ga[3]);
}

bool tt_emit(const EmitRow &r, std::string &why) {
  svl_handle h = mk(r.tag);
  CHECK(h != 0);
  svl_id sig = G(r.tag, r.js);
  CHECK(sig != 0);
  CHECK(B->listen(B->self, h, sig, true) == 0);
  CHECK(B->listen(B->self, h, sig, true) == 0);  // idempotent: must not double-connect
  CHECK(emit_signal(O(h), r.signature, r.args, r.nargs));
  CHECK(rec.events.size() == 1);  // delivered exactly once
  CHECK(rec.events[0].h == h && rec.events[0].sig == sig);
  CHECK(rec.events[0].n == r.nargs);
  for (size_t i = 0; i < r.nexpect && i < rec.events[0].strs.size(); ++i)
    CHECK(rec.events[0].strs[i] == r.expect[i]);
  CHECK(B->listen(B->self, h, sig, false) == 0);
  CHECK(emit_signal(O(h), r.signature, r.args, r.nargs));
  CHECK(rec.events.size() == 1);  // no delivery after listen(off)
  CHECK(B->listen(B->self, h, sig, true) == 0);
  CHECK(emit_signal(O(h), r.signature, r.args, r.nargs));
  CHECK(rec.events.size() == 2);
  B->destroy(B->self, h);
  return true;
}

bool tt_binding(const BindingRow &r, std::string &why) {
  svl_handle h = mk(r.tag);
  CHECK(h != 0);
  if (r.setup) r.setup(O(h));
  svl_id sig = G(r.tag, r.signal), p = P(r.tag, r.prop);
  CHECK(sig != 0 && p != 0);
  CHECK(B->listen(B->self, h, sig, true) == 0);
  O(h)->setProperty(r.native, qv(r.a));  // a native change is delivered and readable
  CHECK(!rec.events.empty());
  svl_value out{};
  CHECK(B->get_prop(B->self, h, p, &out) == 0 && out_is(out, r.a));
  if (r.arg0) CHECK(!rec.events.back().strs.empty() && rec.events.back().strs[0] == valstr(out));
  svl_id et = r.b.t == VT_ENUM ? prop_enum_type(r.tag, p) : 0;
  std::string keep;
  svl_value v = sv(r.b, et, keep);
  CHECK(B->set_prop(B->self, h, p, &v) == 0);  // a programmatic set reaches the native property
  CHECK(native_is(O(h), r.native, r.b));
  B->destroy(B->self, h);
  return true;
}

// Observe facts (metadata/observe/qt.json; milestones R0 and R3): one row per fact with a `verify` block, through the
// backend's ABI v2.6 observe (NOTIFY, QBindable notifier, event filter, other signals), per REACTIVITY.md §4.5:
//   OC_CHANGE   write the property natively (QMetaProperty::write of a new value): announced; an identical write
//               then follows `fires`; 10 changes leave one dirty (handle, prop); unobserved: silent
//   OC_CROSS    the same through `trigger` (another property written natively) or `act` (a C++ statement)
//   OC_SILENT   the change happens and is not announced (a `partial` fact's missed cause)
//   OC_CONNECT  observe installs and uninstalls (no native trigger known)
//   OC_REFUSED  -1 (constant); OC_UNSUPPORTED SVL_OBSERVE_UNSUPPORTED (set_only, none); with a trigger the native
//               change happens too, and the metaobject has neither NOTIFY nor bindable: a verified `none`
// Every observing row also runs the user path (`user`, key/mouse events) when it has one, checks that a
// proportional property's own set_prop is not reported (echo, §5.4), that a deferred (geometry) change of a hidden
// widget is announced at show(), and teardown: off, then destroy while observed; the backend's observation and
// event-filter counts return to where they were.
enum ObsCheck : int { OC_CHANGE, OC_SILENT, OC_REFUSED, OC_UNSUPPORTED, OC_CONNECT, OC_CROSS };
enum ObsFires : int { OF_ANY, OF_ON_CHANGE, OF_ON_SET };
enum ObsFlags : unsigned { OB_META = 1, OB_DEFERRED = 2, OB_PROPORTIONAL = 4 };
struct ObserveRow {
  const char *name;
  const char *kind;  // element tag, or the class of a constructible type (`type`)
  bool type;
  const char *js, *native;
  int check, fires;
  const char *trigger;          // OC_CROSS / OC_SILENT / OC_UNSUPPORTED: the Q_PROPERTY written natively instead
  void (*setup)(QObject *);     // run before observing
  void (*act)(QObject *);       // the native change, when it is not a property write
  void (*user)(QObject *);      // the user path (a synthesizer): its change must be announced
  unsigned flags;
};

// User-path synthesizers for the `user` statements (what QTest::keyClicks / mouseClick send, without QtTest).
void ut_key(QObject *o, int key, Qt::KeyboardModifiers mods = Qt::NoModifier, const QString &text = QString()) {
  QKeyEvent press(QEvent::KeyPress, key, mods, text);
  QCoreApplication::sendEvent(o, &press);
  QKeyEvent release(QEvent::KeyRelease, key, mods, text);
  QCoreApplication::sendEvent(o, &release);
}
void ut_keys(QObject *o, const char *utf8) {
  for (const QChar c : QString::fromUtf8(utf8)) ut_key(o, 0, Qt::NoModifier, QString(c));
}
void ut_mouse(QObject *o, QEvent::Type t) {
  auto *w = qobject_cast<QWidget *>(o);
  const QPointF pos = w ? QPointF(w->rect().center()) : QPointF(1, 1);
  QMouseEvent ev(t, pos, w ? QPointF(w->mapToGlobal(pos)) : pos, Qt::LeftButton,
                 t == QEvent::MouseButtonRelease ? Qt::NoButton : Qt::LeftButton, Qt::NoModifier);
  QCoreApplication::sendEvent(o, &ev);
}
void ut_press(QObject *o) { ut_mouse(o, QEvent::MouseButtonPress); }
void ut_click(QObject *o) {
  ut_mouse(o, QEvent::MouseButtonPress);
  ut_mouse(o, QEvent::MouseButtonRelease);
}

// A different value of a property (the probe's rule, tools/metadata/qt/observe_probe.cpp next_any).
bool next_qvalue(const QMetaProperty &p, const QVariant &cur, QVariant &out) {
  if (p.isEnumType()) {
    QMetaEnum me = p.enumerator();
    if (p.isFlagType()) {  // toggle the first non-zero flag
      for (int i = 0; i < me.keyCount(); i++)
        if (me.value(i) != 0) {
          QVariant v(cur.toInt() ^ me.value(i));
          if (!v.convert(cur.metaType())) return false;
          out = v;
          return true;
        }
      return false;
    }
    for (int i = 0; i < me.keyCount(); i++)
      if (me.value(i) != cur.toInt()) { out = QVariant(me.value(i)); return true; }
    return false;
  }
  const auto bump = [](int v) { return v > 1000 ? v - 11 : v + 11; };
  switch (p.metaType().id()) {
    case QMetaType::Bool: out = !cur.toBool(); return true;
    case QMetaType::Int: out = cur.toInt() + 1; return true;
    case QMetaType::UInt: out = cur.toUInt() + 1; return true;
    case QMetaType::LongLong: out = cur.toLongLong() + 1; return true;
    case QMetaType::Double:
    case QMetaType::Float: {
      // c + 1 vanishes next to an infinite or huge default (QDoubleValidator::bottom is -inf): 0 and 1 follow.
      const double c = cur.toDouble();
      for (double v : {c + 1.0, 0.0, 1.0})
        if (std::isfinite(v) && v != c) {
          out = p.metaType().id() == QMetaType::Float ? QVariant(float(v)) : QVariant(v);
          return true;
        }
      return false;
    }
    case QMetaType::QString: out = cur.toString() + "x"; return true;
    case QMetaType::QColor: {
      const QColor c = cur.value<QColor>();
      out = c == QColor(10, 20, 30) ? QColor(40, 50, 60) : QColor(10, 20, 30);
      return true;
    }
    case QMetaType::QPointF: out = cur.toPointF() + QPointF(7, 5); return true;
    case QMetaType::QUrl: out = QUrl(cur.toUrl().toString() == "file:///a" ? "file:///b" : "file:///a"); return true;
    case QMetaType::QKeySequence:
      out = QKeySequence(cur.value<QKeySequence>() == QKeySequence("Ctrl+K") ? "Ctrl+J" : "Ctrl+K");
      return true;
    case QMetaType::QRect: {
      const QRect r = cur.toRect();
      out = QRect(r.x() + 7, r.y() + 5, bump(r.width()), bump(r.height()));
      return true;
    }
    case QMetaType::QRectF: {
      const QRectF r = cur.toRectF();
      out = QRectF(r.x() + 7, r.y() + 5, r.width() + 11, r.height() + 13);
      return true;
    }
    case QMetaType::QSize: {
      const QSize s = cur.toSize();
      out = QSize(bump(s.width()), bump(s.height()));
      return true;
    }
    case QMetaType::QPoint: out = cur.toPoint() + QPoint(7, 5); return true;
    case QMetaType::QFont: {
      QFont f = cur.value<QFont>();
      f.setPointSize(f.pointSize() > 0 ? f.pointSize() + 3 : 15);
      out = f;
      return true;
    }
    case QMetaType::QPalette: {
      QPalette pl = cur.value<QPalette>();
      pl.setColor(QPalette::Window, pl.color(QPalette::Window) == QColor(1, 2, 3) ? QColor(4, 5, 6) : QColor(1, 2, 3));
      out = pl;
      return true;
    }
    case QMetaType::QCursor:
      out = QCursor(cur.value<QCursor>().shape() == Qt::CrossCursor ? Qt::ArrowCursor : Qt::CrossCursor);
      return true;
    case QMetaType::QLocale:
      out = QLocale(cur.toLocale().language() == QLocale::German ? QLocale::French : QLocale::German);
      return true;
    case QMetaType::QSizePolicy: {
      QSizePolicy sp = cur.value<QSizePolicy>();
      sp.setHorizontalPolicy(sp.horizontalPolicy() == QSizePolicy::Fixed ? QSizePolicy::Expanding : QSizePolicy::Fixed);
      out = QVariant::fromValue(sp);
      return true;
    }
    default: return false;
  }
}
int changed_count(svl_handle h, svl_id p) {
  return static_cast<int>(std::count(changed.begin(), changed.end(), std::make_pair(h, p)));
}
QMetaProperty qprop(QObject *o, const char *name) {
  const int i = name ? o->metaObject()->indexOfProperty(name) : -1;
  return i < 0 ? QMetaProperty() : o->metaObject()->property(i);
}
// One native change: write the next value of `name`, or run `act`. False when neither is possible.
bool native_change(QObject *o, const char *name, void (*act)(QObject *)) {
  if (act) {
    act(o);
  } else {
    const QMetaProperty mp = qprop(o, name);
    QVariant nv;
    if (!mp.isValid() || !next_qvalue(mp, mp.read(o), nv) || !mp.write(o, nv)) return false;
  }
  QCoreApplication::processEvents();
  return true;
}
// A fresh subject of an observe row (an element or a constructed type), with the row's setup run on it.
svl_handle obs_subject(const ObserveRow &r) {
  svl_handle h = 0;
  if (r.type) {
    svl_value out{};
    if (!K(r.kind) || B->construct(B->self, K(r.kind), nullptr, nullptr, 0, &out) != 0 || out.tag != SVL_HANDLE) return 0;
    h = out.u.h;
  } else {
    h = mk(r.kind);
  }
  if (h && r.setup && O(h)) {
    r.setup(O(h));
    QCoreApplication::processEvents();
  }
  return h;
}
bool tt_observe(const ObserveRow &r, std::string &why) {
  const svl_handle h = obs_subject(r);
  CHECK(h != 0);
  const svl_id p = (r.flags & OB_META) ? svl_qt_meta_prop_id(r.native) : P(r.kind, r.js);
  CHECK(p != 0);
  QObject *o = O(h);
  CHECK(o);
  size_t filters0 = 0;
  const size_t obs0 = svl_qt_observations(&filters0);
  changed.clear();
  const int rc = B->observe(B->self, h, p, true);
  if (r.check == OC_REFUSED || r.check == OC_UNSUPPORTED) {
    CHECK(rc == (r.check == OC_REFUSED ? -1 : SVL_OBSERVE_UNSUPPORTED));
    if (r.trigger) {  // a verified `none`: the change happens, and nothing on the metaobject could announce it
      const QMetaProperty mp = qprop(o, r.native);
      CHECK(mp.isValid() && !mp.hasNotifySignal() && !mp.isBindable());
      const QVariant before = mp.read(o);
      CHECK(native_change(o, r.trigger, nullptr));
      CHECK(mp.read(o) != before);
      CHECK(changed_count(h, p) == 0);
    }
    B->destroy(B->self, h);
    return true;
  }
  CHECK(rc == 0);
  CHECK(svl_qt_observations(nullptr) == obs0 + 1);
  if (r.check == OC_CONNECT) {
    CHECK(B->observe(B->self, h, p, false) == 0);
    CHECK(svl_qt_observations(nullptr) == obs0);
    B->destroy(B->self, h);
    return true;
  }
  const QMetaProperty mp = qprop(o, r.native);
  auto *w = qobject_cast<QWidget *>(o);
  const char *wname = r.check == OC_CHANGE ? r.native : r.trigger;
  changed.clear();
  QVariant before = mp.isValid() ? mp.read(o) : QVariant();
  if (r.flags & OB_DEFERRED) {
    // Qt sends Resize/Move to a hidden widget only when it is shown: the change is announced then (timing deferred).
    CHECK(w && !w->isVisible());
    CHECK(native_change(o, wname, r.act));
    CHECK(changed_count(h, p) == 0);
    w->show();
    QCoreApplication::processEvents();
    CHECK(changed_count(h, p) >= 1);
    changed.clear();
    before = mp.isValid() ? mp.read(o) : QVariant();
  }
  CHECK(native_change(o, wname, r.act));
  if (mp.isValid() && mp.isReadable()) CHECK(mp.read(o) != before);  // the native change changed it
  const int n = changed_count(h, p);
  if (r.check == OC_SILENT) {
    CHECK(n == 0);  // the fact: this change is not announced
  } else {
    CHECK(n >= 1);  // announced
    if (r.check == OC_CHANGE) {
      changed.clear();
      CHECK(mp.write(o, mp.read(o)));  // an identical set
      QCoreApplication::processEvents();
      const int same = changed_count(h, p);
      if (r.fires == OF_ON_CHANGE) CHECK(same == 0);
      if (r.fires == OF_ON_SET) CHECK(same > 0);
    }
    if (!r.act || r.check == OC_CHANGE) {
      // Coalescing (backend side): 10 native changes between two checkpoints leave one dirty (handle, prop).
      changed.clear();
      for (int i = 0; i < 10; i++) CHECK(native_change(o, wname, nullptr));
      CHECK(!changed.empty());
      for (const auto &c : changed) CHECK(c == std::make_pair(h, p));
    }
  }
  if (r.user) {
    // The user path, on a fresh instance: what a user does (key or mouse events) is announced as well.
    const svl_handle hu = obs_subject(r);
    CHECK(hu != 0);
    QObject *ou = O(hu);
    if (auto *wu = qobject_cast<QWidget *>(ou)) {
      wu->show();
      QCoreApplication::processEvents();
    }
    CHECK(B->observe(B->self, hu, p, true) == 0);
    const QVariant u0 = mp.isValid() ? mp.read(ou) : QVariant();
    changed.clear();
    r.user(ou);
    QCoreApplication::processEvents();
    if (mp.isValid()) CHECK(mp.read(ou) != u0);
    CHECK(changed_count(hu, p) >= 1);
    CHECK(B->observe(B->self, hu, p, false) == 0);
    B->destroy(B->self, hu);
    flush();
  }
  if ((r.flags & OB_PROPORTIONAL) && !r.type && r.js[0]) {
    // Echo of a proportional (whole-text) property: our own set_prop is not reported (§5.4).
    changed.clear();
    svl_value v{};
    v.tag = SVL_STR;
    v.u.s.ptr = "echo";
    v.u.s.len = 4;
    CHECK(B->set_prop(B->self, h, p, &v) == 0);
    QCoreApplication::processEvents();
    CHECK(changed_count(h, p) == 0);
  }
  CHECK(B->observe(B->self, h, p, false) == 0);
  size_t filters1 = 0;
  CHECK(svl_qt_observations(&filters1) == obs0);
  CHECK(filters1 == filters0);  // the event filter went with the last event-based observation
  changed.clear();
  native_change(o, wname, r.act);
  CHECK(changed_count(h, p) == 0);  // unobserved: silent
  CHECK(B->observe(B->self, h, p, true) == 0);
  B->destroy(B->self, h);  // destroyed while observed: the observation goes with it
  flush();
  CHECK(svl_qt_observations(nullptr) == obs0);
  CHECK(B->observe(B->self, h, p, true) < 0);
  return true;
}

// Pins REACTIVITY.md §5.5: a QPropertyNotifier may be destroyed after the object whose property it watches (the
// backend's order on native death). The property's binding data unlinks its observers when it is destroyed.
bool t_observe_runtime_bindable_notifier_outlives_object(std::string &why) {
  int calls = 0;
  auto *t = new QTimer;
  QUntypedBindable b = t->metaObject()->property(t->metaObject()->indexOfProperty("interval")).bindable(t);
  CHECK(b.isValid());
  auto n = std::make_unique<QPropertyNotifier>(b.addNotifier([&calls] { calls++; }));
  t->setInterval(5);
  CHECK(calls == 1);
  delete t;
  n.reset();  // after its object: must not touch freed memory (run under ASan in the R3 record)
  // And through the backend: a QTimer handle observed by its bindable, destroyed while observed.
  svl_value out{};
  CHECK(B->construct(B->self, K("QTimer"), nullptr, nullptr, 0, &out) == 0 && out.tag == SVL_HANDLE);
  const svl_handle h = out.u.h;
  const svl_id p = P("QTimer", "interval");
  CHECK(B->observe(B->self, h, p, true) == 0);
  changed.clear();
  static_cast<QTimer *>(O(h))->setInterval(7);
  CHECK(changed_count(h, p) == 1);
  delete O(h);  // native death: the backend drops the notifier in the `destroyed` slot
  flush();
  CHECK(B->observe(B->self, h, p, true) < 0);
  return true;
}

template <class Row>
int run_rows(const Row *rows, bool (*fn)(const Row &, std::string &), int &count) {
  int failures = 0;
  for (const Row *r = rows; r->name; ++r) {
    rec.clear();
    reply = Reply::Busy;
    sync_calls.clear();
    frames = 0;
    std::string why;
    bool ok = fn(*r, why);
    flush();
    count++;
    if (ok) {
      std::printf("ok   %s\n", r->name);
    } else {
      std::printf("FAIL %s: %s (backend: %s)\n", r->name, why.c_str(), B->last_error(B->self));
      failures++;
    }
  }
  return failures;
}
// ---- end table-driven tests ----------------------------------------------------------------------------------

//@@TESTS@@
//@@ROW_TABLES@@

const TestCase kTests[] = {
    {"runtime/stale_handles_error", t_runtime_stale_handles_error},
    {"observe_runtime/bindable_notifier_outlives_object", t_observe_runtime_bindable_notifier_outlives_object},
    {"runtime/host_destroy_is_silent", t_runtime_host_destroy_is_silent},
    {"runtime/native_destroy_notifies_host", t_runtime_native_destroy_notifies_host},
    {"runtime/parent_destroy_notifies_children", t_runtime_parent_destroy_notifies_children},
    {"runtime/handle_info_and_idempotent_destroy", t_runtime_handle_info_and_idempotent_destroy},
    {"runtime/uncontrolled_close_cascades", t_runtime_uncontrolled_close_cascades},
    {"runtime/controlled_close_is_vetoed", t_runtime_controlled_close_is_vetoed},
    {"runtime/close_handler_decides_through_call_sync", t_runtime_close_handler_decides_through_call_sync},
    {"runtime/key_press_handler_consumes_the_key", t_runtime_key_press_handler_consumes_the_key},
    {"runtime/mouse_press_handler_consumes_and_reports_a_point", t_runtime_mouse_press_handler_consumes_and_reports_a_point},
    {"runtime/other_event_families_deliver_their_payloads", t_runtime_other_event_families_deliver_their_payloads},
    {"runtime/capture_reaches_descendant_mouse_press_first", t_runtime_capture_reaches_descendant_mouse_press_first},
    {"runtime/canvas_replays_ops_into_pixels", t_runtime_canvas_replays_ops_into_pixels},
    {"runtime/listen_after_runs_behind_plain", t_runtime_listen_after_runs_behind_plain},
    {"runtime/listen_phase_refusals", t_runtime_listen_phase_refusals},
    {"runtime/capture_reaches_descendant_key_before_its_own_listener", t_runtime_capture_reaches_descendant_key_before_its_own_listener},
    {"runtime/request_frame_delivers_once_per_request", t_runtime_request_frame_delivers_once_per_request},
    {"runtime/wake_queues_checkpoint", t_runtime_wake_queues_checkpoint},
    {"runtime/wrong_value_type_is_error", t_runtime_wrong_value_type_is_error},
//@@TEST_TABLE@@
};

}  // namespace

extern "C" int svl_qt_verify_run(void) {
  B = svl_qt_backend();
  svl_qt_set_host(&kHost);
  // The backend creates the QApplication lazily; force it before touching Qt directly.
  svl_handle warm = B->create(B->self, K("@@ANY_TAG@@"));
  B->destroy(B->self, warm);
  int failures = 0;
  for (const TestCase &t : kTests) {
    rec.clear();
    reply = Reply::Busy;
    sync_calls.clear();
    frames = 0;
    std::string why;
    bool ok = t.fn(why);
    flush();
    if (ok) {
      std::printf("ok   %s\n", t.name);
    } else {
      std::printf("FAIL %s: %s (backend: %s)\n", t.name, why.c_str(), B->last_error(B->self));
      failures++;
    }
  }
  int count = static_cast<int>(sizeof(kTests) / sizeof(kTests[0]));
  failures += run_rows(kPropRows, tt_prop, count);
  failures += run_rows(kMethodRows, tt_method, count);
  failures += run_rows(kSignalRows, tt_signal, count);
  failures += run_rows(kEmitRows, tt_emit, count);
  failures += run_rows(kBindingRows, tt_binding, count);
  failures += run_rows(kObserveRows, tt_observe, count);
  std::printf("%d tests, %d failed\n", count, failures);
  std::fflush(stdout);
  return failures;
}
