#!/usr/bin/env bash
# Runs a cargo command in one of a few machine-wide build slots, so parallel agents queue for the
# CPU instead of all compiling at once on a few cores each.
#
#   tools/dev/cargo-slot cargo nextest run --workspace
#   tools/dev/cargo-slot xvfb-run -a cargo nextest run -p counter
#
# The slots are shared by every repo on the machine (svelters, cadatomic, cadabra3, ...): any
# wrapper that takes ${XDG_RUNTIME_DIR:-/tmp}/build-slots/slot-<n>.lock (n = 1..BUILD_SLOTS) with
# flock joins the same pool. Test runs need only a slot; there is no other machine-wide lock.
#
# Slot count and cores per slot, first match wins:
#   SVELTERS_SLOTS / SVELTERS_SLOT_JOBS (env), BUILD_SLOTS / BUILD_SLOT_JOBS (env),
#   ~/.config/build-slots.env (per machine, same two BUILD_ names), defaults 2 and 6.
# CARGO_BUILD_JOBS and NEXTEST_TEST_THREADS are set from the cores unless already set. The build
# dir is per checkout (target/build), as .cargo/config.toml already says; sccache shares compiled
# deps across them. macOS needs a flock binary (brew install flock).
set -euo pipefail

# Deadlock rules (every wrapper on the machine follows them):
# 1. A command holds at most one slot. A nested call (a script that calls cargo-slot again, or
#    cadatomic's cargo.sh from inside a slot) sees BUILD_SLOT_HELD and runs without a second slot.
# 2. There is no other machine-wide lock: test runs need only a slot.
# 3. A repo-level lock (cadatomic's .build.lock) is only ever taken before a slot, never while
#    holding one.
if [ -n "${BUILD_SLOT_HELD:-}" ]; then
  exec "$@"
fi

# `cargo check`/`clippy` (and other non-building subcommands) take no slot: they are short and
# metadata-only, and an agent waiting behind someone's 20-minute test build for a type check is an
# agent not writing code. They run niced with few jobs so builds in the slots keep the CPU.
if [ "${1:-}" = cargo ] && [[ "${2:-}" =~ ^(check|clippy|fmt|metadata|tree|locate-project)$ ]]; then
  export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-${CHECK_JOBS:-3}}
  export CARGO_BUILD_BUILD_DIR=${CARGO_BUILD_BUILD_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)/target/build}
  exec nice -n 10 "$@"
fi

env_slots=${BUILD_SLOTS:-} env_jobs=${BUILD_SLOT_JOBS:-}
conf=${XDG_CONFIG_HOME:-$HOME/.config}/build-slots.env
if [ -f "$conf" ]; then
  # shellcheck disable=SC1090
  . "$conf"
fi
slots=${SVELTERS_SLOTS:-${env_slots:-${BUILD_SLOTS:-2}}}
jobs=${SVELTERS_SLOT_JOBS:-${env_jobs:-${BUILD_SLOT_JOBS:-6}}}
dir=${XDG_RUNTIME_DIR:-/tmp}/build-slots
mkdir -p "$dir"

waited=0
while :; do
  for i in $(seq 1 "$slots"); do
    exec {fd}>"$dir/slot-$i.lock"
    if flock -n "$fd"; then
      [ "$waited" -gt 0 ] && echo "cargo-slot: got slot $i after ${waited}s" >&2
      export BUILD_SLOT_HELD=$i
      export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-$jobs}
      export NEXTEST_TEST_THREADS=${NEXTEST_TEST_THREADS:-$jobs}
      # Anchored to the checkout root: a relative path is resolved from the cwd, so running from a
      # crate directory put a build dir (and untracked artifacts) inside the crate.
      export CARGO_BUILD_BUILD_DIR=${CARGO_BUILD_BUILD_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)/target/build}
      # A sccache server spawned by the build would inherit the lock fd and hold the slot for its
      # whole lifetime, long after the build ends. Start it here with the fd closed (no-op when
      # one is already running).
      if [[ "${RUSTC_WRAPPER:-}" == *sccache* ]]; then
        "$RUSTC_WRAPPER" --start-server {fd}>&- >/dev/null 2>&1 || true
      fi
      # The lock fd is inherited by the command and released when it exits.
      exec "$@"
    fi
    exec {fd}>&-
  done
  [ "$waited" -eq 0 ] && echo "cargo-slot: all $slots slots busy, waiting" >&2
  sleep 5
  waited=$((waited + 5))
done
