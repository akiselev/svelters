  "notes": {
    "shadow-color": "widget.shadow and scrollbar.shadow are null in hcLight: High Contrast has no shadows (DESIGN.md R7).",
    "button-border": "button.border has no registry default; HC buttons are outlined with contrastBorder.",
    "button2-hover": "button.secondaryHoverBackground, toolbar.*Background, list.dropBackground and menu.selectionBackground are null in hcLight; derived from list.hoverBackground (DS3 adds VS Code's contrastActiveBorder outlines).",
    "list-sel-fg": "list.activeSelectionForeground is null in hcLight: the foreground.",
    "tab-bg": "tab.inactiveBackground and tab.activeBackground are unset in hcLight: the editor background.",
    "elev-0": "No shadows in High Contrast (DESIGN.md §2.5, R7)."
