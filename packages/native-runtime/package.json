{
  "name": "@svelters/native-runtime",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Runtime for components compiled by the svelters compiler (svelters-compile): host ops, blocks, styling and lists over Svelte's signals",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./core/tracing": "./src/core/tracing.js",
    "./svelte": "./src/svelte.js",
    "./embed": { "types": "./types/embed.d.ts", "default": "./src/embed.js" },
    "./transition": "./src/transition.js",
    "./animate": "./src/animate.js",
    "./lists": "./src/lists.js",
    "./style": { "types": "./src/style.d.ts", "default": "./src/style.js" },
    "./bindings": "./src/bindings.generated.js",
    "./types": { "types": "./types/index.d.ts" },
    "./vite": "./vite.js"
  },
  "dependencies": {
    "@svelters/style": "workspace:*",
    "@svelters/types": "workspace:*",
    "esm-env": "^1.2.2",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@svelters/testhost": "workspace:*",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "test": "node ../../tools/check-svelte-internals.mjs && node --import ./test/register.mjs --test test/*.test.mjs && pnpm run check",
    "check": "svelte-check --workspace check --tsconfig ./tsconfig.json --threshold error --diagnostic-sources js"
  }
}
