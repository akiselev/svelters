{
  "name": "@svelters/native-runtime",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Runtime for components compiled by the svelters compiler (svelters-compile): host ops, blocks, styling and lists over Svelte's signals",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./core/tracing": "./src/core/tracing.js",
    "./svelte": "./src/svelte.js",
    "./embed": { "types": "./types/embed.d.ts", "default": "./src/embed.js" },
    "./intl": { "types": "./types/intl.d.ts", "default": "./src/intl.js" },
    "./clipboard": { "types": "./types/clipboard.d.ts", "default": "./src/clipboard.js" },
    "./shell": { "types": "./types/shell.d.ts", "default": "./src/shell.js" },
    "./platform": { "types": "./types/platform.d.ts" },
    "./transition": "./src/transition.js",
    "./animate": "./src/animate.js",
    "./lists": "./src/lists.js",
    "./style": { "types": "./src/style.d.ts", "default": "./src/style.js" },
    "./bindings": "./src/bindings.generated.js",
    "./types": { "types": "./types/index.d.ts" },
    "./types/egui": { "types": "./types/egui.d.ts" },
    "./assets": { "types": "./types/assets.d.ts" },
    "./vite": "./vite.js"
  },
  "svelters": {
    "aliases": {
      "svelte": "./src/svelte.js",
      "svelte/transition": "./src/transition.js",
      "svelte/animate": "./src/animate.js",
      "svelte/index-client": "svelte/src/index-client.js",
      "svelte/internal/client/reactivity/effects": "svelte/src/internal/client/reactivity/effects.js",
      "svelte/internal/client/reactivity/async": "svelte/src/internal/client/reactivity/async.js",
      "svelte/internal/client/reactivity/batch": "svelte/src/internal/client/reactivity/batch.js",
      "svelte/internal/client/dom/task": "svelte/src/internal/client/dom/task.js",
      "svelte/internal/client/context": "svelte/src/internal/client/context.js",
      "svelte/internal/client/dev/equality": "svelte/src/internal/client/dev/equality.js",
      "svelte/internal/client/loop": "svelte/src/internal/client/loop.js",
      "svelte/internal/client/render": "svelte/src/internal/client/render.js",
      "svelte/internal/client/constants": "svelte/src/internal/client/constants.js",
      "svelte/internal/flags/index": "svelte/src/internal/flags/index.js",
      "@svelters/native-runtime": "./src/index.js",
      "@svelters/native-runtime/core": "./src/core/index.js",
      "@svelters/native-runtime/core/tracing": "./src/core/tracing.js",
      "@svelters/native-runtime/style": "./src/style.js",
      "@svelters/native-runtime/embed": "./src/embed.js",
      "@svelters/native-runtime/intl": "./src/intl.js",
      "svelters:embed": "./src/embed.js",
      "svelters:intl": "./src/intl.js",
      "@svelters/native-runtime/clipboard": "./src/clipboard.js",
      "svelters:clipboard": "./src/clipboard.js",
      "@svelters/native-runtime/shell": "./src/shell.js",
      "svelters:shell": "./src/shell.js",
      "@svelters/lists": "./src/lists.js",
      "@svelters/native-runtime/lists": "./src/lists.js",
      "svelters:gtk/*": "@svelters/types/gtk/*/index.js",
      "svelters:qt/*": "@svelters/types/qt/*/index.js",
      "svelters:appkit/*": "@svelters/types/appkit/*/index.js",
      "svelters:winui/*": "@svelters/types/winui/*/index.js"
    }
  },
  "dependencies": {
    "@svelters/style": "workspace:*",
    "@svelters/types": "workspace:*",
    "esm-env": "^1.2.2",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@svelters/testhost": "workspace:*",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "test": "node ../../tools/check-svelte-internals.mjs && node --import ./test/register.mjs --test test/*.test.mjs && pnpm run check",
    "check": "svelte-check --workspace check --tsconfig ./tsconfig.json --threshold error --diagnostic-sources js"
  }
}
