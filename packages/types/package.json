{
  "name": "@svelters/types",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Native object model and generated non-UI types (svelters:gtk/gio, svelters:qt/core, ...) for Svelters apps",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./src/core.d.ts",
      "default": "./src/core.js"
    },
    "./vite": "./vite.js",
    "./manifest": "./gtk/manifest.json",
    "./manifest-qt": "./qt/manifest.json",
    "./gtk/glib": {
      "types": "./gtk/glib.d.ts",
      "default": "./gtk/glib/index.js"
    },
    "./gtk/gobject": {
      "types": "./gtk/gobject.d.ts",
      "default": "./gtk/gobject/index.js"
    },
    "./gtk/gdk": {
      "types": "./gtk/gdk.d.ts",
      "default": "./gtk/gdk/index.js"
    },
    "./gtk/gio": {
      "types": "./gtk/gio.d.ts",
      "default": "./gtk/gio/index.js"
    },
    "./gtk/graphene": {
      "types": "./gtk/graphene.d.ts",
      "default": "./gtk/graphene/index.js"
    },
    "./gtk/gsk": {
      "types": "./gtk/gsk.d.ts",
      "default": "./gtk/gsk/index.js"
    },
    "./gtk/gtk": {
      "types": "./gtk/gtk.d.ts",
      "default": "./gtk/gtk/index.js"
    },
    "./gtk/pango": {
      "types": "./gtk/pango.d.ts",
      "default": "./gtk/pango/index.js"
    },
    "./qt/core": {
      "types": "./qt/core.d.ts",
      "default": "./qt/core/index.js"
    },
    "./qt/gui": {
      "types": "./qt/gui.d.ts",
      "default": "./qt/gui/index.js"
    },
    "./qt/widgets": {
      "types": "./qt/widgets.d.ts",
      "default": "./qt/widgets/index.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && tsc -p test/types/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "8.3.4"
  }
}
