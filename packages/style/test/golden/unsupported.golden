=== gtk ===
.a.svelte-unsupported {
  color: red;
}
.x.svelte-unsupported + .y.svelte-unsupported {
  color: green;
}
.x.svelte-unsupported ~ .y.svelte-unsupported {
  color: green;
}
.b.svelte-unsupported {
  background-color: oklch(0.6 0.1 250);
  color: #123;
}
.b.svelte-unsupported {
  box-shadow: 0 1px 2px #000;
  transition: color 150ms;
}
.b.svelte-unsupported {
  --local: 1px;
  padding: calc(1px + 2px);
  margin: var(--other);
}
.x.svelte-unsupported:first-child {
  color: #111;
}
.y.svelte-unsupported:focus-visible {
  color: #222;
}
.a.svelte-unsupported {
  opacity: 0.8;
  font-family: serif;
  background: linear-gradient(red, blue);
}
checkbutton.cb.svelte-unsupported {
  color: #444;
}
window.sv-k-window.w.svelte-unsupported {
  color: var(--sv-unknown);
}
@keyframes svelte-unsupported-pulse { from { color: red; } to { color: blue; } }
@media (prefers-reduced-motion: reduce) {
.a.svelte-unsupported {
  color: red;
}
}

=== qt ===
.a.svelte-unsupported {
  color: red;
}
.b.svelte-unsupported {
  color: #123;
}
.y.svelte-unsupported:focus {
  color: #222;
}
.a.svelte-unsupported {
  font-family: serif;
}
.QMainWindow.w.svelte-unsupported {
  color: ${--sv-unknown};
}

=== qt dark ===

