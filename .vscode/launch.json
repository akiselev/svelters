{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug",
            "program": "${workspaceFolder}/target/debug/svelters",
            "preLaunchTask": "build",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "QUICKJS_DEBUG_ADDRESS",
                    "value": "127.0.0.1:5555"
                },
                {
                    "name": "RUST_BACKTRACE",
                    "value": "1",
                }
            ],
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Release",
            "program": "${workspaceFolder}/target/release/svelters",
            "args": [],
            "externalConsole": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "QUICKJS_DEBUG_ADDRESS",
                    "value": "127.0.0.1:5555"
                }
            ],
        },
        {
            "type": "quickjs",
            "request": "launch",
            "name": "Launch QuickJS",
            "runtimeExecutable": "${workspaceFolder}/target/debug/svelters",
            "windows": {
                "runtimeExecutable": "${workspaceFolder}/target/debug/svelters.exe"
            },
            // "trace": true,
            "program": "${workspaceFolder}/test.js"
        },
        {
            "type": "quickjs",
            "request": "attach",
            "name": "Attach QuickJS",
            "localRoot": "${workspaceFolder}/",
            "mode": "listen",
            "port": 5555
        }
    ]
}