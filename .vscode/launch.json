{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug",
            "program": "${workspaceFolder}/target/debug/svelters",
            "preLaunchTask": "build",
            "args": [],
            "externalConsole": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "QUICKJS_DEBUG_ADDRESS",
                    "value": "127.0.0.1:5555"
                },
                {
                    "name": "RUST_BACKTRACE",
                    "value": "1",
                }
            ],
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Release",
            "program": "${workspaceFolder}/target/release/svelters",
            "args": [],
            "externalConsole": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "QUICKJS_DEBUG_ADDRESS",
                    "value": "127.0.0.1:5555"
                }
            ],
        },
        {
            "name": "Launch QuickJS",
            "type": "quickjs",
            "request": "launch",
			"mode": "listen",
            "port": 5555,
            "cwd": "${workspaceFolder}",
            "localRoot": "${workspaceFolder}/",
            "program": "${workspaceFolder}/dist/index.js",
			"runtimeExecutable": "${workspaceFolder}/target/debug/svelters",
            "console": "externalTerminal"
        },
        {
            "name": "Attach QuickJS (connect)",
            "type": "quickjs",
            "request": "launch",
			"mode": "connect",
			"attach": true,
            "port": 5555,
            "localRoot": "${workspaceFolder}/",
            "program": "${workspaceFolder}/dist/index.js",
			"runtimeExecutable": "${workspaceFolder}/target/debug/svelters",
        },
        {
            "name": "Attach QuickJS",
            "type": "quickjs",
            "request": "launch",
			"attach": true,
            "port": 5555,
            "program": "${workspaceFolder}/dist/index.js",
            "localRoot": "${workspaceFolder}/dist/",
			"runtimeExecutable": "${workspaceFolder}/target/debug/svelters",
        }
    ]
}