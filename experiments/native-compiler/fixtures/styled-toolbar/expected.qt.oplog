set #5 minimum-height 30
set #5 text "Plain"
insert #2 #5 before=end slot=default
insert #1 #2 before=end slot=default
set #4 minimum-height 24
listen #4 clicked on
call #1 present []
style #1 classes "svelte-2188395467"
