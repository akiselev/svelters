create window #1
set #1 title "Binding"
create box #2
set #2 orientation "vertical"
set #2 spacing 6
create entry #3
set #3 placeholder-text "Your name"
insert #2 #3 before=end slot=default
create label #4
insert #2 #4 before=end slot=default
create button #5
set #5 label "Clear"
insert #2 #5 before=end slot=default
create button #6
set #6 label "Shout"
insert #2 #6 before=end slot=default
insert #1 #2 before=end slot=default
set #4 label "Nobody (0 edits)"
listen #3 changed on
set #3 text ""
observe #3 text on
listen #5 clicked on
listen #6 clicked on
call #1 present []
event #3 changed ["Ada"]
set #4 label "Nobody (1 edits)"
event #3 changed ["Ada"]
set #4 label "Nobody (2 edits)"
event #6 clicked []
event #3 changed ["ADA"]
set #4 label "Nobody (3 edits)"
event #5 clicked []
