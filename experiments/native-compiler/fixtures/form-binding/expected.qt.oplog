create window #1
set #1 title "Binding"
create box #2
set #2 orientation "vertical"
set #2 spacing 6
create entry #3
set #3 placeholder "Your name"
set #3 text ""
listen #3 changed on
insert #2 #3 before=end slot=default
create label #4
set #4 label "Nobody (0 edits)"
insert #2 #4 before=end slot=default
create button #5
listen #5 clicked on
set #5 label "Clear"
insert #2 #5 before=end slot=default
create button #6
listen #6 clicked on
set #6 label "Shout"
insert #2 #6 before=end slot=default
insert #1 #2 before=end slot=default
call #1 present []
event #3 changed ["Ada"]
set #4 label "Hello Ada (1 edits)"
event #3 changed ["Ada"]
set #4 label "Hello Ada (2 edits)"
event #6 clicked []
set #3 text "ADA"
set #4 label "Hello ADA (2 edits)"
event #3 changed ["ADA"]
set #4 label "Hello ADA (3 edits)"
event #5 clicked []
set #3 text ""
set #4 label "Nobody (3 edits)"
