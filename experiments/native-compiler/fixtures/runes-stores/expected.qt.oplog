create main-window #1
set #1 window-title "Stores"
create box-layout #2
set #2 direction "top-to-bottom"
set #2 spacing 4
create label #3
insert #2 #3 before=end slot=default
create push-button #4
set #4 text "Inc"
insert #2 #4 before=end slot=default
create push-button #5
set #5 text "Triple"
insert #2 #5 before=end slot=default
create push-button #6
set #6 text "Shout"
insert #2 #6 before=end slot=default
create push-button #7
set #7 text "Reset"
insert #2 #7 before=end slot=default
insert #1 #2 before=end slot=default
set #3 text "1 x2=2 Ada"
listen #4 clicked on
listen #5 clicked on
listen #6 clicked on
listen #7 clicked on
call #1 present []
event #4 clicked []
set #3 text "2 x2=4 Ada"
event #5 clicked []
set #3 text "6 x2=12 Ada"
event #6 clicked []
set #3 text "6 x2=12 Ada!"
event #7 clicked []
set #3 text "0 x2=0 Ada!"
