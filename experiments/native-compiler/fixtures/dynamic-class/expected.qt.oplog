create main-window #1
set #1 window-title "Classes"
create box-layout #2
set #2 spacing 8
set #2 direction "left-to-right"
create push-button #3
set #3 minimum-height 36
set #3 text "Save"
insert #2 #3 before=end slot=default
create push-button #4
set #4 text "Other"
insert #2 #4 before=end slot=default
create push-button #5
listen #5 clicked on
set #5 text "Mode"
insert #2 #5 before=end slot=default
create push-button #6
listen #6 clicked on
set #6 text "Dense"
insert #2 #6 before=end slot=default
insert #1 #2 before=end slot=default
call #1 present []
style sheet "*" null
style scheme "light" 9
style #2 classes "toolbar"
style #3 classes "primary"
style #4 classes "big"
event #5 clicked []
set #3 minimum-height 0
set #4 minimum-height 36
style #3 classes "plain"
style #4 classes "big primary"
event #6 clicked []
set #2 spacing 2
set #4 minimum-height 20
style #2 classes "toolbar dense"
style #4 classes "big primary dense"
event #5 clicked []
set #3 minimum-height 36
style #3 classes "primary"
style #4 classes "big dense"
