create window #1
set #1 title "Classes"
create box #2
create button #3
set #3 label "Save"
insert #2 #3 before=end slot=default
create button #4
set #4 label "Other"
insert #2 #4 before=end slot=default
create button #5
set #5 label "Mode"
insert #2 #5 before=end slot=default
create button #6
set #6 label "Dense"
insert #2 #6 before=end slot=default
insert #1 #2 before=end slot=default
set #2 spacing 8
set #3 height-request 36
listen #5 clicked on
listen #6 clicked on
call #1 present []
style sheet "*" null
style scheme "light" 0
style sheet "@tokens" ":root {\n  --sv-bg: #f6f5f4;\n  --sv-fg: #2e3436;\n  --sv-surface: #ffffff;\n  --sv-border: #cdc7c2;\n  --sv-accent: #3584e4;\n  --sv-accent-hover: #1c71d8;\n  --sv-accent-fg: #ffffff;\n  --sv-muted: #77767b;\n  --sv-danger: #c01c28;\n  --sv-radius: 6px;\n  --sv-space-1: 4px;\n  --sv-space-2: 8px;\n  --sv-space-3: 12px;\n  --sv-space-4: 16px;\n  --sv-font-size: 11pt;\n  --sv-font-family: sans-serif;\n}\n"
style #2 classes "toolbar"
style #3 classes "primary"
style #4 classes "big"
event #5 clicked []
set #3 height-request -1
set #4 height-request 36
style #3 classes "plain"
style #4 classes "big primary"
event #6 clicked []
set #2 spacing 2
set #4 height-request 20
style #2 classes "toolbar dense"
style #4 classes "big primary dense"
event #5 clicked []
set #3 height-request 36
style #3 classes "primary"
style #4 classes "big dense"
