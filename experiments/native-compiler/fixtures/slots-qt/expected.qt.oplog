create window #1
set #1 title "Main window"
create box #2
set #2 orientation "vertical"
create label #3
set #3 label "Clicked 0 times"
insert #2 #3 before=end slot=default
create button #4
listen #4 clicked on
set #4 label "Click"
insert #2 #4 before=end slot=default
insert #1 #2 before=end slot=default
create statusbar #5
insert #1 #5 before=end slot=statusbar
call #1 present []
event #4 clicked []
set #3 label "Clicked 1 times"
