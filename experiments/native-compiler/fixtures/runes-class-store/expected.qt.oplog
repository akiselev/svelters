create main-window #1
set #1 window-title "Todos"
create box-layout #2
set #2 direction "top-to-bottom"
set #2 spacing 4
create label #3
set #3 text "Todos: 0/0 left (next #1)"
insert #2 #3 before=end slot=default
create push-button #4
listen #4 clicked on
set #4 text "Add"
insert #2 #4 before=end slot=default
create push-button #5
listen #5 clicked on
set #5 text "Toggle first"
insert #2 #5 before=end slot=default
create push-button #6
listen #6 clicked on
set #6 text "Rename"
insert #2 #6 before=end slot=default
insert #1 #2 before=end slot=default
call #1 present []
event #4 clicked []
set #3 text "Todos: 1/1 left (next #2)"
event #4 clicked []
set #3 text "Todos: 2/2 left (next #3)"
event #5 clicked []
set #3 text "Todos: 1/2 left (next #3)"
event #6 clicked []
set #1 window-title "Todos!"
set #3 text "Todos!: 1/2 left (next #3)"
