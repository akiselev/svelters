{
 "note": "Expected rejections: samples that need a feature outside the native language subset or the native design. Read by run.mjs for the score only; they are never counted as passes. A listed sample counts as expected only while it fails the way `match` says (compile reasons or runtime message, regexes); otherwise run.mjs reports it as stale and it counts as failing. Do not list a sample that fails for a fixable reason.",
 "categories": {
  "spread": {"why": "spread attributes on native elements are rejected: props, events and value types are resolved against the backend spec at compile time", "ref": "docs/notes/native-compiler/runtime-contract.md \"Spread attributes\"; language-subset.md \"Native template attributes\" (`native_spread_unsupported`)", "match": {"reasons": ["^native_spread_unsupported$"]}},
  "transition": {"why": "`transition:`, `in:`, `out:` and `animate:` are forbidden on native widgets", "ref": "docs/notes/svelte-feature-survey.md §8; docs/notes/custom-renderer-trial.md \"Other forbidden features\"", "match": {"reasons": ["^unsupported_feature: (transitions|animate: directives)$"]}},
  "svelte-element": {"why": "`<svelte:element this>` is a dynamic tag, so its kind and attributes cannot be checked against the spec at compile time (the spread rationale)", "ref": "docs/site/src/content/docs/guides/svelte-support.md \"Components and special elements\" (error); runtime-contract.md \"Spread attributes\"", "match": {"reasons": ["^unsupported_feature: this svelte: element$"]}},
  "foreign-element": {"why": "SVG, MathML, custom elements, `<script>` and unknown HTML tags are not kinds of the backend spec (no DOM namespaces, no custom elements)", "ref": "docs/notes/native-compiler/language-subset.md (`$host()`: no custom elements); semantic-spec.md (elements are the spec's kinds)", "match": {"reasons": ["^unknown_element: (svg|g|line|text|math|mrow|script|o|custom-element|my-element|my-thing|my-custom-element|value-element|applied-to-custom-element)$"]}},
  "legacy": {"why": "legacy (Svelte 4) syntax and semantics: runes mode is forced (`export let`, `<slot>`, `let:`, `on:`, `<svelte:fragment>`, `$$props`/`$$restProps`/`$$slots`, class components)", "ref": "docs/notes/native-compiler/language-subset.md \"Legacy mode\" (no; runes mode is forced); svelte-support.md (`<slot>`: error)", "match": {"reasons": ["^legacy_export_invalid$", "^unsupported_feature: <slot> \\(Svelte 4 slots\\)$", "^unsupported_feature: on: directives"]}},
  "dom-only-element": {"why": "`<svelte:window/document/body/head>` and `<title>` are DOM-only", "ref": "docs/notes/svelte-feature-survey.md §9; svelte-support.md \"Components and special elements\" (DOM-only)", "match": {"reasons": ["^unsupported_feature: this DOM-only element$"]}},
  "html": {"why": "`{@html}` inserts an HTML string, which has no native meaning", "ref": "docs/notes/svelte-feature-survey.md §9 (forbidden)", "match": {"reasons": ["^unsupported_feature: \\{@html\\}$"]}},
  "raw-snippet": {"why": "`createRawSnippet` renders an HTML string through Svelte's DOM operations", "ref": "docs/notes/custom-renderer-trial.md \"Other forbidden features\" (`createRawSnippet`)", "match": {"runtime": ["^Cannot read properties of undefined \\(reading 'call'\\)"]}},
  "dom-css": {"why": "DOM CSS output: the scoping hash class on elements and the `<svelte-css-wrapper>` element for `--css-props`; native styling is translated to GTK CSS / QSS instead", "ref": "docs/notes/native-compiler/styling-syntax.md; svelte-support.md (`<style>`: translated to GTK CSS and QSS)", "match": {"runtime": ["svelte-css-wrapper", "class=\"svelte-[a-z0-9]+\""]}},
  "dom-meta": {"why": "dev `__svelte_meta` (source locations) is attached to DOM nodes; native handles are not DOM nodes", "ref": "docs/site/src/content/docs/guides/svelte-support.md (`bind:this` on elements: the runtime node); svelte-feature-survey.md §4.2", "match": {"runtime": ["^Cannot read properties of undefined \\(reading '(loc|parent)'\\)"]}},
  "dom-node": {"why": "the test calls DOM APIs (`textContent`, `id`, `dataset`, `tagName`, `click()`, `focus()`, `addEventListener`, `style`) on what the component sees as a native handle", "ref": "docs/site/src/content/docs/guides/svelte-support.md (`bind:this` on elements: the runtime node, `call`/`getProp`); svelte-feature-survey.md §4.2", "match": {"runtime": ["\\b(addEventListener|dispatchEvent|focus|click) is not a function", "parameter 1 is not of type 'Node'", "\\(setting 'backgroundColor'\\)"]}}
 },
