{
  "name": "svelters",
  "version": "1.0.0",
  "description": "Template project for writing node package with napi-rs",
  "main": "dist/index.js",
  "source": "src/ts/index.ts",
  "repository": "git@github.com:akiselev/svelte-qt.git",
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/index.js.map"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production node build.js && yarn build:rust",
    "build:codegen": "cross-env NODE_ENV=production node build-codegen.js",
    "build:esbuild:svelte": "cross-env NODE_ENV=production node build-esbuild-svelte.js",
    "build:rust": "cargo build --release",
    "codegen": "node dist/codegen/index.js",
    "docs": "serve target/doc",
    "start": "cargo run",
    "format": "run-p format:md format:json format:yaml format:source format:rs",
    "format:md": "prettier --parser markdown --write './**/*.md'",
    "format:json": "prettier --parser json --write './**/*.json'",
    "format:rs": "cargo fmt",
    "format:source": "prettier --config ./package.json --write './**/*.{js,ts}'",
    "lint": "eslint . -c ./.eslintrc.yml './**/*.{ts,tsx,js}'",
    "watch": "cross-env NODE_ENV=watch node build.js",
    "watch:codegen": "cross-env NODE_ENV=watch node build-codegen.js",
    "watch:rust": "cargo watch -w . -x 'build' -C . -c -d .2",
    "watch:rust:run": "cargo watch -w . -x 'run' -C . -c -d .2",
    "watch:rust:check": "cargo watch -w . -C . -c -d .2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "chalk": "^4.1.2",
    "cmd-ts": "^0.7.0",
    "cosmiconfig": "^7.0.1",
    "cross-env": "^7.0.3",
    "ejs": "^3.1.6",
    "esbuild": "^0.13.9",
    "esbuild-svelte": "^0.5.6",
    "eslint": "^7.27.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-sonarjs": "^0.7.0",
    "inquirer": "^8.2.0",
    "lint-staged": "^11.0.0",
    "lodash": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.0",
    "rewrite-imports": "^3.0.0",
    "serve": "^13.0.2",
    "svelte": "^3.44.0",
    "svelte-preprocess": "^4.9.8",
    "tiny-glob": "^0.2.9",
    "typescript": "^4.3.2",
    "xml2js": "^0.4.23"
  },
  "dependencies": {},
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "trailingComma": "all",
    "singleQuote": false,
    "arrowParens": "always",
    "tabWidth": 4,
    "parser": "typescript"
  },
  "quokka": {
    "recycle": false
  }
}